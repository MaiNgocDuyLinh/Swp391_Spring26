@model Group3_SWP391_PetMedical.Models.User
@{
    ViewData["Title"] = "Chi tiết Khách hàng";

    (string bg, string color, string icon) StatusStyle(string? s) => (s ?? "").Trim() switch {
        "Đặt lịch thành công" => ("#d1fae5", "#047857", "fa-check-circle"),
        "Đã Hủy"              => ("#fee2e2", "#dc2626", "fa-times-circle"),
        "Đã đến"              => ("#e0e7ff", "#4338ca", "fa-map-marker-alt"),
        "Không đến"           => ("#f3f4f6", "#6b7280", "fa-user-slash"),
        "Đang khám"           => ("#fce7f3", "#be185d", "fa-stethoscope"),
        "Đã khám"             => ("#ede9fe", "#6d28d9", "fa-clipboard-check"),
        "Đã thanh toán"       => ("#dcfce7", "#15803d", "fa-money-check-alt"),
        _                     => ("#f3f4f6", "#6b7280", "fa-question-circle")
    };
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:24px; box-shadow:0 12px 30px rgba(0,0,0,0.06); margin-top:150px; }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        
        /* Card & Content */
        .pc-content-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:20px; box-shadow:0 10px 25px rgba(0,0,0,0.04); margin-bottom:20px; }
        .pc-section-title { font-weight:800; font-size:1.1rem; margin-bottom:15px; display:flex; align-items:center; gap:8px; color:var(--pc-text); }
        .pc-section-title i { color:var(--pc-red); }

        /* Profile details */
        .pc-info-item { margin-bottom:12px; }
        .pc-info-label { font-size:0.8rem; font-weight:800; color:var(--pc-muted); text-transform:uppercase; margin-bottom:2px; }
        .pc-info-value { font-weight:600; font-size:0.95rem; color:var(--pc-text); }

        /* Table */
        .pc-table { border-radius:16px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-table thead th { background:#fff7f7; font-weight:800; border-bottom:none; }
        .pc-record { transition:background 0.25s ease; }
        .pc-record:hover { background:#fff3f3 !important; }

        /* Interactive elements */
        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:999px; font-weight:700; font-size:0.75rem; }
        .pc-btn { border-radius:999px; padding:0 18px; height:40px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; transition: all 0.2s; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-btn--ghost:hover { border-color:var(--pc-red); color:var(--pc-red) !important; }
        
        .pc-ico { width:32px; height:32px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.10); background:#fff; color:var(--pc-text); text-decoration:none; }
        .pc-ico:hover { border-color:var(--pc-red); color:var(--pc-red); box-shadow:0 5px 15px rgba(255,59,59,0.1); }

        /* Pet items */
        .pc-pet-item { background:#fffcfc; border:1px solid rgba(255,59,59,0.06); border-radius:12px; padding:12px; display:flex; align-items:center; gap:12px; margin-bottom:10px; }
        .pc-pet-img { width:48px; height:48px; border-radius:50%; object-fit:cover; border:2px solid #fff; box-shadow:0 3px 10px rgba(0,0,0,0.05); }
    </style>
}

<div class="container py-4">
    <div class="pc-wrap">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h3 class="pc-title">Hồ sơ khách hàng</h3>
                <p class="pc-sub">Chi tiết thông tin và lịch sử y tế</p>
            </div>
            <a href="@Url.Action("ListCustomers", "Staff")#servicesArea" class="pc-btn pc-btn--ghost">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>

        <div class="row">
            <!-- Thông tin khách hàng & Pet -->
            <div class="col-lg-4">
                <div class="pc-content-card">
                    <div class="pc-section-title"><i class="fas fa-user-circle"></i> Thông tin cá nhân</div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Họ và tên</div>
                        <div class="pc-info-value">@Model.full_name</div>
                    </div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Số điện thoại</div>
                        <div class="pc-info-value">@(Model.phone ?? "N/A")</div>
                    </div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Email</div>
                        <div class="pc-info-value">@Model.email</div>
                    </div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Ngày tham gia</div>
                        <div class="pc-info-value">@Model.created_at?.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="pc-content-card mt-3">
                    <div class="pc-section-title"><i class="fas fa-paw"></i> Danh sách thú cưng (@(Model.Pets?.Count ?? 0))</div>
                    @if (Model.Pets != null && Model.Pets.Any())
                    {
                        foreach (var pet in Model.Pets)
                        {
                            <div class="pc-pet-item">
                                <img src="@(string.IsNullOrEmpty(pet.PetImg) ? "https://ui-avatars.com/api/?name="+pet.name+"&background=f3d7d5&color=ff3b3b" : pet.PetImg)" class="pc-pet-img" alt="@pet.name" />
                                <div>
                                    <div style="font-weight:800; font-size:0.9rem;">@pet.name</div>
                                    <div style="font-size:0.8rem; color:var(--pc-muted);">@pet.species @(!string.IsNullOrEmpty(pet.breed) ? " • " + pet.breed : "")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">Chưa có thú cưng nào.</p>
                    }
                </div>
            </div>

            <!-- Lịch sử khám -->
            <div class="col-lg-8">
                <div class="pc-table table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th colspan="6" style="padding: 15px 20px;">
                                    <div class="pc-section-title m-0"><i class="fas fa-history"></i> Lịch sử khám bệnh</div>
                                </th>
                            </tr>
                            <tr>
                                <th style="padding-left: 20px;">Ngày giờ</th>
                                <th>Thú cưng</th>
                                <th>Bác sĩ</th>
                                <th>Dịch vụ</th>
                                <th>Trạng thái</th>
                                <th style="width:60px;" class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        @{
                            var allAppointments = Model.Pets?.SelectMany(p => p.Appointments).OrderByDescending(a => a.appointment_date).ToList() ?? new List<Group3_SWP391_PetMedical.Models.Appointment>();
                        }
                        @if (allAppointments.Any())
                        {
                            @foreach (var appt in allAppointments)
                            {
                                var s = StatusStyle(appt.status);
                                <tbody class="pc-record">
                                    <tr style="border-bottom: 1px solid var(--pc-border);">
                                        <td style="padding-left: 20px;">
                                            <div style="font-weight:700;">@appt.appointment_date.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@appt.appointment_date.ToString("HH:mm")</small>
                                        </td>
                                        <td><strong>@appt.pet?.name</strong></td>
                                        <td>@(appt.doctor?.full_name ?? "N/A")</td>
                                        <td>
                                            @if (appt.AppointmentDetails != null && appt.AppointmentDetails.Any())
                                            {
                                                var svcs = appt.AppointmentDetails.Select(ad => ad.service?.service_name).Where(n => n != null).ToList();
                                                <small>@string.Join(", ", svcs)</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="pc-badge" style="background:@s.bg; color:@s.color;">
                                                <i class="fas @s.icon"></i> @(appt.status ?? "-")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="@Url.Action("AppointmentDetail", "Staff", new { id = appt.appointment_id })" class="pc-ico">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            }
                        }
                        else
                        {
                            <tbody>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">Không có lịch sử khám bệnh.</td>
                                </tr>
                            </tbody>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

