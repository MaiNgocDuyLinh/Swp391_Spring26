@model Group3_SWP391_PetMedical.Models.Invoice
@using Group3_SWP391_PetMedical.Services.Interfaces
@inject IServiceService ServiceService
@{
    ViewData["Title"] = "Hóa đơn";

    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();
    var _appointmentDate = Model.appointment?.created_at ?? Model.appointment?.appointment_date ?? DateTime.Now;
    Func<int, decimal> getDiscountedPrice = (serviceId) =>
    {
        var svc = _allSvcs.FirstOrDefault(x => x.service_id == serviceId);
        if (svc == null) return 0;
        var disc = svc.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= _appointmentDate && sd.end_date >= _appointmentDate && (sd.created_at ?? DateTime.MinValue) <= _appointmentDate);
        if (disc != null) return svc.base_price * (1 - (decimal)disc.discount_percent / 100);
        return svc.base_price;
    };
    Func<int, Group3_SWP391_PetMedical.Models.ServiceDiscount?> getActiveDiscount = (serviceId) =>
    {
        var svc = _allSvcs.FirstOrDefault(x => x.service_id == serviceId);
        return svc?.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= _appointmentDate && sd.end_date >= _appointmentDate && (sd.created_at ?? DateTime.MinValue) <= _appointmentDate);
    };
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }

        .pc-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-card-head { padding:14px 18px; background:#fff7f7; border-bottom:1px solid var(--pc-border); border-radius:16px 16px 0 0; font-weight:800; font-size:0.95rem; color:var(--pc-text); text-align:center; }
        .pc-card-head i { margin-right:8px; color:var(--pc-red); }
        .pc-card-body { padding:24px; }

        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; font-weight:800; font-size:0.85rem; border:1px solid rgba(0,0,0,0.06); background:#fff; }
        .pc-badge i { color:var(--pc-red); }
        .pc-money { font-weight:900; }
        .pc-label { font-weight:700; font-size:0.9rem; margin-bottom:6px; color:var(--pc-muted); }

        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; cursor:pointer; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:rgba(255,59,59,0.1); border:none; color:var(--pc-red) !important; }
        .pc-btn--ghost:hover { background:rgba(255,59,59,0.2); color:var(--pc-red-dark) !important; }
        .pc-btn--outline { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-btn--outline:hover { background:rgba(0,0,0,0.03); }
        .pc-btn--black { background:#111; color:#fff; }
        .pc-btn--black:hover { background:#333; color:#fff; }
        @@media print { 
            @@page { margin: 15mm; }
            body { background: #fff; margin: 0; padding: 0; }
            header, footer { display: none !important; }
            .no-print { display:none !important; } 
            .pc-wrap { box-shadow:none; border:none; background:#fff; margin-top:0 !important; padding:0 !important; } 
            .pc-card { box-shadow:none; border:none; padding:0; }
            .pc-card-body { padding:0; }
            .mb-4 { margin-bottom: 12px !important; }
            .mt-4 { margin-top: 12px !important; }
            .py-4 { padding-top: 0 !important; padding-bottom: 0 !important; }
        }
    </style>
}

<section class="container py-4">
    <div class="pc-wrap" style="margin-top:150px;">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
            <div>
                <h3 class="pc-title">Hóa đơn</h3>
                <p class="pc-sub">Chi tiết hóa đơn thanh toán</p>
            </div>
            <div class="d-flex gap-2">
                <a class="pc-btn pc-btn--outline" href="@Url.Action("AppointmentDetail", "Staff", new { id = Model.appointment_id })">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
                <button class="pc-btn pc-btn--black no-print" onclick="window.print()">
                    <i class="fas fa-print"></i> In
                </button>
            </div>
        </div>

        <div class="pc-card">
            <div class="pc-card-head">
                <div style="font-size:1.15rem;">🐾 PetCare — Phòng khám Thú y</div>
                <div style="font-weight:600; font-size:0.9rem; color:var(--pc-muted); margin-top:4px;">Hóa đơn #@Model.invoice_id</div>
            </div>
            <div class="pc-card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="pc-label">Khách hàng</div>
                        <div><strong>@(Model.appointment?.customer?.full_name ?? "N/A")</strong></div>
                        <div class="text-muted">@(Model.appointment?.customer?.phone ?? "")</div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="pc-label">Ngày tạo</div>
                        <div><strong>@Model.created_at?.ToString("dd/MM/yyyy HH:mm")</strong></div>
                        <div class="mt-2">
                            <span class="pc-badge" style="background:@(Model.payment_status == "Paid" ? "#dcfce7" : "#fef3c7"); color:@(Model.payment_status == "Paid" ? "#15803d" : "#b45309");">
                                <i class="fas @(Model.payment_status == "Paid" ? "fa-check-circle" : "fa-clock")"></i>
                                @(Model.payment_status == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                            </span>
                        </div>
                    </div>
                </div>

                @if (Model.appointment?.AppointmentDetails != null && Model.appointment.AppointmentDetails.Any())
                {
                    <div class="table-responsive mb-4" style="border:1px solid var(--pc-border); border-radius:12px; overflow:hidden;">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="padding:10px 16px; background:#fff7f7; font-weight:800;">#</th>
                                    <th style="padding:10px 16px; background:#fff7f7; font-weight:800;">Dịch vụ</th>
                                    <th class="text-end" style="padding:10px 16px; background:#fff7f7; font-weight:800;">Đơn giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int i = 1;}
                                @foreach (var d in Model.appointment.AppointmentDetails)
                                {
                                    var svcId = d.service_id;
                                    var actualP = d.actual_price;
                                    var discInfo = getActiveDiscount(svcId);
                                    var effectivePrice = actualP ?? getDiscountedPrice(svcId);
                                    var origPrice = d.service?.base_price ?? 0;

                                    <tr>
                                        <td style="padding:10px 16px;">@i</td>
                                        <td style="padding:10px 16px;">
                                            @(d.service?.service_name ?? "N/A")
                                            @if (discInfo != null && actualP == null)
                                            {
                                                <span style="background:#dc2626; color:#fff; padding:1px 6px; border-radius:999px; font-size:0.7rem; font-weight:800; margin-left:4px;">-@discInfo.discount_percent%</span>
                                            }
                                        </td>
                                        <td class="text-end pc-money" style="padding:10px 16px;">
                                            @if (discInfo != null && actualP == null)
                                            {
                                                <small style="text-decoration:line-through; color:rgba(0,0,0,.40); margin-right:4px;">@origPrice.ToString("N0")</small>
                                                <span style="color:#dc2626;">@effectivePrice.ToString("N0") đ</span>
                                            }
                                            else
                                            {
                                                @effectivePrice.ToString("N0") <text>đ</text>
                                            }
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (Model.appointment?.MedicalRecord != null)
                {
                    <h6 class="pc-label mt-4"><i class="fas fa-notes-medical" style="color:var(--pc-red);"></i> Kết quả khám bệnh</h6>
                    <div class="mb-3" style="font-size:0.95rem;">
                        <div class="mb-1"><span class="text-muted" style="width:100px; display:inline-block;">Chẩn đoán:</span> <strong>@(Model.appointment.MedicalRecord.diagnosis ?? "N/A")</strong></div>
                        <div class="mb-1"><span class="text-muted" style="width:100px; display:inline-block;">Tình trạng:</span> <strong>@(Model.appointment.MedicalRecord.health_status ?? "N/A")</strong></div>
                    </div>

                    @if (Model.appointment.MedicalRecord.Prescriptions != null && Model.appointment.MedicalRecord.Prescriptions.Any())
                    {
                        <div class="table-responsive mb-4 mt-2" style="border:1px solid var(--pc-border); border-radius:12px; overflow:hidden;">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="padding:10px 16px; background:#fff7f7; font-weight:800;">Toa thuốc</th>
                                        <th style="padding:10px 16px; background:#fff7f7; font-weight:800;">Liều dùng</th>
                                        <th class="text-center" style="padding:10px 16px; background:#fff7f7; font-weight:800;">SL</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.appointment.MedicalRecord.Prescriptions)
                                    {
                                        <tr>
                                            <td style="padding:10px 16px;"><strong>@(p.medicine?.name ?? "N/A")</strong></td>
                                            <td style="padding:10px 16px; font-size:0.9rem;">@p.dosage</td>
                                            <td class="text-center" style="padding:10px 16px;">@p.quantity</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px dashed var(--pc-border);">
                    <div style="font-size:1.2rem;">
                        <span class="text-muted">Tổng cộng: </span>
                        <strong class="pc-money ms-2" style="color:var(--pc-red);">@Model.total_amount.ToString("N0") đ</strong>
                    </div>
                    <div>
                        @if (Model.payment_status != "Paid" && Model.appointment?.status == "Đã khám")
                        {
                            <form asp-action="UpdateStatus" asp-controller="Staff" method="post" class="m-0 p-0 no-print">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.appointment_id" />
                                <input type="hidden" name="newStatus" value="Đã thanh toán" />
                                <button type="submit" class="pc-btn pc-btn--primary" onclick="return confirm('Xác nhận thanh toán cho hóa đơn này?')">
                                    <i class="fas fa-money-check-alt"></i> Xác nhận thanh toán
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
