@model Group3_SWP391_PetMedical.Models.Invoice
@{
    ViewData["Title"] = "Hóa đơn";
    var appt = Model.appointment;
}

<div class="slider-area2 slider-height2 d-flex align-items-center">
    <div class="container">
        <div class="hero-cap text-center pt-50">
            <h2>Hóa đơn #@Model.invoice_id</h2>
        </div>
    </div>
</div>

<div class="container" style="padding: 40px 0;">
    <a href="@Url.Action("AppointmentDetail", "Staff", new { id = Model.appointment_id })" class="btn btn-secondary mb-3">
        <i class="fas fa-arrow-left"></i> Quay lại lịch hẹn
    </a>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4 class="mb-0"><i class="fas fa-file-invoice-dollar"></i> HÓA ĐƠN THANH TOÁN</h4>
                    <small>Phòng khám thú y PetMedical</small>
                </div>
                <div class="card-body">
                    <!-- Thông tin khách hàng -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>Khách hàng:</strong> @(appt?.customer?.full_name ?? "N/A")</p>
                            <p><strong>Điện thoại:</strong> @(appt?.customer?.phone ?? "N/A")</p>
                        </div>
                        <div class="col-md-6 text-right">
                            <p><strong>Mã lịch hẹn:</strong> #@Model.appointment_id</p>
                            <p><strong>Ngày tạo:</strong> @(Model.created_at?.ToString("dd/MM/yyyy HH:mm") ?? "-")</p>
                            <p><strong>Thú cưng:</strong> @(appt?.pet?.name ?? "N/A")</p>
                        </div>
                    </div>
                    <hr />

                    <!-- Dịch vụ -->
                    <table class="table table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>#</th>
                                <th>Dịch vụ</th>
                                <th class="text-right">Đơn giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (appt?.AppointmentDetails != null)
                            {
                                int i = 1;
                                @foreach (var d in appt.AppointmentDetails)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@(d.service?.service_name ?? "N/A")</td>
                                        <td class="text-right">@((d.actual_price ?? d.service?.base_price ?? 0).ToString("N0")) đ</td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-success font-weight-bold">
                                <td colspan="2" class="text-right">TỔNG CỘNG:</td>
                                <td class="text-right text-success">@Model.total_amount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                    <hr />

                    <!-- Thanh toán -->
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Phương thức:</strong> @(Model.payment_method ?? "Cash")</p>
                        </div>
                        <div class="col-md-6 text-right">
                            <p><strong>Trạng thái:</strong>
                                <span class="badge @(Model.payment_status == "Paid" ? "badge-success" : "badge-warning")">
                                    @(Model.payment_status == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-center text-muted">
                    <small>Cảm ơn quý khách đã sử dụng dịch vụ PetMedical!</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card { border-radius: 10px; }
    .badge { padding: 6px 12px; font-size: 0.9em; }
</style>
