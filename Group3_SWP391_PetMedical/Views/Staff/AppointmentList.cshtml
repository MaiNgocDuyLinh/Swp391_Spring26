@model List<Group3_SWP391_PetMedical.Models.Appointment>
@{
    ViewData["Title"] = "Lịch khám theo ngày";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
    string? search = ViewBag.Search;

    string StatusBadge(string? s) => s switch {
        "Pending"   => "st-warning",
        "Deposited" => "st-info",
        "Confirmed" => "st-primary",
        "Arrived"   => "st-secondary",
        "Completed" => "st-success",
        "Cancelled" => "st-danger",
        "NoShow"    => "st-dark",
        _           => "st-light"
    };
    string StatusText(string? s) => s switch {
        "Pending"   => "Chờ xác nhận",
        "Deposited" => "Đã đặt cọc",
        "Confirmed" => "Đã xác nhận",
        "Arrived"   => "Đã đến",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        "NoShow"    => "Không đến",
        _           => s ?? "-"
    };
}

<!-- Hero Area -->
<div class="slider-area2 slider-height2 d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="hero-cap text-center pt-50">
                    <h2>Lịch khám theo ngày</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="our-services section-padding30">
    <div class="container">
        <!-- Search & Filter Bar -->
        <div class="pc-searchbar d-flex align-items-center flex-wrap gap-2 mb-4">
            <form method="get" asp-action="AppointmentList" asp-controller="Staff"
                  class="d-flex align-items-center flex-wrap gap-2" style="width:100%;">
                
                <div class="d-flex align-items-center gap-2 mr-3">
                    <label class="mb-0 font-weight-bold"><i class="fas fa-calendar-alt"></i> Ngày:</label>
                    <input type="date" class="form-control" name="date" 
                           value="@selectedDate.ToString("yyyy-MM-dd")" style="max-width:180px;" />
                </div>

                <input type="text" class="form-control" name="search" value="@search"
                       placeholder="Tìm khách hàng, thú cưng, bác sĩ..." style="max-width:300px;" />
                
                <button type="submit" class="pc-btn pc-btn--icon" title="Tìm kiếm">
                    <i class="fas fa-search"></i>
                </button>

                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="@Url.Action("AppointmentList", "Staff", new { date = selectedDate.ToString("yyyy-MM-dd") })" class="pc-btn pc-btn--reset">
                        <i class="fas fa-times"></i> Xóa lọc
                    </a>
                }
            </form>
        </div>

        <!-- Table Card -->
        <div class="card shadow-sm" style="border-radius:16px; overflow:hidden; border:none;">
            <div class="card-header" style="background:#7EB6FF; color:#fff; padding:18px 24px;">
                <h5 class="mb-0" style="font-weight:700;">
                    <i class="fas fa-calendar-check mr-2"></i>Lịch khám ngày @selectedDate.ToString("dd/MM/yyyy")
                    @if (selectedDate.Date == DateTime.Today)
                    {
                        <span class="badge badge-light ml-2" style="font-size:0.7em;">Hôm nay</span>
                    }
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.95rem;">
                        <thead style="background:#f7f9fc;">
                            <tr>
                                <th style="padding:14px 18px;">#</th>
                                <th style="padding:14px 18px;">Giờ khám</th>
                                <th style="padding:14px 18px;">Khách hàng</th>
                                <th style="padding:14px 18px;">Thú cưng</th>
                                <th style="padding:14px 18px;">Bác sĩ</th>
                                <th style="padding:14px 18px;">Trạng thái</th>
                                <th style="padding:14px 18px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int index = (currentPage - 1) * 5 + 1;
                                @foreach (var a in Model)
                                {
                                    <tr style="border-bottom:1px solid #f0f0f0;">
                                        <td style="padding:14px 18px; color:#888;">@index</td>
                                        <td style="padding:14px 18px;"><strong>@a.appointment_date.ToString("HH:mm")</strong></td>
                                        <td style="padding:14px 18px;">@(a.customer?.full_name ?? "N/A")</td>
                                        <td style="padding:14px 18px;">
                                            @(a.pet?.name ?? "N/A")
                                            @if (a.pet?.species != null)
                                            { <br /><small class="text-muted">@a.pet.species</small> }
                                        </td>
                                        <td style="padding:14px 18px;">
                                            @if (a.doctor != null)
                                            { <span>@a.doctor.full_name</span> }
                                            else
                                            { <span class="text-muted"><i class="fas fa-user-slash"></i> Chưa có</span> }
                                        </td>
                                        <td style="padding:14px 18px;">
                                            <span class="pc-status @StatusBadge(a.status)">@StatusText(a.status)</span>
                                        </td>
                                        <td style="padding:14px 18px;">
                                            <a href="@Url.Action("AppointmentDetail", "Staff", new { id = a.appointment_id })"
                                               class="pc-action-btn">
                                                <i class="fas fa-eye"></i> Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>
                                        Không tìm thấy lịch khám nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <div class="card-footer" style="background:#fff; border-top:1px solid #f0f0f0; padding:16px;">
                <ul class="pagination pc-pager justify-content-center mb-1">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("AppointmentList", "Staff", new { date = selectedDate.ToString("yyyy-MM-dd"), search, page = currentPage - 1 })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Math.Max(totalPages, 1); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("AppointmentList", "Staff", new { date = selectedDate.ToString("yyyy-MM-dd"), search, page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("AppointmentList", "Staff", new { date = selectedDate.ToString("yyyy-MM-dd"), search, page = currentPage + 1 })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
                <div class="text-center text-muted" style="font-size:0.85rem;">
                    Trang @currentPage / @(Math.Max(totalPages, 1)) &nbsp;|&nbsp; Tổng @totalItems lịch hẹn
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root { --btn-bg: #7EB6FF; --btn-text: #fff; }
    .pc-searchbar .form-control { height:52px; border-radius:999px !important; padding:0 18px; border:1px solid rgba(0,0,0,.10); }
    .pc-btn { height:52px; padding:0 22px; background:var(--btn-bg) !important; color:var(--btn-text) !important; border:none !important; border-radius:8px !important; font-weight:700; display:inline-flex; align-items:center; gap:6px; cursor:pointer; transition:opacity .15s; text-decoration:none; }
    .pc-btn:hover { opacity:.88; color:var(--btn-text) !important; background:var(--btn-bg) !important; text-decoration:none; }
    .pc-btn--icon { width:52px; padding:0 !important; justify-content:center; }
    .pc-btn--reset { background:#f0f0f0 !important; color:#333 !important; }
    .pc-btn--reset:hover { background:#f0f0f0 !important; color:#333 !important; }
    .pc-status { display:inline-block; padding:4px 12px; border-radius:999px; font-size:0.8rem; font-weight:700; }
    .st-warning { background:#fff3cd; color:#856404; }
    .st-info    { background:#cff4fc; color:#055160; }
    .st-primary { background:#cfe2ff; color:#084298; }
    .st-secondary{ background:#e2e3e5; color:#41464b; }
    .st-success { background:#d1e7dd; color:#0a3622; }
    .st-danger  { background:#f8d7da; color:#842029; }
    .st-dark    { background:#d3d3d4; color:#141619; }
    .pc-action-btn { display:inline-flex; align-items:center; gap:5px; padding:6px 16px; background:var(--btn-bg); color:#fff; border-radius:8px; font-size:0.85rem; font-weight:700; text-decoration:none; transition:opacity .15s; }
    .pc-action-btn:hover { opacity:.88; color:#fff; background:var(--btn-bg); text-decoration:none; }
    .pc-pager .page-link { border-radius:999px !important; margin:0 4px; min-width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,.10) !important; color:#333 !important; font-weight:700; }
    .pc-pager .page-item.active .page-link { background:var(--btn-bg) !important; border-color:var(--btn-bg) !important; color:#fff !important; }
    .pc-pager .page-item.disabled .page-link { opacity:.45; }
    .table td, .table th { vertical-align:middle; }
    .gap-2 { gap:8px; }
</style>
