@model Group3_SWP391_PetMedical.Models.RetailOrder
@{
    ViewData["Title"] = "Chi tiết Đơn thuốc #" + Model.id;

    (string bg, string color, string icon, string text) StatusStyle(string? s) => (s ?? "").Trim().ToUpper() switch {
        "PAID" => ("#d1fae5", "#047857", "fa-check-circle", "Đã thanh toán"),
        "UNPAID" => ("#fee2e2", "#dc2626", "fa-times-circle", "Chưa thanh toán"),
        "PENDING" => ("#fef3c7", "#d97706", "fa-clock", "Chờ xử lý"),
        "CANCELLED" => ("#f3f4f6", "#6b7280", "fa-ban", "Đã hủy"),
        _ => ("#f3f4f6", "#6b7280", "fa-question-circle", s ?? "Không rõ")
    };

    (string bg, string color, string icon) OrderStatusStyle(string? s) => (s ?? "").Trim() switch {
        "Đã tiếp nhận" => ("#e0f2fe", "#0369a1", "fa-bell"),
        "Đã soạn hàng" => ("#f3e8ff", "#7e22ce", "fa-box-open"),
        "Đã giao thuốc" => ("#d1fae5", "#047857", "fa-shipping-fast"),
        "Hủy/Hoàn trả" => ("#fee2e2", "#dc2626", "fa-undo"),
        "Không nhận" => ("#fef3c7", "#d97706", "fa-exclamation-triangle"),
        _ => ("#f3f4f6", "#6b7280", "fa-spinner")
    };

    var statusInfo = StatusStyle(Model.status);
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:24px; margin-top:20px; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-label { font-weight:700; font-size:0.9rem; color:var(--pc-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px; }
        .pc-value { font-weight:800; font-size:1.1rem; color:var(--pc-text); margin-bottom:16px; }
        .pc-btn { border-radius:999px; padding:0 24px; height:46px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; transition:all 0.2s; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.15); color:var(--pc-text); }
        .pc-btn--ghost:hover { border-color:var(--pc-text); background:#f9f9f9; color:var(--pc-text); }
        .pc-btn--primary { background:var(--pc-red); color:#fff; border:none; }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; box-shadow:0 6px 15px rgba(255,59,59,0.25); }
        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:999px; font-weight:700; font-size:0.9rem; }
        .pc-table { border-radius:12px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); width: 100%; margin-top: 20px;}
        .pc-table thead th { background:#fff7f7; font-weight:800; padding: 14px 16px; border-bottom: 2px solid #fcebeb; }
        .pc-table tbody td { padding: 14px 16px; vertical-align: middle; border-bottom: 1px solid #f8f8f8; }
        .pc-table tbody tr:last-child td { border-bottom: none; }
        .pc-total-row { background: #fffcfc; font-weight: 800; font-size: 1.2rem; }
    </style>
}

<section class="container py-4">
    <div class="pc-wrap" style="margin-top:150px;">
        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-3">
            <div>
                <h3 class="pc-title">Chi tiết đơn thuốc #@Model.id</h3>
                <p class="pc-sub">Thông tin chi tiết về đơn hàng của khách hàng</p>
            </div>
            <a href="@Url.Action("StaffViewRetailList", "Retail")" class="pc-btn pc-btn--ghost">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius:14px; margin-bottom: 20px;">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="pc-card">
            <div class="row">
                <div class="col-md-6 col-lg-3">
                    <div class="pc-label">Khách hàng</div>
                    <div class="pc-value">@(Model.user?.full_name ?? "Khách lẻ (Không có tài khoản)")</div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="pc-label">Thời gian đặt</div>
                    <div class="pc-value">@(Model.created_at?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="pc-label">Trạng thái TT</div>
                    <div class="mb-3">
                        <span class="pc-badge" style="background:@statusInfo.bg; color:@statusInfo.color;">
                            <i class="fas @statusInfo.icon"></i> @statusInfo.text
                        </span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="pc-label">Trạng thái đơn hàng</div>
                    <div class="pc-value">
                        @if (!string.IsNullOrEmpty(Model.status_order))
                        {
                            var os = OrderStatusStyle(Model.status_order);
                            <span class="pc-badge" style="background:@os.bg; color:@os.color;">
                                <i class="fas @os.icon"></i> @Model.status_order
                            </span>
                        }
                        else
                        {
                            <span class="text-muted" style="font-weight: 500;">Chưa cập nhật</span>
                        }
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="pc-label">Ghi chú</div>
                    <div class="pc-value" style="font-weight: 500; font-size: 1rem;">
                        @(string.IsNullOrEmpty(Model.note) ? "Không có ghi chú" : Model.note)
                    </div>
                </div>
            </div>

            <div class="mt-4 p-4" style="background: #fffafa; border-radius: 20px; border: 2px solid #fcebeb; box-shadow: 0 8px 20px rgba(255, 59, 59, 0.03);">
                <h6 style="font-weight: 800; margin-bottom: 20px; color: var(--pc-red-dark);"><i class="fas fa-edit me-2"></i> Cập nhật trạng thái đơn hàng</h6>
                <form asp-action="StaffUpdateStatusOrder" method="post" class="row align-items-end g-3">
                    <input type="hidden" name="id" value="@Model.id" />
                    <div class="col-md-7">
                        <div class="pc-label" style="text-transform: none; color: var(--pc-text); margin-bottom: 8px;">Trạng thái mới</div>
                        <select name="status_order" class="form-select pc-input" style="height: 48px; border-color: #fcebeb; font-weight: 600;">
                            <option value="Đã tiếp nhận" selected="@(Model.status_order == "Đã tiếp nhận")">🔵 Đã tiếp nhận</option>
                            <option value="Đã soạn hàng" selected="@(Model.status_order == "Đã soạn hàng")">📦 Đã soạn hàng</option>
                            <option value="Đã giao thuốc" selected="@(Model.status_order == "Đã giao thuốc")">✅ Đã giao thuốc</option>
                            <option value="Hủy/Hoàn trả" selected="@(Model.status_order == "Hủy/Hoàn trả")">❌ Hủy/Hoàn trả</option>
                            <option value="Không nhận" selected="@(Model.status_order == "Không nhận")">⚠️ Không nhận</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <button type="submit" class="pc-btn pc-btn--primary w-100" style="height: 48px; border-radius: 12px;">
                            <i class="fas fa-save me-2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>

            <hr style="border-color: var(--pc-border); margin: 24px 0;" />
            <h5 style="font-weight: 800; margin-bottom: 0;">Danh sách thuốc</h5>

            <div class="table-responsive">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">STT</th>
                            <th>Tên thuốc</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            int idx = 1;
                            foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@idx</td>
                                    <td>
                                        <div style="font-weight: 700;">@(detail.medicine?.name ?? "Thuốc không rõ")</div>
                                        <div style="font-size: 0.85rem; color: var(--pc-muted);">Mã: @detail.medicine_id</div>
                                    </td>
                                    <td class="text-end">
                                        @{
                                            var price = detail.price_at_purchase ?? detail.medicine?.unit_price ?? 0;
                                        }
                                        @(price.ToString("N0")) đ
                                    </td>
                                    <td class="text-center" style="font-weight: 700;">@detail.quantity</td>
                                    <td class="text-end">@((price * detail.quantity).ToString("N0")) đ</td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Không có chi tiết sản phẩm cho đơn hàng này.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="pc-total-row">
                            <td colspan="4" class="text-end px-3">Tổng cộng:</td>
                            <td class="text-end text-danger px-3">@Model.total_amount.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>
    </div>
</section>
