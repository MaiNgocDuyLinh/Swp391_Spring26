@model Group3_SWP391_PetMedical.ViewModels.Retail.CartVm
@{
    ViewData["Title"] = "Giỏ hàng";
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:18px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--primary:disabled { opacity: 0.6; cursor: not-allowed; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-btn--danger { background: #dc3545; color: #fff; }
        
        .pc-table { border-radius:16px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-table thead th { background:#fff7f7; font-weight:800; }
        .pc-table td { vertical-align: middle; }
        
        .pc-ico { width:36px; height:36px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.10); background:#fff; color:var(--pc-text); box-shadow:0 8px 18px rgba(0,0,0,0.04); text-decoration:none; cursor:pointer; }
        .pc-ico:hover { border-color:rgba(255,59,59,0.35); box-shadow:0 10px 22px rgba(255,59,59,0.12); color:var(--pc-red-dark); }
        
        tbody.pc-record { transition:background 0.25s ease; }
        tbody.pc-record:hover tr { background:#fff3f3 !important; }
        
        .cart-qty { display: inline-flex; align-items: center; gap: 8px; }
        .cart-qty-btn { 
            width: 36px; 
            height: 36px; 
            border-radius: 10px; 
            border: 2px solid #000; 
            background: #fff; 
            color: #000; 
            font-weight: 900; 
            font-size: 1.2rem;
            display: inline-flex; 
            align-items: center; 
            justify-content: center; 
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .cart-qty-btn:hover { 
            background: #000; 
            color: #fff; 
        }
        .cart-qty-btn:disabled { 
            opacity: 0.3; 
            pointer-events: none; 
            border-color: #ccc;
            color: #ccc;
        }
        .cart-qty-value { min-width: 42px; text-align: center; font-weight: 800; }
        
        .cart-sidebar { position: sticky; top: 110px; }
    </style>
}

<section class="container py-4" id="cartArea">
    <div class="pc-wrap" style="margin-top:150px;">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h3 class="pc-title">Giỏ hàng của bạn</h3>
                <p class="pc-sub">Xem và chỉnh sửa các thuốc bạn đã chọn trước khi đặt hàng.</p>
            </div>
            <a href="@Url.Action("RetailOrderedViewList", "Retail")" class="pc-btn pc-btn--ghost text-dark">
                <i class="fas fa-receipt text-danger"></i> Đơn thuốc của bạn
            </a>
        </div>

        <form id="__af" method="post" class="d-none">
            @Html.AntiForgeryToken()
        </form>

        @if (Model?.items == null || !Model.items.Any())
        {
            <div class="alert alert-info mt-3" style="border-radius:14px;">
                <i class="fas fa-shopping-basket me-2"></i> Giỏ hàng trống. Hãy chọn thuốc bạn cần cho thú cưng.<br/>
                <a class="pc-btn pc-btn--primary mt-3" href="@Url.Action("RetailViewList", "Retail")">
                    <i class="fas fa-capsules"></i> Back to Shop
                </a>
            </div>
        }
        else
        {
            <div class="row g-4 mt-3">
                <div class="col-lg-8">
                    <div class="pc-filter" style="margin-top:0;">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkAll" checked>
                                <label class="form-check-label" for="chkAll">Chọn tất cả</label>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="btnClearSelected">
                                <i class="fas fa-broom"></i> Clear Selected
                            </button>
                        </div>

                        <div class="pc-table table-responsive">
                            <table class="table align-middle m-0">
                                <thead>
                                    <tr>
                                        <th style="width:44px;"></th>
                                        <th>Tên thuốc</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                        <th class="text-end" style="width:50px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="cartTbody" class="pc-record">
                                    @foreach (var item in Model.items)
                                    {
                                        <tr id="row-@item.medicine_id"
                                            data-medicine-id="@item.medicine_id"
                                            data-unit-price="@item.unit_price"
                                            data-line-total="@item.line_total"
                                            data-stock="@item.stock_quantity">
                                            <td>
                                                <input class="form-check-input chkItem" type="checkbox" checked>
                                            </td>
                                            <td>
                                                <div class="fw-bold">@item.medicine_name</div>
                                                <div class="text-muted small">Mã: @item.medicine_id</div>
                                            </td>
                                            <td class="text-end">@item.unit_price.ToString("N0") đ</td>
                                            <td class="text-center">
                                                <div class="cart-qty justify-content-center">
                                                    <button type="button" class="cart-qty-btn btnMinus" aria-label="minus">-</button>
                                                    <div class="cart-qty-value qtyVal">@item.quantity</div>
                                                    <button type="button" class="cart-qty-btn btnPlus" aria-label="plus">+</button>
                                                </div>
                                                <div class="text-muted small mt-1">Tồn: @item.stock_quantity</div>
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-bold text-danger lineTotal">@item.line_total.ToString("N0") đ</span>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-link text-danger p-0 btnDelete d-inline-flex pc-ico" title="Xóa" style="border:none;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-start mt-3">
                            <a class="pc-btn pc-btn--ghost" href="@Url.Action("RetailViewList", "Retail")">
                                <i class="fas fa-arrow-left"></i> Tiếp tục mua thuốc
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart-sidebar">
                        <div class="pc-filter" style="margin-top:0;">
                            <h5 style="font-weight:800; margin-bottom:6px;">Tóm tắt</h5>
                            <div style="color:var(--pc-muted); font-size:0.95rem;">Chỉ tính các thuốc đang được chọn.</div>

                            <div class="d-flex justify-content-between align-items-baseline mt-3" style="font-weight:800;">
                                <span>Tạm tính</span>
                                <span class="amount" id="selectedTotal" style="color:var(--pc-red); font-size:1.35rem;">0 đ</span>
                            </div>
                            <div class="d-flex justify-content-between mt-2 text-muted">
                                <span>Đã chọn</span>
                                <span id="selectedCount">0</span>
                            </div>

                            <button type="button" class="pc-btn pc-btn--primary w-100 mt-3" id="btnCheckout" disabled>
                                <i class="fas fa-credit-card"></i> Checkout Selected
                            </button>

                            <div class="text-muted small mt-2">
                                (Payment/Checkout sẽ nối sau; hiện chỉ demo UI + tổng tiền chọn.)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const af = document.querySelector('#__af input[name="__RequestVerificationToken"]');
            const token = af ? af.value : '';

            const tbody = document.getElementById('cartTbody');
            const chkAll = document.getElementById('chkAll');
            const selectedTotalEl = document.getElementById('selectedTotal');
            const selectedCountEl = document.getElementById('selectedCount');
            const btnCheckout = document.getElementById('btnCheckout');
            const btnClearSelected = document.getElementById('btnClearSelected');

            function formatVnd(n) {
                try { return new Intl.NumberFormat('vi-VN').format(n) + ' đ'; }
                catch { return n.toFixed(0) + ' đ'; }
            }

            function getRows() {
                if (!tbody) return [];
                return Array.from(tbody.querySelectorAll('tr[data-medicine-id]'));
            }

            function recalcSelected() {
                const rows = getRows();
                let total = 0;
                let count = 0;
                for (const r of rows) {
                    const chk = r.querySelector('.chkItem');
                    if (chk && chk.checked) {
                        count++;
                        total += Number(r.dataset.lineTotal || 0);
                    }
                }
                if (selectedTotalEl) selectedTotalEl.textContent = formatVnd(total);
                if (selectedCountEl) selectedCountEl.textContent = String(count);
                if (btnCheckout) btnCheckout.disabled = count === 0;

                if (chkAll) {
                    const all = rows.length > 0 && rows.every(r => r.querySelector('.chkItem')?.checked);
                    const any = rows.some(r => r.querySelector('.chkItem')?.checked);
                    chkAll.indeterminate = any && !all;
                    chkAll.checked = all;
                }
            }

            async function postForm(url, formObj) {
                const fd = new FormData();
                for (const k of Object.keys(formObj)) {
                    const v = formObj[k];
                    if (Array.isArray(v)) {
                        for (const item of v) fd.append(k, item);
                    } else {
                        fd.append(k, v);
                    }
                }
                fd.append('__RequestVerificationToken', token);

                const res = await fetch(url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Request failed');
                return await res.json();
            }

            function setRowLoading(row, isLoading) {
                const buttons = row.querySelectorAll('button');
                buttons.forEach(b => b.disabled = isLoading || b.classList.contains('btnDelete') && b.disabled);
                row.style.opacity = isLoading ? '0.65' : '';
            }

            async function updateQuantity(row, newQty) {
                const medicineId = row.dataset.medicineId;
                const stock = Number(row.dataset.stock || 0);
                if (newQty < 1) newQty = 1;
                if (stock > 0 && newQty > stock) newQty = stock;

                setRowLoading(row, true);
                try {
                    const data = await postForm('@Url.Action("UpdateAjax", "Cart")', {
                        medicineId: medicineId,
                        quantity: String(newQty)
                    });

                    const item = data.item;
                    if (!item) {
                        // item might have been removed (qty <=0) - refresh UI by removing row
                        row.remove();
                        recalcSelected();
                        return;
                    }

                    const qtyEl = row.querySelector('.qtyVal');
                    if (qtyEl) qtyEl.textContent = String(item.quantity);

                    row.dataset.lineTotal = String(item.lineTotal);
                    row.dataset.stock = String(item.stock);

                    const lineEl = row.querySelector('.lineTotal');
                    if (lineEl) lineEl.textContent = formatVnd(item.lineTotal);

                    const btnMinus = row.querySelector('.btnMinus');
                    const btnPlus = row.querySelector('.btnPlus');
                    if (btnMinus) btnMinus.disabled = item.quantity <= 1;
                    if (btnPlus) btnPlus.disabled = item.stock > 0 && item.quantity >= item.stock;

                    recalcSelected();
                } finally {
                    setRowLoading(row, false);
                }
            }

            async function removeRow(row) {
                const medicineId = row.dataset.medicineId;
                setRowLoading(row, true);
                try {
                    await postForm('@Url.Action("RemoveAjax", "Cart")', { medicineId });
                    row.remove();
                    recalcSelected();
                    // if empty after remove => reload to show empty state
                    if (getRows().length === 0) window.location.reload();
                } finally {
                    // no-op
                }
            }

            if (tbody) {
                tbody.addEventListener('click', async (e) => {
                    const btnMinus = e.target.closest('.btnMinus');
                    const btnPlus = e.target.closest('.btnPlus');
                    const btnDelete = e.target.closest('.btnDelete');
                    const row = e.target.closest('tr[data-medicine-id]');
                    if (!row) return;

                    if (btnDelete) {
                        if (!confirm('Bạn có chắc muốn xóa thuốc này?')) return;
                        await removeRow(row);
                        return;
                    }

                    const qtyEl = row.querySelector('.qtyVal');
                    const current = qtyEl ? Number(qtyEl.textContent || 1) : 1;

                    if (btnMinus) {
                        await updateQuantity(row, current - 1);
                    } else if (btnPlus) {
                        await updateQuantity(row, current + 1);
                    }
                });

                tbody.addEventListener('change', (e) => {
                    if (e.target.classList.contains('chkItem')) recalcSelected();
                });
            }

            if (chkAll) {
                chkAll.addEventListener('change', () => {
                    for (const r of getRows()) {
                        const chk = r.querySelector('.chkItem');
                        if (chk) chk.checked = chkAll.checked;
                    }
                    recalcSelected();
                });
            }

            if (btnClearSelected) {
                btnClearSelected.addEventListener('click', async () => {
                    const ids = getRows()
                        .filter(r => r.querySelector('.chkItem')?.checked)
                        .map(r => r.dataset.medicineId);

                    if (ids.length === 0) return;
                    if (!confirm('Xóa các thuốc đã chọn khỏi giỏ hàng?')) return;

                    await postForm('@Url.Action("ClearSelectedAjax", "Cart")', { medicineIds: ids });
                    for (const id of ids) {
                        const r = document.getElementById('row-' + id);
                        if (r) r.remove();
                    }
                    recalcSelected();
                    if (getRows().length === 0) window.location.reload();
                });
            }

            if (btnCheckout) {
                btnCheckout.addEventListener('click', () => {
                    const selectedIds = getRows()
                        .filter(r => r.querySelector('.chkItem')?.checked)
                        .map(r => r.dataset.medicineId);

                    if (selectedIds.length === 0) return;

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '@Url.Action("Index", "Checkout")';

                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);

                    selectedIds.forEach(id => {
                        const inp = document.createElement('input');
                        inp.type = 'hidden';
                        inp.name = 'medicineIds';
                        inp.value = id;
                        form.appendChild(inp);
                    });

                    document.body.appendChild(form);
                    form.submit();
                });
            }

            // init button states + totals
            for (const r of getRows()) {
                const qtyEl = r.querySelector('.qtyVal');
                const qty = qtyEl ? Number(qtyEl.textContent || 1) : 1;
                const stock = Number(r.dataset.stock || 0);
                const btnMinus = r.querySelector('.btnMinus');
                const btnPlus = r.querySelector('.btnPlus');
                if (btnMinus) btnMinus.disabled = qty <= 1;
                if (btnPlus) btnPlus.disabled = stock > 0 && qty >= stock;
            }
            recalcSelected();
        })();
    </script>
}
