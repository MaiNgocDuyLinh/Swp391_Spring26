@model Group3_SWP391_PetMedical.ViewModels.Retail.CartVm
@{
    ViewData["Title"] = "Giỏ hàng";
}

@section Styles {
    <style>
        .cart-wrap {
            margin-top: 150px;
        }

        .cart-hero {
            background: linear-gradient(135deg, #ff9a9e, #fecfef);
            border-radius: 18px;
            padding: 24px 28px;
            color: #2b2b2b;
            box-shadow: 0 14px 32px rgba(0,0,0,0.12);
        }

            .cart-hero h3 {
                font-weight: 800;
                margin-bottom: 6px;
            }

            .cart-hero p {
                margin: 0;
                opacity: 0.85;
            }

        .cart-table-wrap {
            background: #fff;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 12px 28px rgba(0,0,0,0.06);
            margin-top: 18px;
        }

        .cart-thumb {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.08);
            background: #fafafa;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .cart-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .cart-qty {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .cart-qty-btn {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            border: 1px solid rgba(0,0,0,0.12);
            background: #fff;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .cart-qty-btn:disabled {
                opacity: 0.45;
                pointer-events: none;
            }

        .cart-qty-value {
            min-width: 42px;
            text-align: center;
            font-weight: 800;
        }

        .cart-table {
            margin: 0;
        }

            .cart-table th {
                font-weight: 700;
                color: #2b2b2b;
                border-bottom: 2px solid rgba(0,0,0,0.08);
                padding: 14px 12px;
            }

            .cart-table td {
                padding: 16px 12px;
                vertical-align: middle;
            }

            .cart-table tbody tr {
                border-bottom: 1px solid rgba(0,0,0,0.06);
            }

                .cart-table tbody tr:last-child {
                    border-bottom: none;
                }

        .cart-btn-primary {
            border-radius: 999px;
            padding: 0 18px;
            height: 38px;
            font-weight: 700;
            border: none;
            background: #ff3b3b;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 0.9rem;
        }

            .cart-btn-primary:hover {
                background: #e83434;
                color: #fff;
            }

        .cart-btn-ghost {
            border-radius: 999px;
            padding: 0 18px;
            height: 38px;
            font-weight: 600;
            background: #fff;
            border: 1px solid rgba(0,0,0,0.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: #2b2b2b;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .cart-btn-ghost:hover {
                background: #f8f8f8;
                color: #2b2b2b;
            }

        .cart-btn-danger {
            background: #dc3545;
            color: #fff;
            border: none;
            border-radius: 999px;
            padding: 6px 14px;
            font-size: 0.85rem;
            font-weight: 600;
        }

            .cart-btn-danger:hover {
                background: #c82333;
                color: #fff;
            }

        .cart-total-box {
            background: #f8f9fa;
            border-radius: 16px;
            padding: 20px;
            margin-top: 18px;
        }

            .cart-total-box .total-row {
                display: flex;
                justify-content: space-between;
                font-size: 1.1rem;
                font-weight: 700;
            }

            .cart-total-box .total-amount {
                color: #e3342f;
                font-size: 1.3rem;
            }

        .cart-empty {
            border-radius: 18px;
            padding: 48px 22px;
            text-align: center;
            background: #fff;
            border: 1px dashed rgba(0,0,0,0.12);
            margin-top: 20px;
        }

            .cart-empty i {
                font-size: 3rem;
                color: #ccc;
                margin-bottom: 12px;
            }

        .cart-sidebar {
            position: sticky;
            top: 110px;
        }

        .cart-side-card {
            background: #fff;
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 12px 28px rgba(0,0,0,0.06);
            border: 1px solid rgba(0,0,0,0.04);
        }

        .cart-side-title {
            font-weight: 800;
            margin-bottom: 6px;
        }

        .cart-side-muted {
            color: #777;
            font-size: 0.95rem;
        }

        .cart-side-total {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-top: 14px;
            font-weight: 800;
        }

        .cart-side-total .amount {
            color: #e3342f;
            font-size: 1.35rem;
        }
    </style>
}

<section class="container cart-wrap" id="cartArea">
    <div class="cart-hero">
        <h3>Giỏ hàng của bạn</h3>
        <p>Xem và chỉnh sửa các thuốc bạn đã chọn trước khi đặt hàng.</p>
    </div>

    <form id="__af" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    @if (Model?.items == null || !Model.items.Any())
    {
        <div class="cart-empty">
            <i class="fas fa-shopping-basket"></i>
            <p class="mb-3">Giỏ hàng trống. Hãy chọn thuốc bạn cần cho thú cưng.</p>
            <a class="cart-btn-primary" href="@Url.Action("RetailViewList", "Retail")">
                <i class="fas fa-capsules"></i> Back to Shop
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 mt-2">
            <div class="col-lg-8">
                <div class="cart-table-wrap">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkAll" checked>
                            <label class="form-check-label" for="chkAll">Chọn tất cả</label>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="btnClearSelected">
                            <i class="fas fa-broom"></i> Clear Selected
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table cart-table align-middle">
                            <thead>
                                <tr>
                                    <th style="width:44px;"></th>
                                    <th>Tên thuốc</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-end" style="width:50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="cartTbody">
                                @foreach (var item in Model.items)
                                {
                                    // lightweight SVG thumbnail (no db field yet)
                                    var svg = $"<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop stop-color='%23ff9a9e'/><stop offset='1' stop-color='%23fecfef'/></linearGradient></defs><rect width='64' height='64' rx='14' fill='url(%23g)'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' font-family='Arial' font-size='22' font-weight='800' fill='%232b2b2b'>Rx</text></svg>";
                                    var thumbSrc = "data:image/svg+xml;utf8," + Uri.EscapeDataString(svg);

                                    <tr id="row-@item.medicine_id"
                                        data-medicine-id="@item.medicine_id"
                                        data-unit-price="@item.unit_price"
                                        data-line-total="@item.line_total"
                                        data-stock="@item.stock_quantity">
                                        <td>
                                            <input class="form-check-input chkItem" type="checkbox" checked>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@item.medicine_name</div>
                                            <div class="text-muted small">Mã: @item.medicine_id</div>
                                        </td>
                                        <td class="text-end">@item.unit_price.ToString("N0") đ</td>
                                        <td class="text-center">
                                            <div class="cart-qty justify-content-center">
                                                <button type="button" class="cart-qty-btn btnMinus" aria-label="minus">-</button>
                                                <div class="cart-qty-value qtyVal">@item.quantity</div>
                                                <button type="button" class="cart-qty-btn btnPlus" aria-label="plus">+</button>
                                            </div>
                                            <div class="text-muted small mt-1">Tồn: @item.stock_quantity</div>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold text-danger lineTotal">@item.line_total.ToString("N0") đ</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-link text-danger p-0 btnDelete" title="Xóa">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-start mt-3">
                        <a class="cart-btn-ghost" href="@Url.Action("RetailViewList", "Retail")">
                            <i class="fas fa-arrow-left"></i> Tiếp tục mua thuốc
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-sidebar">
                    <div class="cart-side-card">
                        <div class="cart-side-title">Tóm tắt</div>
                        <div class="cart-side-muted">Chỉ tính các thuốc đang được chọn.</div>

                        <div class="cart-side-total">
                            <span>Tạm tính</span>
                            <span class="amount" id="selectedTotal">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mt-2 text-muted">
                            <span>Đã chọn</span>
                            <span id="selectedCount">0</span>
                        </div>

                        <button type="button" class="btn btn-danger w-100 mt-3" id="btnCheckout" disabled>
                            <i class="fas fa-credit-card"></i> Checkout Selected
                        </button>

                        <div class="text-muted small mt-2">
                            (Payment/Checkout sẽ nối sau; hiện chỉ demo UI + tổng tiền chọn.)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script>
        (function () {
            const af = document.querySelector('#__af input[name="__RequestVerificationToken"]');
            const token = af ? af.value : '';

            const tbody = document.getElementById('cartTbody');
            const chkAll = document.getElementById('chkAll');
            const selectedTotalEl = document.getElementById('selectedTotal');
            const selectedCountEl = document.getElementById('selectedCount');
            const btnCheckout = document.getElementById('btnCheckout');
            const btnClearSelected = document.getElementById('btnClearSelected');

            function formatVnd(n) {
                try { return new Intl.NumberFormat('vi-VN').format(n) + ' đ'; }
                catch { return n.toFixed(0) + ' đ'; }
            }

            function getRows() {
                if (!tbody) return [];
                return Array.from(tbody.querySelectorAll('tr[data-medicine-id]'));
            }

            function recalcSelected() {
                const rows = getRows();
                let total = 0;
                let count = 0;
                for (const r of rows) {
                    const chk = r.querySelector('.chkItem');
                    if (chk && chk.checked) {
                        count++;
                        total += Number(r.dataset.lineTotal || 0);
                    }
                }
                if (selectedTotalEl) selectedTotalEl.textContent = formatVnd(total);
                if (selectedCountEl) selectedCountEl.textContent = String(count);
                if (btnCheckout) btnCheckout.disabled = count === 0;

                if (chkAll) {
                    const all = rows.length > 0 && rows.every(r => r.querySelector('.chkItem')?.checked);
                    const any = rows.some(r => r.querySelector('.chkItem')?.checked);
                    chkAll.indeterminate = any && !all;
                    chkAll.checked = all;
                }
            }

            async function postForm(url, formObj) {
                const fd = new FormData();
                for (const k of Object.keys(formObj)) {
                    const v = formObj[k];
                    if (Array.isArray(v)) {
                        for (const item of v) fd.append(k, item);
                    } else {
                        fd.append(k, v);
                    }
                }
                fd.append('__RequestVerificationToken', token);

                const res = await fetch(url, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Request failed');
                return await res.json();
            }

            function setRowLoading(row, isLoading) {
                const buttons = row.querySelectorAll('button');
                buttons.forEach(b => b.disabled = isLoading || b.classList.contains('btnDelete') && b.disabled);
                row.style.opacity = isLoading ? '0.65' : '';
            }

            async function updateQuantity(row, newQty) {
                const medicineId = row.dataset.medicineId;
                const stock = Number(row.dataset.stock || 0);
                if (newQty < 1) newQty = 1;
                if (stock > 0 && newQty > stock) newQty = stock;

                setRowLoading(row, true);
                try {
                    const data = await postForm('@Url.Action("UpdateAjax", "Cart")', {
                        medicineId: medicineId,
                        quantity: String(newQty)
                    });

                    const item = data.item;
                    if (!item) {
                        // item might have been removed (qty <=0) - refresh UI by removing row
                        row.remove();
                        recalcSelected();
                        return;
                    }

                    const qtyEl = row.querySelector('.qtyVal');
                    if (qtyEl) qtyEl.textContent = String(item.quantity);

                    row.dataset.lineTotal = String(item.lineTotal);
                    row.dataset.stock = String(item.stock);

                    const lineEl = row.querySelector('.lineTotal');
                    if (lineEl) lineEl.textContent = formatVnd(item.lineTotal);

                    const btnMinus = row.querySelector('.btnMinus');
                    const btnPlus = row.querySelector('.btnPlus');
                    if (btnMinus) btnMinus.disabled = item.quantity <= 1;
                    if (btnPlus) btnPlus.disabled = item.stock > 0 && item.quantity >= item.stock;

                    recalcSelected();
                } finally {
                    setRowLoading(row, false);
                }
            }

            async function removeRow(row) {
                const medicineId = row.dataset.medicineId;
                setRowLoading(row, true);
                try {
                    await postForm('@Url.Action("RemoveAjax", "Cart")', { medicineId });
                    row.remove();
                    recalcSelected();
                    // if empty after remove => reload to show empty state
                    if (getRows().length === 0) window.location.reload();
                } finally {
                    // no-op
                }
            }

            if (tbody) {
                tbody.addEventListener('click', async (e) => {
                    const btnMinus = e.target.closest('.btnMinus');
                    const btnPlus = e.target.closest('.btnPlus');
                    const btnDelete = e.target.closest('.btnDelete');
                    const row = e.target.closest('tr[data-medicine-id]');
                    if (!row) return;

                    if (btnDelete) {
                        if (!confirm('Bạn có chắc muốn xóa thuốc này?')) return;
                        await removeRow(row);
                        return;
                    }

                    const qtyEl = row.querySelector('.qtyVal');
                    const current = qtyEl ? Number(qtyEl.textContent || 1) : 1;

                    if (btnMinus) {
                        await updateQuantity(row, current - 1);
                    } else if (btnPlus) {
                        await updateQuantity(row, current + 1);
                    }
                });

                tbody.addEventListener('change', (e) => {
                    if (e.target.classList.contains('chkItem')) recalcSelected();
                });
            }

            if (chkAll) {
                chkAll.addEventListener('change', () => {
                    for (const r of getRows()) {
                        const chk = r.querySelector('.chkItem');
                        if (chk) chk.checked = chkAll.checked;
                    }
                    recalcSelected();
                });
            }

            if (btnClearSelected) {
                btnClearSelected.addEventListener('click', async () => {
                    const ids = getRows()
                        .filter(r => r.querySelector('.chkItem')?.checked)
                        .map(r => r.dataset.medicineId);

                    if (ids.length === 0) return;
                    if (!confirm('Xóa các thuốc đã chọn khỏi giỏ hàng?')) return;

                    await postForm('@Url.Action("ClearSelectedAjax", "Cart")', { medicineIds: ids });
                    for (const id of ids) {
                        const r = document.getElementById('row-' + id);
                        if (r) r.remove();
                    }
                    recalcSelected();
                    if (getRows().length === 0) window.location.reload();
                });
            }

            if (btnCheckout) {
                btnCheckout.addEventListener('click', () => {
                    const selectedIds = getRows()
                        .filter(r => r.querySelector('.chkItem')?.checked)
                        .map(r => r.dataset.medicineId);

                    if (selectedIds.length === 0) return;

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '@Url.Action("Index", "Checkout")';

                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);

                    selectedIds.forEach(id => {
                        const inp = document.createElement('input');
                        inp.type = 'hidden';
                        inp.name = 'medicineIds';
                        inp.value = id;
                        form.appendChild(inp);
                    });

                    document.body.appendChild(form);
                    form.submit();
                });
            }

            // init button states + totals
            for (const r of getRows()) {
                const qtyEl = r.querySelector('.qtyVal');
                const qty = qtyEl ? Number(qtyEl.textContent || 1) : 1;
                const stock = Number(r.dataset.stock || 0);
                const btnMinus = r.querySelector('.btnMinus');
                const btnPlus = r.querySelector('.btnPlus');
                if (btnMinus) btnMinus.disabled = qty <= 1;
                if (btnPlus) btnPlus.disabled = stock > 0 && qty >= stock;
            }
            recalcSelected();
        })();
    </script>
}
