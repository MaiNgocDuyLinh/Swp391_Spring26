@model IEnumerable<Group3_SWP391_PetMedical.Models.Medication>
@{
    ViewData["Title"] = "Đặt thuốc";

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int pageSize = ViewBag.PageSize is int ps ? ps : 12;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : (Model?.Count() ?? 0);
    string? search = ViewBag.Search as string;
}

@section Styles {
    <style>
        .retail-wrap {
            margin-top: 150px;
        }

        .retail-hero {
            background: linear-gradient(135deg, #ff9a9e, #fecfef);
            border-radius: 18px;
            padding: 24px 28px;
            color: #2b2b2b;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 14px 32px rgba(0,0,0,0.12);
        }

            .retail-hero h3 {
                font-weight: 800;
                margin-bottom: 6px;
            }

            .retail-hero p {
                margin: 0;
                opacity: 0.85;
            }

        .retail-filter {
            margin-top: 18px;
            background: #fff;
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 12px 28px rgba(0,0,0,0.06);
        }

        .retail-input {
            border-radius: 999px;
            height: 44px;
            border: 1px solid rgba(0,0,0,0.08);
            padding: 0 18px;
        }

        .retail-btn-primary {
            border-radius: 999px;
            height: 44px;
            padding: 0 22px;
            font-weight: 700;
            border: none;
            background: #ff3b3b;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 14px 30px rgba(255,59,59,0.35);
        }

            .retail-btn-primary:hover {
                background: #e83434;
                color: #fff;
            }

        .retail-btn-ghost {
            border-radius: 999px;
            height: 44px;
            padding: 0 22px;
            font-weight: 600;
            background: #fff;
            border: 1px solid rgba(0,0,0,0.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #2b2b2b;
            text-decoration: none;
        }

        .retail-grid {
            margin-top: 22px;
        }

        .retail-card {
            background: #fff;
            border-radius: 18px;
            padding: 18px 18px 14px;
            box-shadow: 0 10px 24px rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            height: 100%;
            border: 1px solid rgba(0,0,0,0.04);
        }

            .retail-card h5 {
                font-weight: 800;
                margin-bottom: 4px;
            }

        .retail-price {
            font-weight: 800;
            color: #e3342f;
            font-size: 1.05rem;
        }

        .retail-stock-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

            .retail-stock-badge.ok {
                background: #ebffef;
                color: #1e7e34;
                border: 1px solid #b7ebc4;
            }

            .retail-stock-badge.low {
                background: #fff3cd;
                color: #856404;
                border: 1px solid #ffe08a;
            }

            .retail-stock-badge.out {
                background: #ffecec;
                color: #b02a37;
                border: 1px solid #ffc9cf;
            }

        .retail-card-footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .retail-empty {
            border-radius: 18px;
            padding: 32px 22px;
            text-align: center;
            background: #fff;
            border: 1px dashed rgba(0,0,0,0.12);
            margin-top: 20px;
        }

        .retail-pager.pagination {
            gap: 10px;
            margin: 0;
        }

            .retail-pager.pagination .page-item .page-link {
                border-radius: 999px !important;
                width: 40px;
                height: 40px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 !important;
                border: 1px solid rgba(0,0,0,0.1);
                color: #2b2b2b;
                background: #fff;
                box-shadow: 0 8px 18px rgba(0,0,0,0.04);
            }

            .retail-pager.pagination .page-item.active .page-link {
                background: #ff3b3b !important;
                border-color: #ff3b3b !important;
                color: #fff !important;
                box-shadow: 0 12px 24px rgba(255,59,59,0.25);
            }

            .retail-pager.pagination .page-item.disabled .page-link {
                opacity: 0.5;
                pointer-events: none;
                box-shadow: none;
            }
    </style>
}

<section class="container retail-wrap" id="retailArea">
    <div class="retail-hero">
        <div>
            <h3>Đặt thuốc cho thú cưng</h3>
            <p>Chọn thuốc bạn cần, chúng tôi sẽ chuẩn bị sẵn để bạn tới lấy.</p>
        </div>
    </div>

    <div class="retail-filter">
        <form method="get" asp-controller="Retail" asp-action="RetailViewList" class="row g-3">
            <div class="col-lg-8 col-md-7">
                <input class="form-control retail-input" type="text" name="search" value="@search"
                       placeholder="Tìm tên thuốc..." />
            </div>
            <div class="col-lg-4 col-md-5 d-flex justify-content-md-end gap-2">
                <a class="retail-btn-ghost" href="@Url.Action("RetailViewList", "Retail")#retailArea">
                    <i class="fas fa-undo-alt"></i> Làm mới
                </a>
                <button type="submit" class="retail-btn-primary">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="retail-empty">
            <i class="fas fa-box-open fa-2x mb-2"></i>
            <p>Hiện chưa có thuốc nào phù hợp với tìm kiếm của bạn.</p>
        </div>
    }
    else
    {
        <div class="row retail-grid">
            @{
                int index = (currentPage - 1) * pageSize + 1;
            }
            @foreach (var m in Model)
            {
                var qty = m.stock_quantity ?? 0;
                string badgeClass = qty == 0 ? "out" : qty <= 10 ? "low" : "ok";
                string badgeText = qty == 0 ? "Hết hàng" : qty <= 10 ? $"Sắp hết ({qty})" : $"Còn {qty} đơn vị";
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="retail-card">
                        <h5>@m.name</h5>
                        <div class="retail-price">
                            @m.unit_price.ToString("N0") đ
                        </div>

                        <div class="mt-2">
                            <span class="retail-stock-badge @badgeClass">
                                <i class="fas fa-capsules"></i> @badgeText
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(m.description))
                        {
                            <p class="mt-2 mb-2" style="font-size:0.9rem; color:#666; max-height:3.3em; overflow:hidden;">
                                @m.description
                            </p>
                        }

                        <div class="retail-card-footer">
                            <small style="color:#888;">Mã thuốc: @m.medicine_id</small>
                            @if (qty <= 0)
                            {
                                <button type="button" class="retail-btn-primary" disabled>
                                    <i class="fas fa-ban"></i> Hết hàng
                                </button>
                            }
                            else
                            {
                                <form method="post" asp-controller="Cart" asp-action="Add" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="medicineId" value="@m.medicine_id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="retail-btn-primary">
                                        <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
                index++;
            }
        </div>

        <div class="mt-2 d-flex justify-content-end">
            <a class="retail-btn-ghost" href="@Url.Action("Index", "Cart")">
                <i class="fas fa-shopping-basket"></i> Xem giỏ hàng
            </a>
        </div>

        <div class="mt-3 d-flex justify-content-center">
            <ul class="pagination retail-pager">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("RetailViewList", "Retail", new { search, page = currentPage - 1 })#retailArea">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Math.Max(totalPages, 1); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("RetailViewList", "Retail", new { search, page = i })#retailArea">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("RetailViewList", "Retail", new { search, page = currentPage + 1 })#retailArea">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="text-center mt-2" style="color:#777; font-size:0.95rem;">
            Tổng: <strong>@totalItems</strong> thuốc
        </div>
    }
</section>

