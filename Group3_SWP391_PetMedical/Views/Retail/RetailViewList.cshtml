@model IEnumerable<Group3_SWP391_PetMedical.Models.Medication>
@{
    ViewData["Title"] = "Đặt thuốc";

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int pageSize = ViewBag.PageSize is int ps ? ps : 12;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : (Model?.Count() ?? 0);
    string? search = ViewBag.Search as string;
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:18px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--primary:disabled { opacity: 0.6; cursor: not-allowed; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        
        .pc-card { background:#fff; border-radius:16px; padding:18px; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); display:flex; flex-direction:column; height:100%; }
        .pc-card h5 { font-weight:800; margin-bottom:4px; }
        .pc-price { font-weight:800; color:var(--pc-red); font-size:1.1rem; }
        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; font-weight:700; font-size:0.82rem; }
        .pc-card-footer { margin-top:auto; display:flex; justify-content:space-between; align-items:center; gap:8px; }
        
        .pc-pager.pagination { gap:10px; margin:0; }
        .pc-pager .page-item .page-link { border-radius:999px !important; width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center; padding:0 !important; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text); background:#fff; box-shadow:0 8px 18px rgba(0,0,0,0.04); }
        .pc-pager .page-item .page-link:hover { border-color:rgba(255,59,59,0.35); box-shadow:0 10px 22px rgba(255,59,59,0.12); color:var(--pc-red-dark); }
        .pc-pager .page-item.active .page-link { background:var(--pc-red) !important; border-color:var(--pc-red) !important; color:#fff !important; box-shadow:0 12px 24px rgba(255,59,59,0.25); }
        .pc-pager .page-item.disabled .page-link { opacity:0.45; pointer-events:none; box-shadow:none; }
    </style>
}

<section class="container py-4" id="retailArea">
    <div class="pc-wrap" style="margin-top:150px;">
        <h3 class="pc-title">Đặt thuốc cho thú cưng</h3>
        <p class="pc-sub">Chọn thuốc bạn cần, chúng tôi sẽ chuẩn bị sẵn để bạn tới lấy.</p>

        <div class="pc-filter">
            <form method="get" asp-controller="Retail" asp-action="RetailViewList" class="row g-3">
                <div class="col-lg-8 col-md-7">
                    <input class="form-control pc-input" type="text" name="search" value="@search"
                           placeholder="Tìm tên thuốc..." />
                </div>
                <div class="col-lg-4 col-md-5 d-flex justify-content-md-end gap-2">
                    <a class="pc-btn pc-btn--ghost" href="@Url.Action("RetailViewList", "Retail")#retailArea">
                        <i class="fas fa-undo-alt"></i> Làm mới
                    </a>
                    <button type="submit" class="pc-btn pc-btn--primary">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info mb-0 mt-3" style="border-radius:14px;">
                <i class="fas fa-box-open me-2"></i> Hiện chưa có thuốc nào phù hợp với tìm kiếm của bạn.
            </div>
        }
        else
        {
            <div class="row mt-3">
                @{
                    int index = (currentPage - 1) * pageSize + 1;
                }
                @foreach (var m in Model)
                {
                    var qty = m.stock_quantity ?? 0;
                    string badgeBg = qty == 0 ? "#fee2e2" : qty <= 10 ? "#fef3c7" : "#d1fae5";
                    string badgeColor = qty == 0 ? "#dc2626" : qty <= 10 ? "#b45309" : "#047857";
                    string badgeText = qty == 0 ? "Hết hàng" : qty <= 10 ? $"Sắp hết ({qty})" : $"Còn {qty} đơn vị";
                    
                    <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                        <div class="pc-card">
                            <h5>@m.name</h5>
                            <div class="pc-price">
                                @m.unit_price.ToString("N0") đ
                            </div>

                        <div class="mt-2">
                            <span class="pc-badge" style="background:@badgeBg; color:@badgeColor;">
                                <i class="fas fa-capsules"></i> @badgeText
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(m.description))
                        {
                            <p class="mt-2 mb-2" style="font-size:0.9rem; color:#666; max-height:3.3em; overflow:hidden;">
                                @m.description
                            </p>
                        }

                        <div class="pc-card-footer">
                            <small style="color:#888;">Mã thuốc: @m.medicine_id</small>
                            @if (qty <= 0)
                            {
                                <button type="button" class="pc-btn pc-btn--primary" disabled>
                                    <i class="fas fa-ban"></i> Hết hàng
                                </button>
                            }
                            else
                            {
                                <form method="post" asp-controller="Cart" asp-action="Add" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="medicineId" value="@m.medicine_id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="pc-btn pc-btn--primary">
                                        <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
                index++;
            }
        </div>

        <div class="mt-2 d-flex justify-content-end">
            <a class="pc-btn pc-btn--ghost" href="@Url.Action("Index", "Cart")">
                <i class="fas fa-shopping-basket"></i> Xem giỏ hàng
            </a>
        </div>

        <div class="mt-3 d-flex justify-content-center">
            <ul class="pagination pc-pager">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("RetailViewList", "Retail", new { search, page = currentPage - 1 })#retailArea">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Math.Max(totalPages, 1); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("RetailViewList", "Retail", new { search, page = i })#retailArea">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("RetailViewList", "Retail", new { search, page = currentPage + 1 })#retailArea">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="text-center mt-2" style="color:var(--pc-muted); font-size:0.95rem;">
            Tổng: <strong>@totalItems</strong> thuốc
        </div>
    }
</section>

