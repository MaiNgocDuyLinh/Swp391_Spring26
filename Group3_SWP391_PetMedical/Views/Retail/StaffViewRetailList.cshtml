@model IEnumerable<Group3_SWP391_PetMedical.Models.RetailOrder>
@{
    ViewData["Title"] = "Quản lý Đơn thuốc bán ra";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count() ?? 0);
    string? search = ViewBag.Search;
    var selectedDate = (DateTime?)ViewBag.SelectedDate ?? DateTime.Today;

    (string bg, string color, string icon) StatusStyle(string? s) => (s ?? "").Trim().ToUpper() switch {
        "PAID" => ("#d1fae5", "#047857", "fa-check-circle"),
        "UNPAID" => ("#fee2e2", "#dc2626", "fa-times-circle"),
        "PENDING" => ("#fef3c7", "#d97706", "fa-clock"),
        "CANCELLED" => ("#f3f4f6", "#6b7280", "fa-ban"),
        "FAILED" => ("#fee2e2", "#dc2626", "fa-exclamation-circle"),
        _ => ("#f3f4f6", "#6b7280", "fa-question-circle")
    };

    (string bg, string color, string icon) OrderStatusStyle(string? s) => (s ?? "").Trim() switch {
        "Đã tiếp nhận" => ("#e0f2fe", "#0369a1", "fa-bell"),
        "Đã soạn hàng" => ("#f3e8ff", "#7e22ce", "fa-box-open"),
        "Đã giao thuốc" => ("#d1fae5", "#047857", "fa-shipping-fast"),
        "Hủy/Hoàn trả" => ("#fee2e2", "#dc2626", "fa-undo"),
        "Không nhận" => ("#fef3c7", "#d97706", "fa-exclamation-triangle"),
        _ => ("#f3f4f6", "#6b7280", "fa-spinner")
    };
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:18px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-label { font-weight:700; font-size:0.9rem; margin-bottom:6px; }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-table { border-radius:16px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-table thead th { background:#fff7f7; font-weight:800; }
        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; font-weight:700; font-size:0.82rem; }
        .pc-ico { width:36px; height:36px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.10); background:#fff; color:var(--pc-text); box-shadow:0 8px 18px rgba(0,0,0,0.04); text-decoration:none; cursor:pointer; }
        .pc-ico:hover { border-color:rgba(255,59,59,0.35); box-shadow:0 10px 22px rgba(255,59,59,0.12); color:var(--pc-red-dark); }
        .pc-action-icons { display:flex; justify-content:flex-end; gap:10px; }
        tbody.pc-record { transition:background 0.25s ease; }
        tbody.pc-record:hover tr { background:#fff3f3 !important; }
        .pc-pager.pagination { gap:10px; margin:0; }
        .pc-pager .page-item .page-link { border-radius:999px !important; width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center; padding:0 !important; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text); background:#fff; box-shadow:0 8px 18px rgba(0,0,0,0.04); }
        .pc-pager .page-item .page-link:hover { border-color:rgba(255,59,59,0.35); box-shadow:0 10px 22px rgba(255,59,59,0.12); color:var(--pc-red-dark); }
        .pc-pager .page-item.active .page-link { background:var(--pc-red) !important; border-color:var(--pc-red) !important; color:#fff !important; box-shadow:0 12px 24px rgba(255,59,59,0.25); }
        .pc-pager .page-item.disabled .page-link { opacity:0.45; pointer-events:none; box-shadow:none; }
    </style>
}

<section class="container py-4" id="staffRetailArea">
    <div class="pc-wrap" style="margin-top:150px;">
        <h3 class="pc-title">Đơn thuốc bán ra (Bán lẻ)</h3>
        <p class="pc-sub">Quản lý các đơn thuốc khách hàng đã đặt theo ngày</p>

        <div class="pc-filter">
            <form method="get" asp-controller="Retail" asp-action="StaffViewRetailList" class="row g-3">
                <div class="col-lg-3 col-md-4">
                    <div class="pc-label">Chọn ngày</div>
                    <input type="date" class="form-control pc-input" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="pc-label">Trạng thái TT</div>
                    <select class="form-select pc-input" name="status" onchange="this.form.submit()">
                        <option value="">Tất cả</option>
                        <option value="PAID" selected="@(ViewBag.Status?.ToString() == "PAID" ? "selected" : null)">Đã thanh toán (PAID)</option>
                        <option value="PENDING" selected="@(ViewBag.Status?.ToString() == "PENDING" ? "selected" : null)">Chờ xử lý (PENDING)</option>
                        <option value="Failed" selected="@(ViewBag.Status?.ToString() == "Failed" ? "selected" : null)">Thanh toán thất bại (Failed)</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="pc-label">Trạng thái đơn hàng</div>
                    <select class="form-select pc-input" name="statusOrder" onchange="this.form.submit()">
                        <option value="">Tất cả</option>
                        <option value="Đã tiếp nhận" selected="@(ViewBag.StatusOrder?.ToString() == "Đã tiếp nhận")">🔵 Đã tiếp nhận</option>
                        <option value="Đã soạn hàng" selected="@(ViewBag.StatusOrder?.ToString() == "Đã soạn hàng")">📦 Đã soạn hàng</option>
                        <option value="Đã giao thuốc" selected="@(ViewBag.StatusOrder?.ToString() == "Đã giao thuốc")">✅ Đã giao thuốc</option>
                        <option value="Hủy/Hoàn trả" selected="@(ViewBag.StatusOrder?.ToString() == "Hủy/Hoàn trả")">❌ Hủy/Hoàn trả</option>
                        <option value="Không nhận" selected="@(ViewBag.StatusOrder?.ToString() == "Không nhận")">⚠️ Không nhận</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="pc-label">Từ khóa</div>
                    <input class="form-control pc-input" name="search" value="@ViewBag.Search" placeholder="Tên khách hàng / Mã đơn..." />
                </div>
                <div class="col-12 mt-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <a class="pc-btn pc-btn--ghost" href="@Url.Action("StaffViewRetailList", "Retail")#staffRetailArea"><i class="fas fa-undo-alt"></i> Làm mới</a>
                        <button type="submit" class="pc-btn pc-btn--primary"><i class="fas fa-filter"></i> Lọc</button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info mb-0" style="border-radius:14px;">
                Không tìm thấy đơn thuốc nào.
            </div>
        }
        else
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th style="width:100px;">Giờ đặt</th>
                            <th style="width:120px;">Ngày lấy</th>
                            <th>Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th class="text-center">Số loại thuốc</th>
                            <th class="text-end">Tổng tiền</th>
                            <th style="width:160px;">Trạng thái TT</th>
                            <th style="width:130px;">Trạng thái ĐH</th>
                            <th style="width:80px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    @{int idx = (currentPage - 1) * 10 + 1;}
                    <tbody class="pc-record">
                    @foreach (var o in Model)
                    {
                        var s = StatusStyle(o.status);
                        <tr>
                            <td>@idx</td>
                             <td><strong>@(o.created_at?.ToString("HH:mm") ?? "-")</strong></td>
                             <td>
                                 <div class="fw-bold">@(o.pickup_date?.ToString("dd/MM/yyyy") ?? "-")</div>
                                 <div class="text-muted small">(@(o.pickup_slot ?? "N/A"))</div>
                             </td>
                             <td>#@o.id</td>
                            <td>
                                <strong>@(o.user?.full_name ?? "Khách lẻ")</strong>
                            </td>
                            <td class="text-center">@(o.OrderDetails?.Count ?? 0)</td>
                            <td class="text-end fw-semibold text-danger">@o.total_amount.ToString("N0") đ</td>
                            <td>
                                <span class="pc-badge" style="background:@s.bg; color:@s.color;">
                                    <i class="fas @s.icon"></i> @(o.status == "PAID" ? "Đã thanh toán" : (o.status == "PENDING" ? "Chờ xử lý" : (o.status == "UNPAID" ? "Chưa thanh toán" : (o.status == "Failed" ? "Thanh toán thất bại" : o.status))))
                                </span>
                            </td>
                            <td>
                                @{ var os = OrderStatusStyle(o.status_order); }
                                <span class="pc-badge" style="background:@os.bg; color:@os.color;">
                                    <i class="fas @os.icon"></i> @(o.status_order ?? "Chưa cập nhật")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="pc-action-icons">
                                    <a class="pc-ico pc-btn-no-border text-decoration-none" style="background:transparent;border:1px solid rgba(0,0,0,0.10);width:36px;height:36px;" title="Chi tiết" href="@Url.Action("StaffViewRetailDetail", "Retail", new { id = o.id })">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        idx++;
                    }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex justify-content-center">
                <ul class="pagination pc-pager">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("StaffViewRetailList", "Retail", new { date = selectedDate.ToString("yyyy-MM-dd"), search, status = ViewBag.Status, statusOrder = ViewBag.StatusOrder, page = currentPage - 1 })#staffRetailArea"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Math.Max(totalPages, 1); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("StaffViewRetailList", "Retail", new { date = selectedDate.ToString("yyyy-MM-dd"), search, status = ViewBag.Status, statusOrder = ViewBag.StatusOrder, page = i })#staffRetailArea">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("StaffViewRetailList", "Retail", new { date = selectedDate.ToString("yyyy-MM-dd"), search, status = ViewBag.Status, statusOrder = ViewBag.StatusOrder, page = currentPage + 1 })#staffRetailArea"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </div>
            <div class="text-center mt-2" style="color:var(--pc-muted); font-size:0.95rem;">
                Tổng: <strong>@totalItems</strong> đơn hàng
            </div>
        }
    </div>
</section>
