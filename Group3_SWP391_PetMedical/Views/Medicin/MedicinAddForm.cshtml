@model Group3_SWP391_PetMedical.ViewModels.Medicin.CreateMedicinVm
@{
    ViewData["Title"] = "Thêm thuốc";
}

@section Styles {
    <style>
        :root {
            --pc-red: #ff3b3b;
            --pc-red-dark: #e83434;
            --pc-text: #2b2b2b;
            --pc-muted: #7a7a7a;
            --pc-border: rgba(0,0,0,0.06);
        }

        .pc-wrap {
            background: #f3d7d5;
            border: 1px solid var(--pc-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
            margin-top: 150px;
        }

        .pc-title {
            font-weight: 800;
            margin: 0;
        }

        .pc-sub {
            color: var(--pc-muted);
            margin: 0;
        }

        .pc-form-card {
            background: #fff;
            border: 1px solid var(--pc-border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        }

        .pc-form-head {
            background: #fff7f7;
            padding: 16px 20px;
            border-bottom: 1px solid var(--pc-border);
            font-weight: 800;
        }

        .pc-form-body {
            padding: 24px;
        }

        .pc-label {
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        .pc-input {
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,0.1);
            height: 42px;
            padding: 0 12px;
        }

            .pc-input:focus {
                border-color: var(--pc-red);
                box-shadow: 0 0 0 0.2rem rgba(255,59,59,0.15);
            }

        .pc-textarea {
            min-height: 120px;
            padding: 12px;
            resize: vertical;
        }

        .pc-btn {
            border-radius: 999px;
            padding: 0 18px;
            height: 42px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            text-decoration: none;
            cursor: pointer;
        }

        .pc-btn--primary {
            background: var(--pc-red);
            color: #fff;
            box-shadow: 0 10px 20px rgba(255,59,59,0.25);
        }

            .pc-btn--primary:hover {
                background: var(--pc-red-dark);
                color: #fff;
            }

        .pc-btn--ghost {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.1);
            color: var(--pc-text) !important;
        }

        .text-danger {
            font-size: 0.85rem;
        }
    </style>
}

<section class="container py-4">
    <div class="pc-wrap">
        <h3 class="pc-title">Thêm thuốc mới</h3>
        <p class="pc-sub">Nhập thông tin thuốc để thêm vào kho</p>

        <div class="mt-3 mb-3">
            <a class="pc-btn pc-btn--ghost" asp-controller="Medicin" asp-action="MedicinList">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>

        <div class="pc-form-card">
            <div class="pc-form-head"><i class="fas fa-plus-circle mr-2"></i>Thông tin thuốc</div>
            <div class="pc-form-body">
                <form asp-action="MedicinAddForm" asp-controller="Medicin" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" style="border-radius:14px;"></div>

                    <div class="mb-3">
                        <div class="pc-label">Tên thuốc <span class="text-danger">*</span></div>
                        <input asp-for="name" class="form-control pc-input" placeholder="Nhập tên thuốc..." />
                        <span asp-validation-for="name" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="pc-label">Đơn giá (VNĐ) <span class="text-danger">*</span></div>
                            <input asp-for="unit_price" type="number" min="1" step="1" class="form-control pc-input" />
                            <span asp-validation-for="unit_price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="pc-label">Số lượng tồn kho <span class="text-danger">*</span></div>
                            <input asp-for="stock_quantity" type="number" min="0" step="1" class="form-control pc-input" />
                            <span asp-validation-for="stock_quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="pc-label">Trạng thái</div>
                        <select asp-for="status" class="form-select pc-input">
                            <option value="active">Đang hoạt động</option>
                            <option value="inactive">Ngừng hoạt động</option>
                        </select>
                        <span asp-validation-for="status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="pc-label">Mô tả</div>
                        <textarea asp-for="description" class="form-control pc-input pc-textarea" placeholder="Nhập mô tả..."></textarea>
                        <span asp-validation-for="description" class="text-danger"></span>
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex justify-content-end gap-3">
                        <a asp-controller="Medicin" asp-action="MedicinList" class="pc-btn pc-btn--ghost">Hủy</a>
                        <button type="submit" class="pc-btn pc-btn--primary"><i class="fas fa-save"></i> Thêm thuốc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
