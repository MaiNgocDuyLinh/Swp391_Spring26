@model Group3_SWP391_PetMedical.ViewModels.Retail.CheckoutVm
@{
    ViewData["Title"] = "Xác nhận đơn thuốc";
    var pickupOptions = new[] { "8h-10h", "10h-12h", "14h-16h", "16h-18h" };
}

<section class="container" style="margin-top:140px;">
    <h3 class="mb-3">Xác nhận đơn thuốc</h3>

    @if (Model.StockErrors != null && Model.StockErrors.Any())
    {
        <div class="alert alert-warning">
            <strong>Kho không đủ:</strong>
            <ul class="mb-0">
                @foreach (var e in Model.StockErrors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Thuốc đã chọn</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Tên thuốc</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.medicine_name</div>
                                            <div class="text-muted small">Mã: @item.medicine_id</div>
                                        </td>
                                        <td class="text-end">@item.unit_price.ToString("N0") đ</td>
                                        <td class="text-center">@item.quantity</td>
                                        <td class="text-end fw-semibold text-danger">
                                            @item.line_total.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span class="fw-semibold">Tổng:</span>
                        <span class="fw-bold text-danger" style="font-size:1.2rem;">
                            @Model.TotalAmount.ToString("N0") đ
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Thông tin lấy thuốc</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Checkout" asp-action="Confirm" method="post">
                        @Html.AntiForgeryToken()

                        @* giữ lại danh sách thuốc đã chọn *@
                        @for (int i = 0; i < Model.SelectedMedicineIds.Length; i++)
                        {
                            <input type="hidden" name="SelectedMedicineIds[@i]" value="@Model.SelectedMedicineIds[i]" />
                        }

                        <div class="mb-3">
                            <label for="PickupSlot" class="form-label fw-semibold">Thời gian dự kiến đến lấy</label>
                            <select asp-for="PickupSlot" class="form-select">
                                <option value="">-- Chọn khung giờ --</option>
                                @foreach (var opt in pickupOptions)
                                {
                                    <option value="@opt" selected="@(Model.PickupSlot == opt)">
                                        @opt
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="Note" class="form-label fw-semibold">Ghi chú (tuỳ chọn)</label>
                            <textarea asp-for="Note" class="form-control" rows="3"
                                      placeholder="Ví dụ: Tôi sẽ đến sau 15h, vui lòng chuẩn bị nhanh giúp."></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger w-100"
                        @(Model.StockErrors.Any() ? "disabled" : "")>
                            Xác nhận &amp; Thanh toán
                        </button>
                        @if (Model.StockErrors.Any())
                        {
                            <div class="text-muted small mt-2">
                                Vui lòng điều chỉnh số lượng trong giỏ để phù hợp tồn kho trước khi thanh toán.
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>