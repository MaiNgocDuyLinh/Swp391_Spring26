@model Group3_SWP391_PetMedical.ViewModels.Retail.CheckoutVm
@{
    ViewData["Title"] = "Xác nhận đơn thuốc";
    var pickupOptions = new[] { "8h-12h", "14h-18h" };
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:18px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--primary:disabled { opacity: 0.6; cursor: not-allowed; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        
        .pc-table { border-radius:16px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-table thead th { background:#fff7f7; font-weight:800; }
        .pc-table td { vertical-align: middle; }
    </style>
}

<section class="container py-4" id="checkoutArea">
    <div class="pc-wrap" style="margin-top:150px;">
        <h3 class="pc-title mb-3">Xác nhận đơn thuốc</h3>

        @if (Model.StockErrors != null && Model.StockErrors.Any())
        {
            <div class="alert alert-warning" style="border-radius:14px;">
                <strong><i class="fas fa-exclamation-triangle"></i> Kho không đủ:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var e in Model.StockErrors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <div class="row g-4 mt-1">
            <div class="col-lg-8">
                <div class="pc-filter" style="margin-top:0;">
                    <div class="mb-3">
                        <h5 style="font-weight:800; margin:0;">Thuốc đã chọn</h5>
                    </div>
                    
                    <div class="pc-table table-responsive">
                        <table class="table align-middle m-0">
                            <thead>
                                <tr>
                                    <th>Tên thuốc</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.medicine_name</div>
                                            <div class="text-muted small">Mã: @item.medicine_id</div>
                                        </td>
                                        <td class="text-end">@item.unit_price.ToString("N0") đ</td>
                                        <td class="text-center">@item.quantity</td>
                                        <td class="text-end fw-semibold" style="color:var(--pc-red);">
                                            @item.line_total.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                        <span class="fw-semibold">Tổng:</span>
                        <span style="font-weight:800; font-size:1.35rem; color:var(--pc-red);">
                            @Model.TotalAmount.ToString("N0") đ
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="pc-filter" style="margin-top:0;">
                    <h5 style="font-weight:800; margin-bottom:16px;">Thông tin lấy thuốc</h5>
                    
                    <form asp-controller="Checkout" asp-action="Confirm" method="post">
                        @Html.AntiForgeryToken()

                        @* giữ lại danh sách thuốc đã chọn *@
                        @for (int i = 0; i < Model.SelectedMedicineIds.Length; i++)
                        {
                            <input type="hidden" name="SelectedMedicineIds[@i]" value="@Model.SelectedMedicineIds[i]" />
                        }

                        <div class="mb-3">
                            <label for="PickupDate" class="form-label" style="font-weight:700; font-size:0.9rem;">Ngày dự kiến đến lấy</label>
                            <input type="date" asp-for="PickupDate" class="form-control pc-input" 
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" 
                                   value="@(Model.PickupDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="mb-3">
                            <label for="PickupSlot" class="form-label" style="font-weight:700; font-size:0.9rem;">Khung giờ lấy thuốc</label>
                            <select asp-for="PickupSlot" class="form-select pc-input">
                                <option value="">-- Chọn khung giờ --</option>
                                @foreach (var opt in pickupOptions)
                                {
                                    <option value="@opt" selected="@(Model.PickupSlot == opt)">
                                        @opt
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" style="font-weight:700; font-size:0.9rem;">Phương thức thanh toán</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check p-3" style="border: 2px solid #f3d7d5; border-radius: 12px; cursor: pointer;">
                                    <input class="form-check-input" type="radio" value="ONLINE" asp-for="PaymentMethod" id="payOnline" checked>
                                    <label class="form-check-label fw-bold d-flex align-items-center gap-2" for="payOnline">
                                        <i class="fas fa-credit-card text-danger"></i> Thanh toán Online (PayOS)
                                    </label>
                                </div>
                                <div class="form-check p-3" style="border: 2px solid #f3d7d5; border-radius: 12px; cursor: pointer;">
                                    <input class="form-check-input" type="radio" value="COUNTER" asp-for="PaymentMethod" id="payCounter">
                                    <label class="form-check-label fw-bold d-flex align-items-center gap-2" for="payCounter">
                                        <i class="fas fa-store text-danger"></i> Thanh toán tại cửa hàng
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="Note" class="form-label" style="font-weight:700; font-size:0.9rem;">Ghi chú (tuỳ chọn)</label>
                            <textarea asp-for="Note" class="form-control" rows="3" style="border-radius:12px; padding:12px;"
                                      placeholder="Ví dụ: Tôi sẽ đến sau 15h, vui lòng chuẩn bị nhanh giúp."></textarea>
                        </div>

                        <button type="submit" class="pc-btn pc-btn--primary w-100"
                        @(Model.StockErrors.Any() ? "disabled" : "")>
                            <i class="fas fa-check-circle"></i> Xác nhận
                        </button>
                        @if (Model.StockErrors.Any())
                        {
                            <div class="text-muted small mt-2">
                                Vui lòng điều chỉnh số lượng trong giỏ để phù hợp tồn kho trước khi thanh toán.
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>