@model Group3_SWP391_PetMedical.ViewModels.Retail.CheckoutOrderVm
@{
    ViewData["Title"] = "Thanh toán đơn thuốc";
}

<section class="container" style="margin-top:140px;">
    <h3 class="mb-3">Thanh toán đơn thuốc #@Model.OrderId</h3>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Chi tiết đơn hàng</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Tên thuốc</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.medicine_name</td>
                                        <td class="text-end">@item.unit_price.ToString("N0") đ</td>
                                        <td class="text-center">@item.quantity</td>
                                        <td class="text-end">@item.line_total.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span class="fw-semibold">Tổng:</span>
                        <span class="fw-bold text-danger" style="font-size:1.2rem;">
                            @Model.TotalAmount.ToString("N0") đ
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.PickupSlot))
                    {
                        <div class="mt-2 text-muted">
                            <strong>Khung giờ lấy:</strong> @Model.PickupSlot
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="mt-1 text-muted">
                            <strong>Ghi chú:</strong> @Model.Note
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Quét mã VietQR</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Sử dụng ứng dụng ngân hàng để quét mã.
                        Nội dung chuyển khoản sẽ có dạng <strong>PET@Model.OrderId</strong>.
                    </p>
                    <img src="@Model.QrImageUrl" alt="VietQR" class="img-fluid mb-3" />
                    <div class="text-muted small">
                        Sau khi thanh toán thành công, hệ thống sẽ tự động cập nhật trạng thái đơn hàng.
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
@section Scripts {
    <script>
        // Cứ mỗi 3 giây (3000ms), trình duyệt sẽ âm thầm hỏi Server 1 lần
        const timer = setInterval(function () {
            fetch(`/Checkout/CheckOrderStatus/@Model.OrderId`)
                .then(response => response.json())
                .then(data => {
                    // Nếu thấy Server báo đã PAID (Webhook đã xử lý xong)
                    if (data.status === 'PAID') {
                        clearInterval(timer); // Dừng việc hỏi thăm lại
                        // Tự động điều hướng sang trang Success
                        window.location.href = '/api/payment/success';
                    }
                })
                .catch(err => console.error("Lỗi khi kiểm tra trạng thái:", err));
        }, 3000);
    </script>
}