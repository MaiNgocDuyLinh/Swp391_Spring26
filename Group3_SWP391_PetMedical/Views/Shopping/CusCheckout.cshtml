@model Group3_SWP391_PetMedical.ViewModels.Shopping.CusCheckoutVM

@{
    ViewData["Title"] = "Thanh toán";
}

<style>
    .pc-hero {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        background: linear-gradient(90deg, rgba(255, 216, 216, 0.75) 0%, rgba(255,255,255,0.92) 55%, rgba(255,255,255,0.95) 100%);
        box-shadow: 0 12px 30px rgba(0,0,0,.06);
        padding: 32px;
    }

        .pc-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(0,0,0,.04) 1px, transparent 1px);
            background-size: 18px 18px;
            opacity: .35;
            pointer-events: none;
        }

    .pc-hero-inner {
        position: relative;
        z-index: 1;
    }

    .pc-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(0,0,0,.06);
        font-weight: 600;
    }

    .pc-title {
        font-size: 44px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 14px 0 8px;
        color: #111;
    }

    .pc-sub {
        color: rgba(0,0,0,.62);
        max-width: 560px;
        margin-bottom: 18px;
        line-height: 1.6;
    }

    .pc-card {
        border-radius: 22px;
        border: 1px solid rgba(0,0,0,.06);
        box-shadow: 0 12px 30px rgba(0,0,0,.07);
        overflow: hidden;
        background: #fff;
        height: 100%;
    }

    .pc-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid rgba(0,0,0,.06);
        background: rgba(255, 246, 246, .7);
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .pc-card-body {
        padding: 20px;
    }

    .pc-field label,
    .pc-field .form-label {
        font-weight: 700;
        margin-bottom: 8px;
        display: block;
    }

    .pc-input,
    .pc-select,
    .pc-textarea,
    .pc-equal-control {
        width: 100% !important;
        border-radius: 16px !important;
        border: 1px solid rgba(0,0,0,.10) !important;
        box-shadow: none !important;
        background-color: #fff !important;
        font-size: 15px !important;
    }

    .pc-input,
    .pc-select,
    .pc-equal-control {
        height: 50px !important;
        padding: 0 16px !important;
    }

    .pc-textarea {
        padding: 14px 16px !important;
        min-height: 120px;
        resize: vertical;
    }

        .pc-input:focus,
        .pc-select:focus,
        .pc-textarea:focus,
        .pc-equal-control:focus {
            outline: none !important;
            border-color: #ff3b3b !important;
            box-shadow: none !important;
        }

    .pc-btn-primary {
        border: 0;
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 800;
        background: #ff2e2e;
        color: #fff;
        box-shadow: 0 10px 18px rgba(255,46,46,.20);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none !important;
    }

        .pc-btn-primary:hover {
            filter: brightness(.95);
            color: #fff;
        }

    .pc-btn-ghost {
        border-radius: 999px;
        padding: 12px 16px;
        font-weight: 800;
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
        color: #111 !important;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .pc-btn-ghost:hover {
            border-color: rgba(255, 46, 46, .35);
            color: #111 !important;
        }

    .pc-note {
        font-size: 13px;
        color: rgba(0,0,0,.55);
        margin-top: 10px;
    }

    .pc-order-box {
        border-radius: 24px;
        min-height: 100%;
        background: radial-gradient(circle at 20% 30%, rgba(255, 46, 46, .12), transparent 55%), radial-gradient(circle at 70% 60%, rgba(0, 0, 0, .06), transparent 60%), linear-gradient(135deg, rgba(255,255,255,.75), rgba(255,255,255,.35));
        border: 1px solid rgba(0,0,0,.06);
        position: relative;
        overflow: hidden;
    }

        .pc-order-box::after {
            content: "";
            position: absolute;
            right: -80px;
            bottom: -80px;
            width: 220px;
            height: 220px;
            background: rgba(255,46,46,.12);
            border-radius: 999px;
            filter: blur(2px);
        }

    .pc-order-inner {
        position: relative;
        z-index: 1;
        padding: 18px;
        height: 100%;
    }

    .pc-order-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 12px;
    }

    .pc-order-item {
        background: rgba(255,255,255,.90);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 18px;
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
    }

    .pc-order-name {
        font-weight: 800;
        color: #111;
        margin-bottom: 4px;
    }

    .pc-order-variant,
    .pc-order-qty {
        font-size: 13px;
        color: rgba(0,0,0,.58);
        line-height: 1.5;
    }

    .pc-order-price {
        font-weight: 900;
        color: #111;
        white-space: nowrap;
    }

    .pc-total-box {
        margin-top: 14px;
        border-radius: 18px;
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(0,0,0,.06);
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        font-weight: 800;
    }

    .pc-total-money {
        color: #ff2e2e;
        font-size: 20px;
        font-weight: 900;
    }

    .pc-pickup-box {
        margin-top: 12px;
        border-radius: 18px;
        background: rgba(255,255,255,.86);
        border: 1px solid rgba(0,0,0,.06);
        padding: 14px 16px;
    }

    .pc-pickup-title {
        font-weight: 800;
        margin-bottom: 6px;
        color: #111;
    }

    .pc-pickup-sub {
        color: rgba(0,0,0,.60);
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
    }

    .pc-actions-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 18px;
    }

    .pc-empty-order {
        background: rgba(255,255,255,.88);
        border: 1px dashed rgba(0,0,0,.10);
        border-radius: 18px;
        padding: 18px;
        text-align: center;
        color: rgba(0,0,0,.60);
        font-weight: 600;
    }

    @@media (max-width: 991.98px) {
        .pc-title {
            font-size: 36px;
        }
    }

    @@media (max-width: 767.98px) {
        .pc-hero {
            padding: 18px;
            border-radius: 20px;
        }

        .pc-title {
            font-size: 30px;
        }

        .pc-actions-row {
            flex-direction: column;
        }

            .pc-actions-row .pc-btn-primary,
            .pc-actions-row .pc-btn-ghost {
                width: 100%;
            }

        .pc-order-item {
            flex-direction: column;
        }

        .pc-order-price {
            white-space: normal;
        }
    }
</style>

<div class="container my-4">
    <div class="pc-hero" style="margin-top:150px;">
        <div class="pc-hero-inner">
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-7">
                    <div class="pc-badge">
                        <i class="fas fa-credit-card"></i>
                        <span>Thanh toán • PetCare</span>
                    </div>

                    <div class="pc-title">Thanh toán đơn hàng</div>
                    <div class="pc-sub">
                        Kiểm tra lại phương thức thanh toán, thời gian nhận mong muốn và ghi chú trước khi xác nhận đặt hàng.
                        Đơn hàng sẽ được tạo với trạng thái <b>Chờ xác nhận</b>.
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="pc-card">
                        <div class="pc-card-header">
                            <span>Thông tin nhận hàng</span>
                        </div>

                        <div class="pc-card-body">
                            <form asp-controller="CusShopping" asp-action="Checkout" method="post">
                                @Html.AntiForgeryToken()

                                @if (Model.SelectedCartItemIds != null && Model.SelectedCartItemIds.Any())
                                {
                                    foreach (var id in Model.SelectedCartItemIds)
                                    {
                                        <input type="hidden" name="SelectedCartItemIds" value="@id" />
                                    }
                                }

                                <div class="row g-3">
                                    <div class="col-12 pc-field">
                                        <label class="form-label">Phương thức thanh toán</label>
                                        <select name="PaymentMethod" class="form-control pc-equal-control">
                                            <option value="Tiền mặt" selected="@(Model.PaymentMethod == "Tiền mặt")">Tiền mặt</option>
                                            <option value="Chuyển khoản" selected="@(Model.PaymentMethod == "Chuyển khoản")">Chuyển khoản</option>
                                        </select>
                                    </div>

                                    <div class="col-12 pc-field">
                                        <label class="form-label">Ngày nhận mong muốn</label>
                                        <input type="datetime-local"
                                               name="PickupDate"
                                               value="@(Model.PickupDate.HasValue? Model.PickupDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                                               class="form-control pc-equal-control" />
                                        <div class="pc-note">
                                            Bạn có thể bỏ trống nếu không có yêu cầu thời gian cụ thể.
                                        </div>
                                    </div>

                                    <div class="col-12 pc-field">
                                        <label class="form-label">Ghi chú</label>
                                        <textarea name="PickupNote"
                                                  class="form-control pc-textarea"
                                                  rows="4"
                                                  placeholder="Lưu ý thêm cho phòng khám...">@Model.PickupNote</textarea>
                                    </div>
                                </div>

                                <div class="pc-actions-row">
                                    <button type="submit" class="pc-btn-primary">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Xác nhận đặt hàng</span>
                                    </button>

                                    <a href="@Url.Action("Cart", "CusShopping")" class="pc-btn-ghost">
                                        <i class="fas fa-arrow-left"></i>
                                        <span>Quay lại giỏ hàng</span>
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="pc-order-box h-100">
                        <div class="pc-order-inner">
                            <div class="pc-badge">
                                <i class="fas fa-receipt"></i>
                                <span>Đơn hàng của bạn</span>
                            </div>

                            @if (Model.Items != null && Model.Items.Any())
                            {
                                <div class="pc-order-list">
                                    @foreach (var item in Model.Items)
                                    {
                                        <div class="pc-order-item">
                                            <div>
                                                <div class="pc-order-name">@item.ProductName</div>

                                                @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                                {
                                                    <div class="pc-order-variant">@item.VariantName</div>
                                                }

                                                <div class="pc-order-qty">Số lượng: @item.Quantity</div>
                                            </div>

                                            <div class="pc-order-price">
                                                @item.LineTotal.ToString("N0") đ
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="pc-total-box">
                                    <div>Tổng cộng</div>
                                    <div class="pc-total-money">@Model.SubTotal.ToString("N0") đ</div>
                                </div>

                                <div class="pc-pickup-box">
                                    <div class="pc-pickup-title">Hình thức nhận hàng</div>
                                    <p class="pc-pickup-sub">
                                        Nhận tại phòng khám. Vui lòng đến đúng thời gian hẹn hoặc ghi chú thêm nếu cần hỗ trợ trước.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="pc-empty-order mt-3">
                                    Chưa có sản phẩm nào trong đơn hàng.
                                </div>

                                <div class="pc-actions-row">
                                    <a href="@Url.Action("Cart", "CusShopping")" class="pc-btn-ghost">
                                        <i class="fas fa-shopping-cart"></i>
                                        <span>Quay lại giỏ hàng</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>