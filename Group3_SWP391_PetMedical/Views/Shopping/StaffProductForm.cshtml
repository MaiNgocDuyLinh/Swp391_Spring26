@model Group3_SWP391_PetMedical.ViewModels.Shopping.StaffShoppingUpsertVM

@{
    var isEdit = Model.ProductId.HasValue;
    var action = isEdit ? "Edit" : "Create";
    ViewData["Title"] = isEdit ? "Chỉnh sửa sản phẩm" : "Thêm sản phẩm";
}

<style>
    .staff-form-page {
        padding-top: 140px;
    }

    .staff-form-frame {
        background: #fff;
        border: 1px solid #eef0f4;
        border-radius: 26px;
        padding: 40px 32px;
        box-shadow: 0 18px 40px rgba(0,0,0,.06);
    }

    .staff-form-title {
        text-align: center;
        font-size: 42px;
        font-weight: 900;
        color: #0b1c39;
        margin-bottom: 26px;
    }

    .staff-card {
        background: #fffaf7;
        border: 1px solid rgba(255,61,28,.10);
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 20px;
    }

    .staff-label {
        font-weight: 800;
        color: #0b1c39;
        margin-bottom: 8px;
    }

    .staff-input, .staff-select, .staff-textarea {
        border-radius: 14px;
        border: 1px solid #e8edf3;
        min-height: 48px;
    }

    .staff-textarea {
        min-height: 120px;
    }

    .variant-box {
        background: #fff;
        border: 1px dashed #ced8e5;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .staff-btn-main {
        height: 50px;
        border-radius: 999px;
        padding: 0 22px;
        border: 0;
        background: #ff3d1c;
        color: #fff;
        font-weight: 800;
    }

    .staff-btn-sub {
        height: 50px;
        border-radius: 999px;
        padding: 0 22px;
        border: 0;
        background: #5aa9ff;
        color: #fff;
        font-weight: 800;
    }
</style>

<section class="services-area section-padding40 staff-form-page">
    <div class="container">
        <div class="staff-form-frame">
            <h1 class="staff-form-title">@ViewData["Title"]</h1>

            <form asp-controller="StaffShopping" asp-action="@action" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ProductId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="staff-card">
                    <h4 class="mb-3">Thông tin sản phẩm</h4>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="staff-label"></label>
                            <input asp-for="Name" class="form-control staff-input" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="staff-label">Danh mục</label>
                            <select asp-for="CategoryId" class="form-select staff-select">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SKU" class="staff-label"></label>
                            <input asp-for="SKU" class="form-control staff-input" />
                            <span asp-validation-for="SKU" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="staff-label">Trạng thái</label>
                            <select asp-for="Status" class="form-select staff-select">
                                <option value="Đang bán">Đang bán</option>
                                <option value="Dừng bán">Dừng bán</option>
                                <option value="Hết hàng">Hết hàng</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="staff-label">Giá</label>
                            <input asp-for="Price" class="form-control staff-input" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="staff-label">Tồn kho</label>
                            <input asp-for="StockQuantity" class="form-control staff-input" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="ImageUrl" class="staff-label">Ảnh sản phẩm</label>
                            <input asp-for="ImageUrl" class="form-control staff-input" />
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Description" class="staff-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control staff-textarea"></textarea>
                        </div>
                    </div>
                </div>

                <div class="staff-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Biến thể sản phẩm</h4>
                        <button type="button" class="staff-btn-sub" onclick="addVariantRow()">
                            <i class="fas fa-plus me-2"></i> Thêm biến thể
                        </button>
                    </div>

                    <div id="variantContainer">
                        @for (int i = 0; i < Model.Variants.Count; i++)
                        {
                            <div class="variant-box">
                                <input type="hidden" name="Variants[@i].VariantId" value="@Model.Variants[i].VariantId" />

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Tên biến thể</label>
                                        <input name="Variants[@i].VariantName" value="@Model.Variants[i].VariantName" class="form-control staff-input" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Màu</label>
                                        <input name="Variants[@i].Color" value="@Model.Variants[i].Color" class="form-control staff-input" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Kích thước</label>
                                        <input name="Variants[@i].Size" value="@Model.Variants[i].Size" class="form-control staff-input" />
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Chất liệu</label>
                                        <input name="Variants[@i].Material" value="@Model.Variants[i].Material" class="form-control staff-input" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">SKU biến thể</label>
                                        <input name="Variants[@i].SKU" value="@Model.Variants[i].SKU" class="form-control staff-input" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Giá override</label>
                                        <input name="Variants[@i].PriceOverride" value="@Model.Variants[i].PriceOverride" class="form-control staff-input" />
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Tồn kho</label>
                                        <input name="Variants[@i].StockQuantity" value="@Model.Variants[i].StockQuantity" class="form-control staff-input" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Trạng thái</label>
                                        <select name="Variants[@i].Status" class="form-select staff-select">
                                            <option value="Đang bán" selected="@(Model.Variants[i].Status == "Đang bán")">Đang bán</option>
                                            <option value="Dừng bán" selected="@(Model.Variants[i].Status == "Dừng bán")">Dừng bán</option>
                                            <option value="Hết hàng" selected="@(Model.Variants[i].Status == "Hết hàng")">Hết hàng</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="staff-label">Ảnh biến thể</label>
                                        <input name="Variants[@i].ImageUrl" value="@Model.Variants[i].ImageUrl" class="form-control staff-input" />
                                    </div>
                                </div>

                                <button type="button" class="btn btn-outline-danger rounded-pill" onclick="removeVariantRow(this)">
                                    <i class="fas fa-trash me-1"></i> Bỏ biến thể này
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="staff-btn-main">
                        <i class="fas fa-save me-2"></i> Lưu sản phẩm
                    </button>
                    <a href="@Url.Action("Index", "StaffShopping")" class="staff-btn-sub text-decoration-none">
                        <i class="fas fa-arrow-left me-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function removeVariantRow(button) {
            const box = button.closest('.variant-box');
            box.remove();
            reIndexVariants();
        }

        function addVariantRow() {
            const container = document.getElementById('variantContainer');
            const index = container.querySelectorAll('.variant-box').length;

            const html = `
                <div class="variant-box">
                    <input type="hidden" name="Variants[${index}].VariantId" value="" />
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Tên biến thể</label>
                            <input name="Variants[${index}].VariantName" class="form-control staff-input" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Màu</label>
                            <input name="Variants[${index}].Color" class="form-control staff-input" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Kích thước</label>
                            <input name="Variants[${index}].Size" class="form-control staff-input" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Chất liệu</label>
                            <input name="Variants[${index}].Material" class="form-control staff-input" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">SKU biến thể</label>
                            <input name="Variants[${index}].SKU" class="form-control staff-input" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Giá override</label>
                            <input name="Variants[${index}].PriceOverride" class="form-control staff-input" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Tồn kho</label>
                            <input name="Variants[${index}].StockQuantity" value="0" class="form-control staff-input" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Trạng thái</label>
                            <select name="Variants[${index}].Status" class="form-select staff-select">
                                <option value="Đang bán">Đang bán</option>
                                <option value="Dừng bán">Dừng bán</option>
                                <option value="Hết hàng">Hết hàng</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="staff-label">Ảnh biến thể</label>
                            <input name="Variants[${index}].ImageUrl" class="form-control staff-input" />
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-danger rounded-pill" onclick="removeVariantRow(this)">
                        <i class="fas fa-trash me-1"></i> Bỏ biến thể này
                    </button>
                </div>`;

            container.insertAdjacentHTML('beforeend', html);
        }

        function reIndexVariants() {
            const boxes = document.querySelectorAll('#variantContainer .variant-box');

            boxes.forEach((box, index) => {
                const fields = box.querySelectorAll('input, select, textarea');
                fields.forEach(field => {
                    if (!field.name) return;
                    field.name = field.name.replace(/Variants\[\d+\]/g, `Variants[${index}]`);
                });
            });
        }
    </script>
}