@using Group3_SWP391_PetMedical.ViewModels.Shopping
@model StaffShoppingOrdersVM

@{
    ViewData["Title"] = "Đơn hàng khách hàng";

    var totalOrders = Model?.Result?.TotalItems ?? 0;
    var currentPage = Model?.Result?.Page ?? 1;
    var pageSize = Model?.Result?.PageSize ?? 6;
    var totalPages = totalOrders > 0 ? (int)Math.Ceiling((double)totalOrders / pageSize) : 1;

    var hasFilter =
        !string.IsNullOrWhiteSpace(Model?.Query?.Keyword) ||
        !string.IsNullOrWhiteSpace(Model?.Query?.OrderStatus) ||
        !string.IsNullOrWhiteSpace(Model?.Query?.PaymentStatus);

    Func<int, string> pageUrl = p =>
        (Url.Action("Orders", "StaffShopping", new
        {
            Keyword = Model.Query.Keyword,
            OrderStatus = Model.Query.OrderStatus,
            PaymentStatus = Model.Query.PaymentStatus,
            Page = p,
            PageSize = Model.Result.PageSize
        }) ?? "#") + "#staffOrdersArea";

    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
}

@functions {
    public static string NormalizeText(string? value)
    {
        return (value ?? "").Trim().ToLower();
    }

    public static string GetOrderStatusClass(string? status)
    {
        var s = NormalizeText(status);

        return s switch
        {
            "đặt hàng thành công" => "pc-badge--warning",
            "đã nhận hàng" => "pc-badge--success",
            "đã hủy" => "pc-badge--danger",
            _ => "pc-badge--default"
        };
    }

    public static string GetPaymentStatusClass(string? status)
    {
        var s = NormalizeText(status);

        return s switch
        {
            "đã thanh toán" => "pc-badge--paid",
            "chưa thanh toán" => "pc-badge--danger",
            _ => "pc-badge--default"
        };
    }

    public static string GetOrderStatusIcon(string? status)
    {
        var s = NormalizeText(status);

        return s switch
        {
            "đặt hàng thành công" => "fas fa-check-circle",
            "đã nhận hàng" => "fas fa-box-open",
            "đã hủy" => "fas fa-times-circle",
            _ => "fas fa-info-circle"
        };
    }

    public static string GetPaymentStatusIcon(string? status)
    {
        var s = NormalizeText(status);

        return s switch
        {
            "đã thanh toán" => "fas fa-wallet",
            "chưa thanh toán" => "fas fa-credit-card",
            _ => "fas fa-money-check-alt"
        };
    }
}

<style>
    :root {
        --pc-red: #ff3b3b;
        --pc-red-dark: #e83434;
        --pc-pink: #fff2f2;
        --pc-text: #2b2b2b;
        --pc-muted: #7a7a7a;
        --pc-border: rgba(0,0,0,0.06);
        --pc-success-bg: #e8f5e9;
        --pc-success-text: #2e7d32;
        --pc-info-bg: #e0f2fe;
        --pc-info-text: #0369a1;
        --pc-warning-bg: #fff3cd;
        --pc-warning-text: #856404;
        --pc-danger-bg: #fdeaea;
        --pc-danger-text: #c62828;
        --pc-default-bg: #f3f4f6;
        --pc-default-text: #6b7280;
    }

    .stafforder-page {
        padding-top: 150px;
        padding-bottom: 32px;
    }

    .pc-wrap {
        background: #f3d7d5;
        border: 1px solid var(--pc-border);
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.06);
    }

    .pc-topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .pc-title {
        font-weight: 800;
        margin: 0;
        color: var(--pc-text);
    }

    .pc-sub {
        color: var(--pc-muted);
        margin: 0;
    }

    .pc-filter {
        background: #fff;
        border: 1px solid var(--pc-border);
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.04);
    }

    .pc-label {
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 6px;
        color: var(--pc-text);
    }

    .pc-input {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.10);
        min-height: 42px;
        padding: 0 12px;
        box-shadow: none !important;
    }

    .pc-select {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.10);
        min-height: 42px;
        box-shadow: none !important;
    }

        .pc-input:focus,
        .pc-select:focus {
            border-color: rgba(255,59,59,0.35);
            box-shadow: 0 0 0 0.2rem rgba(255,59,59,0.12) !important;
        }

    .pc-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        width: 100%;
    }

    .pc-btn {
        border-radius: 999px;
        padding: 0 18px;
        height: 42px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        text-decoration: none !important;
        white-space: nowrap;
    }

    .pc-btn--primary {
        background: var(--pc-red);
        color: #fff !important;
        box-shadow: 0 10px 20px rgba(255,59,59,0.25);
    }

        .pc-btn--primary:hover {
            background: var(--pc-red-dark);
            color: #fff !important;
        }

    .pc-btn--ghost {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.10);
        color: var(--pc-text) !important;
        box-shadow: 0 8px 18px rgba(0,0,0,0.04);
    }

        .pc-btn--ghost:hover {
            border-color: rgba(255,59,59,0.35);
            box-shadow: 0 10px 22px rgba(255,59,59,0.12);
            color: var(--pc-red-dark) !important;
        }

    .pc-summary {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
        margin-bottom: 18px;
    }

    .pc-summary-card {
        background: #fff;
        border: 1px solid var(--pc-border);
        border-radius: 16px;
        padding: 16px 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.04);
    }

    .pc-summary-label {
        color: var(--pc-muted);
        font-size: 0.92rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .pc-summary-value {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--pc-text);
        line-height: 1.2;
    }

    .pc-table {
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--pc-border);
        box-shadow: 0 10px 25px rgba(0,0,0,0.04);
    }

        .pc-table .table {
            margin-bottom: 0;
        }

        .pc-table thead th {
            background: #fff7f7;
            font-weight: 800;
            color: var(--pc-text);
            border-bottom: 1px solid rgba(0,0,0,0.06);
            white-space: nowrap;
            vertical-align: middle;
        }

        .pc-table tbody tr {
            transition: background 0.25s ease;
        }

            .pc-table tbody tr:hover {
                background: #fff3f3;
            }

    .pc-code {
        font-weight: 800;
        color: var(--pc-text);
    }

    .pc-user {
        font-weight: 700;
        color: var(--pc-text);
    }

    .pc-date {
        color: var(--pc-text);
        font-weight: 600;
        white-space: nowrap;
    }

    .pc-money {
        font-weight: 900;
        color: var(--pc-text);
        white-space: nowrap;
    }

    .pc-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.85rem;
        border: 1px solid rgba(0,0,0,0.04);
        white-space: nowrap;
    }

        .pc-badge i {
            color: inherit !important;
        }

    .pc-badge--paid {
        background: #e0f2fe;
        color: #0369a1;
    }

    .pc-badge--success {
        background: var(--pc-success-bg);
        color: var(--pc-success-text);
    }

    .pc-badge--info {
        background: var(--pc-info-bg);
        color: var(--pc-info-text);
    }

    .pc-badge--warning {
        background: var(--pc-warning-bg);
        color: var(--pc-warning-text);
    }

    .pc-badge--danger {
        background: var(--pc-danger-bg);
        color: var(--pc-danger-text);
    }

    .pc-badge--default {
        background: var(--pc-default-bg);
        color: var(--pc-default-text);
    }

    .pc-action-wrap {
        display: flex;
        justify-content: flex-end;
    }

    .pc-btn-detail {
        height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(255,59,59,0.20);
        background: #fff5f5;
        color: var(--pc-red) !important;
        font-size: 0.9rem;
        font-weight: 800;
        text-decoration: none !important;
        box-shadow: 0 8px 18px rgba(0,0,0,0.04);
        white-space: nowrap;
    }

        .pc-btn-detail:hover {
            background: #ffeaea;
            color: var(--pc-red-dark) !important;
            border-color: rgba(255,59,59,0.35);
            box-shadow: 0 10px 22px rgba(255,59,59,0.12);
        }

    .pc-pager.pagination {
        gap: 10px;
        margin: 0;
    }

    .pc-pager .page-item .page-link {
        border-radius: 999px !important;
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        border: 1px solid rgba(0,0,0,0.10);
        color: var(--pc-text);
        background: #fff;
        box-shadow: 0 8px 18px rgba(0,0,0,0.04);
    }

        .pc-pager .page-item .page-link:hover {
            border-color: rgba(255,59,59,0.35);
            box-shadow: 0 10px 22px rgba(255,59,59,0.12);
            color: var(--pc-red-dark);
        }

    .pc-pager .page-item.active .page-link {
        background: var(--pc-red) !important;
        border-color: var(--pc-red) !important;
        color: #fff !important;
        box-shadow: 0 12px 24px rgba(255,59,59,0.25);
    }

    .pc-pager .page-item.disabled .page-link {
        opacity: 0.45;
        pointer-events: none;
        box-shadow: none;
    }

    .pc-empty {
        background: #fff;
        border: 1px solid var(--pc-border);
        border-radius: 16px;
        padding: 28px 20px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.04);
    }

    .pc-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #fff5f5;
        color: var(--pc-red);
        font-size: 1.5rem;
        margin-bottom: 12px;
    }

    .pc-empty-title {
        font-weight: 800;
        font-size: 1.05rem;
        color: var(--pc-text);
        margin-bottom: 6px;
    }

    .pc-empty-sub {
        color: var(--pc-muted);
        margin: 0;
    }

    @@media (max-width: 767.98px) {
        .stafforder-page {
            padding-top: 135px;
        }

        .pc-wrap {
            padding: 14px;
            border-radius: 16px;
        }

        .pc-topbar {
            flex-direction: column;
            align-items: stretch;
        }

            .pc-topbar .pc-btn {
                width: 100%;
            }

        .pc-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .pc-actions .pc-btn {
                width: 100%;
            }

        .pc-summary-value {
            font-size: 1.2rem;
        }

        .pc-pager .page-item .page-link {
            width: 38px;
            height: 38px;
        }
    }
</style>

<section class="container stafforder-page" id="staffOrdersArea">
    <div class="pc-wrap">
        <div class="pc-topbar">
            <div>
                <h3 class="pc-title">Đơn hàng khách hàng</h3>
                <p class="pc-sub">Quản lý đơn mua sắm, trạng thái xử lý và thanh toán của khách hàng</p>
            </div>

            <a href="@Url.Action("Index", "StaffShopping")" class="pc-btn pc-btn--ghost">
                <i class="fas fa-arrow-left"></i>
                <span>Quay lại sản phẩm</span>
            </a>
        </div>

        <div class="pc-filter">
            <form method="get" asp-controller="StaffShopping" asp-action="Orders" class="row g-3">
                <div class="col-lg-5 col-md-6">
                    <div class="pc-label">Tìm kiếm</div>
                    <input type="text"
                           name="Keyword"
                           value="@Model.Query.Keyword"
                           class="form-control pc-input"
                           placeholder="Tìm mã đơn / khách hàng..." />
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="pc-label">Trạng thái đơn</div>
                    <select name="OrderStatus" class="form-select pc-select">
                        <option value="">-- Trạng thái đơn --</option>
                        <option value="Đặt hàng thành công" selected="@(Model.Query.OrderStatus == "Đặt hàng thành công")">Đặt hàng thành công</option>
                        <option value="Đã nhận hàng" selected="@(Model.Query.OrderStatus == "Đã nhận hàng")">Đã nhận hàng</option>
                        <option value="Đã hủy" selected="@(Model.Query.OrderStatus == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Thanh toán</div>
                    <select name="PaymentStatus" class="form-select pc-select">
                        <option value="">-- Thanh toán --</option>
                        <option value="Chưa thanh toán" selected="@(Model.Query.PaymentStatus == "Chưa thanh toán")">Chưa thanh toán</option>
                        <option value="Đã thanh toán" selected="@(Model.Query.PaymentStatus == "Đã thanh toán")">Đã thanh toán</option>
                    </select>
                </div>

                <input type="hidden" name="Page" value="1" />
                <input type="hidden" name="PageSize" value="@Model.Result.PageSize" />

                <div class="col-lg-2 col-md-6 d-flex align-items-end">
                    <div class="pc-actions">
                        <a class="pc-btn pc-btn--ghost w-100"
                           href="@Url.Action("Orders", "StaffShopping")#staffOrdersArea">
                            <i class="fas fa-undo-alt"></i>
                            <span>Làm mới</span>
                        </a>

                        <button type="submit" class="pc-btn pc-btn--primary w-100">
                            <i class="fas fa-search"></i>
                            <span>Lọc</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="pc-summary">
            <div class="pc-summary-card">
                <div class="pc-summary-label">Tổng số đơn hàng</div>
                <div class="pc-summary-value">@totalOrders</div>
            </div>
        </div>

        @if (Model.Result != null && Model.Result.Items.Any())
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:150px;">Mã đơn</th>
                            <th style="width:180px;">Khách hàng</th>
                            <th style="width:150px;" class="text-end">Tổng tiền</th>
                            <th style="width:180px;">Thanh toán</th>
                            <th style="width:180px;">Đơn hàng</th>
                            <th style="width:180px;">Ngày tạo</th>
                            <th style="width:130px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Result.Items)
                        {
                            <tr>
                                <td>
                                    <div class="pc-code">@item.OrderCode</div>
                                </td>

                                <td>
                                    <div class="pc-user">@(string.IsNullOrWhiteSpace(item.CustomerName) ? ("User #" + item.CustomerId) : item.CustomerName)</div>
                                </td>

                                <td class="text-end">
                                    <span class="pc-money">@item.TotalAmount.ToString("N0") đ</span>
                                </td>

                                <td>
                                    <span class="pc-badge @GetPaymentStatusClass(item.PaymentStatus)">
                                        <i class="@GetPaymentStatusIcon(item.PaymentStatus)"></i>
                                        @item.PaymentStatus
                                    </span>
                                </td>

                                <td>
                                    <span class="pc-badge @GetOrderStatusClass(item.OrderStatus)">
                                        <i class="@GetOrderStatusIcon(item.OrderStatus)"></i>
                                        @item.OrderStatus
                                    </span>
                                </td>

                                <td>
                                    <div class="pc-date">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>

                                <td class="text-end">
                                    <div class="pc-action-wrap">
                                        <a class="pc-btn-detail"
                                           href="@Url.Action("OrderDetail", "StaffShopping", new { id = item.OrderId })">
                                            <i class="fas fa-eye"></i>
                                            <span>Chi tiết</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="mt-4 d-flex justify-content-center">
                    <ul class="pagination pc-pager">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@(currentPage <= 1 ? "#" : pageUrl(currentPage - 1))">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@pageUrl(i)">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(currentPage >= totalPages ? "#" : pageUrl(currentPage + 1))">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="text-center mt-2" style="color: var(--pc-muted); font-size:0.95rem;">
                    Trang <strong>@currentPage</strong> / <strong>@totalPages</strong>
                    - Tổng <strong>@totalOrders</strong> đơn hàng
                </div>
            }
        }
        else
        {
            <div class="pc-empty">
                <div class="pc-empty-icon">
                    <i class="fas fa-shopping-bag"></i>
                </div>

                @if (hasFilter)
                {
                    <div class="pc-empty-title">Không tìm thấy đơn hàng phù hợp</div>
                    <p class="pc-empty-sub">Hãy thử lại với từ khóa hoặc bộ lọc khác.</p>

                    <div class="mt-3">
                        <a href="@Url.Action("Orders", "StaffShopping")#staffOrdersArea" class="pc-btn pc-btn--primary">
                            <i class="fas fa-undo-alt"></i>
                            <span>Xem tất cả đơn hàng</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="pc-empty-title">Chưa có đơn hàng nào</div>
                    <p class="pc-empty-sub">Danh sách đơn hàng của khách sẽ hiển thị tại đây khi phát sinh giao dịch.</p>
                }
            </div>
        }
    </div>
</section>