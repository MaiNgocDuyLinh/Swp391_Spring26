@model Group3_SWP391_PetMedical.ViewModels.Shopping.CusShoppingOrderDetailVM

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container py-5 mt-5">
    <div class="mb-4">
        <a href="@Url.Action("MyOrders", "CusShopping")" class="btn btn-outline-secondary">← Quay lại đơn hàng</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h3 class="mb-0">Đơn hàng @Model.OrderCode</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-2"><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="col-md-6 mb-2"><strong>Trạng thái đơn:</strong> @Model.OrderStatus</div>
                <div class="col-md-6 mb-2"><strong>Thanh toán:</strong> @Model.PaymentStatus</div>
                <div class="col-md-6 mb-2"><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</div>
                <div class="col-md-6 mb-2"><strong>Nhận hàng:</strong> @Model.PickupMethod</div>
                <div class="col-md-6 mb-2"><strong>Ngày nhận mong muốn:</strong> @(Model.PickupDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                <div class="col-12"><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(Model.PickupNote) ? "-" : Model.PickupNote)</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h4 class="mb-0">Sản phẩm</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered bg-white">
                    <thead class="thead-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Biến thể</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.VariantName) ? "-" : item.VariantName)</td>
                                <td>@item.UnitPrice.ToString("N0") đ</td>
                                <td>@item.Quantity</td>
                                <td>@item.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-right mt-3">
                <h4>Tổng cộng: <span class="text-danger">@Model.TotalAmount.ToString("N0") đ</span></h4>
            </div>
        </div>
    </div>
</div>