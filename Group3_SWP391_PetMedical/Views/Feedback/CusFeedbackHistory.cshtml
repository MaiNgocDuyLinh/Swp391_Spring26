@using Group3_SWP391_PetMedical.Models.Common
@using Group3_SWP391_PetMedical.Services.Interfaces
@model Group3_SWP391_PetMedical.ViewModels.Feedback.CusFeedbackHistoryListVM

@inject IServiceService ServiceService

@{
    ViewData["Title"] = "Lịch sử đánh giá";

    var pagerObj = new PagedResult<object>
    {
        Items = Model.Page.Data.Items.Cast<object>().ToList(),
        Page = Model.Page.Data.Page,
        PageSize = Model.Page.Data.PageSize,
        TotalItems = Model.Page.Data.TotalItems
    };

    var fromVal = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toVal = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? "";

    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();
}

@functions {
    public static string GetShiftLabel(DateTime dt)
    {
        return dt.Hour < 12 ? "Ca sáng" : "Ca chiều";
    }

    public static string NormalizeStatus(string? status)
    {
        return (status ?? "").Trim().ToLower();
    }

    public static string GetStatusClass(string? status)
    {
        var s = NormalizeStatus(status);

        return s switch
        {
            "đã thanh toán" => "pc-badge--paid",
            "đã khám" => "pc-badge--paid",
            _ => "pc-badge--default"
        };
    }

    public static string RenderStars(int? rating)
    {
        var r = rating ?? 0;
        var full = new string('★', r);
        var empty = new string('☆', 5 - r);
        return full + empty;
    }

    public static bool CanViewMedicalRecord(string? status)
    {
        var s = NormalizeStatus(status);
        return s == "đã khám" || s == "đã thanh toán";
    }
}

@section Styles {
