@model List<Group3_SWP391_PetMedical.Models.Service>
@{
    ViewData["Title"] = "Quản lý Dịch vụ";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
    string? search = ViewBag.Search;
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:18px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-label { font-weight:700; font-size:0.9rem; margin-bottom:6px; }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-table { border-radius:16px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-table thead th { background:#fff7f7; font-weight:800; }
        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; font-weight:800; font-size:0.85rem; border:1px solid rgba(0,0,0,0.06); background:#fff; }
        .pc-badge i { color:var(--pc-red); }
        .pc-money { font-weight:900; }
        .pc-ico { width:36px; height:36px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.10); background:#fff; color:var(--pc-text); box-shadow:0 8px 18px rgba(0,0,0,0.04); text-decoration:none; cursor:pointer; }
        .pc-ico:hover { border-color:rgba(255,59,59,0.35); box-shadow:0 10px 22px rgba(255,59,59,0.12); color:var(--pc-red-dark); }
        .pc-action-icons { display:flex; justify-content:flex-end; gap:10px; }
        tbody.pc-record { transition:background 0.25s ease; }
        tbody.pc-record:hover tr { background:#fff3f3 !important; }
        .pc-pager.pagination { gap:10px; margin:0; }
        .pc-pager .page-item .page-link { border-radius:999px !important; width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center; padding:0 !important; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text); background:#fff; box-shadow:0 8px 18px rgba(0,0,0,0.04); }
        .pc-pager .page-item .page-link:hover { border-color:rgba(255,59,59,0.35); color:var(--pc-red-dark); }
        .pc-pager .page-item.active .page-link { background:var(--pc-red) !important; border-color:var(--pc-red) !important; color:#fff !important; box-shadow:0 12px 24px rgba(255,59,59,0.25); }
        .pc-pager .page-item.disabled .page-link { opacity:0.45; pointer-events:none; box-shadow:none; }
    </style>
}

<section class="container py-4" id="servicesArea">
    <div class="pc-wrap" style="margin-top:150px;">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="pc-title">Quản lý Dịch vụ</h3>
                <p class="pc-sub">Xem và quản lý danh sách dịch vụ tại phòng khám</p>
            </div>
            <a class="pc-btn pc-btn--primary" href="@Url.Action("AddService", "Manager")">
                <i class="fas fa-plus"></i> Thêm dịch vụ
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3 mb-0" style="border-radius:14px;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3 mb-0" style="border-radius:14px;">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="pc-filter">
            <form method="get" asp-controller="Manager" asp-action="ListServices" class="row g-3">
                <div class="col-lg-6 col-md-8">
                    <div class="pc-label">Từ khóa</div>
                    <input class="form-control pc-input" name="search" value="@search"
                           placeholder="Tên dịch vụ hoặc mô tả..." />
                </div>
                <div class="col-12 mt-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <a class="pc-btn pc-btn--ghost" href="@Url.Action("ListServices", "Manager")#servicesArea">
                            <i class="fas fa-undo-alt"></i> Làm mới
                        </a>
                        <button type="submit" class="pc-btn pc-btn--primary">
                            <i class="fas fa-filter"></i> Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info mb-0" style="border-radius:14px;">Chưa có dịch vụ nào.</div>
        }
        else
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Tên dịch vụ</th>
                            <th>Mô tả</th>
                            <th class="text-end" style="width:140px;">Giá (VNĐ)</th>
                            <th style="width:100px;">Thời gian</th>
                            <th style="width:80px;">Tại nhà</th>
                            <th style="width:100px;">Trạng thái</th>
                            <th style="width:80px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    @{int idx = (currentPage - 1) * 5 + 1;}
                    @foreach (var s in Model)
                    {
                        <tbody class="pc-record">
                            <tr>
                                <td>@idx</td>
                                <td><strong>@s.service_name</strong></td>
                                <td><small class="text-muted">@(s.description ?? "-")</small></td>
                                <td class="text-end">
                                    @{
                                        var disc = s.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= DateTime.Now && sd.end_date >= DateTime.Now);
                                    }
                                    @if (disc != null)
                                    {
                                        <div>
                                            <small style="text-decoration:line-through; color:var(--pc-muted);">@s.base_price.ToString("N0")</small>
                                            <span class="pc-money" style="color:var(--pc-red);">@((s.base_price * (1 - (decimal)disc.discount_percent / 100)).ToString("N0"))</span>
                                            <span style="background:#dc2626; color:#fff; padding:1px 6px; border-radius:999px; font-size:0.7rem; font-weight:800; margin-left:4px;">-@disc.discount_percent%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="pc-money">@s.base_price.ToString("N0")</span>
                                    }
                                </td>
                                <td>@(s.duration?.ToString() ?? "N/A") phút</td>
                                <td>@(s.is_home_service == true ? "Có" : "Không")</td>
                                <td>
                                    <span class="pc-badge">
                                        <i class="fas @(s.status == true ? "fa-check-circle" : "fa-times-circle")"></i>
                                        @(s.status == true ? "Hoạt động" : "Ngừng")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="pc-action-icons">
                                        <a class="pc-ico" title="Chỉnh sửa"
                                           href="@Url.Action("EditService", "Manager", new { id = s.service_id })">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="pc-ico" title="Xóa" style="color:#dc2626; border-color:rgba(220,38,38,0.2);"
                                                type="button" data-delete-id="@s.service_id" data-delete-name="@s.service_name">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                        <form id="deleteForm-@s.service_id" asp-action="DeleteService" asp-controller="Manager" method="post" style="display:none;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.service_id" />
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                        idx++;
                    }
                </table>
            </div>

            <div class="mt-3 d-flex justify-content-center">
                <ul class="pagination pc-pager">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ListServices", "Manager", new { search, page = currentPage - 1 })"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Math.Max(totalPages, 1); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("ListServices", "Manager", new { search, page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ListServices", "Manager", new { search, page = currentPage + 1 })"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </div>
            <div class="text-center mt-2" style="color:var(--pc-muted); font-size:0.95rem;">
                Tổng: <strong>@totalItems</strong> dịch vụ
            </div>
        }
    </div>
</section>

<script>
    document.querySelectorAll('[data-delete-id]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = this.getAttribute('data-delete-id');
            var name = this.getAttribute('data-delete-name');
            if (confirm('Xác nhận xóa dịch vụ "' + name + '"?')) {
                document.getElementById('deleteForm-' + id).submit();
            }
        });
    });
</script>
