@model Group3_SWP391_PetMedical.Models.Service
@{
    ViewData["Title"] = "Thiết lập Giảm giá";
    var activeDiscount = ViewBag.ActiveDiscount as Group3_SWP391_PetMedical.Models.ServiceDiscount;
    bool hasActive = activeDiscount != null;
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:24px; box-shadow:0 12px 30px rgba(0,0,0,0.06); margin-top:150px; }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-content-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:24px; box-shadow:0 10px 25px rgba(0,0,0,0.04); margin-bottom:20px; }
        .pc-section-title { font-weight:800; font-size:1.1rem; margin-bottom:15px; display:flex; align-items:center; gap:8px; color:var(--pc-text); }
        .pc-section-title i { color:var(--pc-red); }
        .pc-label { font-weight:700; font-size:0.9rem; margin-bottom:6px; }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        .pc-btn { border-radius:999px; padding:0 22px; height:44px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; transition:all 0.2s; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-btn--ghost:hover { border-color:var(--pc-red); color:var(--pc-red) !important; }
        .pc-btn--danger { background:#dc2626; color:#fff; box-shadow:0 10px 20px rgba(220,38,38,0.2); }
        .pc-btn--danger:hover { background:#b91c1c; color:#fff; }

        .pc-info-item { margin-bottom:12px; }
        .pc-info-label { font-size:0.8rem; font-weight:800; color:var(--pc-muted); text-transform:uppercase; margin-bottom:2px; }
        .pc-info-value { font-weight:600; font-size:0.95rem; color:var(--pc-text); }

        .preview-box { background:#fffbeb; border:2px dashed #f59e0b; border-radius:14px; padding:20px; text-align:center; }
        .preview-price-old { font-size:1.2rem; text-decoration:line-through; color:var(--pc-muted); }
        .preview-arrow { font-size:1.5rem; color:#f59e0b; margin:0 12px; }
        .preview-price-new { font-size:1.5rem; font-weight:900; color:var(--pc-red); }

        .active-discount-box { background:#dcfce7; border:1px solid #bbf7d0; border-radius:14px; padding:20px; }
    </style>
}

<div class="container py-4">
    <div class="pc-wrap">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h3 class="pc-title">Thiết lập Giảm giá</h3>
                <p class="pc-sub">Dịch vụ: <strong>@Model.service_name</strong></p>
            </div>
            <a href="@Url.Action("DiscountList", "Manager")#servicesArea" class="pc-btn pc-btn--ghost">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-3" style="border-radius:14px;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mb-3" style="border-radius:14px;">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="row">
            <!-- Cột trái: Thông tin dịch vụ + Giảm giá hiện tại -->
            <div class="col-lg-5">
                <div class="pc-content-card">
                    <div class="pc-section-title"><i class="fas fa-info-circle"></i> Thông tin dịch vụ</div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Tên dịch vụ</div>
                        <div class="pc-info-value">@Model.service_name</div>
                    </div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Giá gốc</div>
                        <div class="pc-info-value" style="color:var(--pc-red); font-size:1.1rem;">@Model.base_price.ToString("N0") VNĐ</div>
                    </div>
                    <div class="pc-info-item">
                        <div class="pc-info-label">Thời gian thực hiện</div>
                        <div class="pc-info-value">@(Model.duration?.ToString() ?? "N/A") phút</div>
                    </div>
                </div>

                @if (hasActive)
                {
                    <div class="active-discount-box">
                        <div class="pc-section-title" style="color:#15803d;"><i class="fas fa-check-circle" style="color:#15803d;"></i> Giảm giá đang hoạt động</div>
                        <div class="pc-info-item">
                            <div class="pc-info-label">Mức giảm</div>
                            <div class="pc-info-value" style="font-size:1.2rem; color:#dc2626;">-@activeDiscount!.discount_percent%</div>
                        </div>
                        <div class="pc-info-item">
                            <div class="pc-info-label">Giá sau giảm</div>
                            <div class="pc-info-value" style="font-size:1.1rem; color:#15803d;">
                                @((Model.base_price * (1 - (decimal)activeDiscount.discount_percent / 100)).ToString("N0")) VNĐ
                            </div>
                        </div>
                        <div class="pc-info-item">
                                <div class="pc-info-label">Thời hạn</div>
                            <div class="pc-info-value">@activeDiscount.start_date.ToString("dd/MM/yyyy HH:mm") - @activeDiscount.end_date.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <form asp-controller="Manager" asp-action="RemoveDiscount" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="discountId" value="@activeDiscount.discount_id" />
                            <button type="submit" class="pc-btn pc-btn--danger w-100"
                                    onclick="return confirm('Bạn có chắc muốn hủy giảm giá này không?')">
                                <i class="fas fa-times-circle"></i> Hủy giảm giá
                            </button>
                        </form>
                    </div>
                }
            </div>

            <!-- Cột phải: Form thiết lập giảm giá mới -->
            <div class="col-lg-7">
                <div class="pc-content-card">
                    <div class="pc-section-title">
                        <i class="fas fa-tag"></i>
                        @(hasActive ? "Thay đổi giảm giá" : "Thiết lập giảm giá mới")
                    </div>

                    <form asp-controller="Manager" asp-action="ApplyDiscount" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="serviceId" value="@Model.service_id" />

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="pc-label">Phần trăm giảm giá (%)</div>
                                <input type="number" class="form-control pc-input" name="discountPercent"
                                       id="discountPercent" min="1" max="100" required
                                       placeholder="VD: 10, 20, 30..."
                                       value="@(hasActive ? activeDiscount!.discount_percent : "")"
                                       oninput="updatePreview()" />
                            </div>
                            <div class="col-md-6">
                                    <div class="pc-label">Ngày bắt đầu</div>
                                <input type="datetime-local" class="form-control pc-input" name="startDate"
                                       id="startDate" required
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                       value="@(hasActive ? activeDiscount!.start_date.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>
                            <div class="col-md-6">
                                <div class="pc-label">Ngày kết thúc</div>
                                <input type="datetime-local" class="form-control pc-input" name="endDate"
                                       id="endDate" required
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                       value="@(hasActive ? activeDiscount!.end_date.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>
                        </div>

                        <!-- Preview -->
                        <div class="preview-box mt-4" id="previewBox">
                            <div style="font-weight:800; margin-bottom:10px; color:#92400e;">
                                <i class="fas fa-eye"></i> Xem trước giá
                            </div>
                            <div class="d-flex align-items-center justify-content-center flex-wrap gap-2">
                                <span class="preview-price-old" id="previewOld">@Model.base_price.ToString("N0") đ</span>
                                <span class="preview-arrow"><i class="fas fa-arrow-right"></i></span>
                                <span class="preview-price-new" id="previewNew">@Model.base_price.ToString("N0") đ</span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex gap-3">
                            <a href="@Url.Action("DiscountList", "Manager")" class="pc-btn pc-btn--ghost flex-fill">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="pc-btn pc-btn--primary flex-fill">
                                <i class="fas fa-check"></i> Áp dụng giảm giá
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var basePrice = @Model.base_price;

    function updatePreview() {
        var percent = parseInt(document.getElementById('discountPercent').value) || 0;
        if (percent < 0) percent = 0;
        if (percent > 100) percent = 100;

        var newPrice = basePrice * (1 - percent / 100);
        document.getElementById('previewNew').textContent = newPrice.toLocaleString('vi-VN') + ' đ';
    }

    // Initialize preview on page load
    updatePreview();
</script>
