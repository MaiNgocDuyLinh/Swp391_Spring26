@model Group3_SWP391_PetMedical.Models.Appointment
@using Group3_SWP391_PetMedical.Models
@using Group3_SWP391_PetMedical.Services.Interfaces
@inject IServiceService ServiceService
@{
    ViewData["Title"] = "Chi tiết Lịch hẹn";
    var doctors = ViewBag.Doctors as List<User> ?? new List<User>();

    // Status color mapping
    (string bg, string color, string icon) StatusStyle(string? s) => (s ?? "").Trim().ToLower() switch {
        "đặt lịch thành công" => ("#d1fae5", "#047857", "fa-check-circle"),
        "đã thanh toán"       => ("#dbeafe", "#1d4ed8", "fa-file-invoice-dollar"),
        "đã hủy"              => ("#fee2e2", "#dc2626", "fa-times-circle"),
        "không đến"           => ("#f1f5f9", "#475569", "fa-user-slash"),
        "đã đến"              => ("#fef9c3", "#a16207", "fa-walking"),
        "đang khám"           => ("#fce7f3", "#be185d", "fa-stethoscope"),
        "đã khám"             => ("#ede9fe", "#6d28d9", "fa-clipboard-check"),
        _                     => ("#f3f4f6", "#6b7280", "fa-question-circle")
    };

    var st = StatusStyle(Model.status);

    // Discount price helper — check against appointment date, not current time
    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();
    var _appointmentDate = Model.created_at ?? Model.appointment_date;
    Func<int, decimal> getDiscountedPrice = (serviceId) =>
    {
        var svc = _allSvcs.FirstOrDefault(x => x.service_id == serviceId);
        if (svc == null) return 0;
        var disc = svc.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= _appointmentDate && sd.end_date >= _appointmentDate && (sd.created_at ?? DateTime.MinValue) <= _appointmentDate);
        if (disc != null) return svc.base_price * (1 - (decimal)disc.discount_percent / 100);
        return svc.base_price;
    };
    Func<int, Group3_SWP391_PetMedical.Models.ServiceDiscount?> getActiveDiscount = (serviceId) =>
    {
        var svc = _allSvcs.FirstOrDefault(x => x.service_id == serviceId);
        return svc?.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= _appointmentDate && sd.end_date >= _appointmentDate && (sd.created_at ?? DateTime.MinValue) <= _appointmentDate);
    };
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }

        .pc-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; box-shadow:0 10px 25px rgba(0,0,0,0.04); margin-bottom:18px; }
        .pc-card-head { padding:14px 18px; background:#fff7f7; border-bottom:1px solid var(--pc-border); border-radius:16px 16px 0 0; font-weight:800; font-size:0.95rem; color:var(--pc-text); }
        .pc-card-head i { margin-right:8px; color:var(--pc-red); }
        .pc-card-body { padding:18px; }

        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 14px; border-radius:999px; font-weight:700; font-size:0.85rem; }
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; cursor:pointer; font-size:0.9rem; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-btn--danger { background:#dc2626; color:#fff; }
        .pc-btn--danger:hover { background:#b91c1c; color:#fff; }
        .pc-select { border-radius:12px !important; border:1px solid rgba(0,0,0,0.10) !important; height:42px !important; padding:0 12px !important; appearance:auto !important; -webkit-appearance:menulist !important; background:#fff !important; }
        .pc-readonly { background:#f8f8f8; border-left:4px solid var(--pc-red); border-radius:0 12px 12px 0; padding:14px; }
        .pc-readonly-row { display:flex; margin-bottom:6px; font-size:0.95rem; }
        .pc-readonly-row:last-child { margin-bottom:0; }
        .pc-readonly-label { width:120px; color:var(--pc-muted); font-weight:700; flex-shrink:0; }
        .pc-readonly-val { font-weight:600; }
        .pc-money { font-weight:900; }
        .pc-input { border-radius:12px !important; border:1px solid rgba(0,0,0,0.10) !important; }

        .pc-modal .modal-content { border-radius:16px; overflow:hidden; border:1px solid var(--pc-border); box-shadow:0 20px 60px rgba(0,0,0,0.18); }
        .pc-modal .modal-header { background:var(--pc-red); color:#fff; }
        .pc-modal .modal-header .close { color:#fff; opacity:1; }
    </style>
}

<section class="container py-4">
    <div class="pc-wrap" style="margin-top:150px;">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="pc-title">Chi tiết Lịch hẹn #@Model.appointment_id</h3>
                <p class="pc-sub">Xem thông tin lịch hẹn</p>
            </div>
            <a class="pc-btn pc-btn--ghost" href="@Url.Action("AppointmentList", "Manager")">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-3" style="border-radius:14px;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div class="row">
            <!-- Col 1: Info -->
            <div class="col-md-6">
                <div class="pc-card">
                    <div class="pc-card-head"><i class="fas fa-info-circle"></i>Thông tin lịch hẹn</div>
                    <div class="pc-card-body">
                        <div class="pc-readonly">
                            <div class="pc-readonly-row">
                                <span class="pc-readonly-label">Trạng thái:</span>
                                <span class="pc-readonly-val">
                                    <span class="pc-badge" style="background:@st.bg; color:@st.color;">
                                        <i class="fas @st.icon"></i> @(Model.status ?? "-")
                                    </span>
                                </span>
                            </div>
                            <div class="pc-readonly-row"><span class="pc-readonly-label">Ngày giờ:</span><span class="pc-readonly-val">@Model.appointment_date.ToString("dd/MM/yyyy HH:mm")</span></div>
                            <div class="pc-readonly-row"><span class="pc-readonly-label">Khách hàng:</span><span class="pc-readonly-val">@(Model.customer?.full_name ?? "N/A") <small class="text-muted">@(Model.customer?.phone ?? "")</small></span></div>
                            <div class="pc-readonly-row"><span class="pc-readonly-label">Thú cưng:</span><span class="pc-readonly-val">@(Model.pet?.name ?? "N/A") <small class="text-muted">(@(Model.pet?.species ?? ""))</small></span></div>
                            <div class="pc-readonly-row"><span class="pc-readonly-label">Bác sĩ:</span><span class="pc-readonly-val">@(Model.doctor?.full_name ?? "Chưa phân công")</span></div>
                            <div class="pc-readonly-row"><span class="pc-readonly-label">Ghi chú:</span><span class="pc-readonly-val">@(Model.notes ?? "-")</span></div>
                        </div>
                    </div>
                </div>

                <div class="pc-card">
                    <div class="pc-card-head"><i class="fas fa-list"></i>Dịch vụ đăng ký</div>
                    <div class="pc-card-body p-0">
                        @if (Model.AppointmentDetails != null && Model.AppointmentDetails.Any())
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead><tr><th style="padding:10px 16px; background:#fff7f7; font-weight:800;">Dịch vụ</th><th class="text-end" style="padding:10px 16px; background:#fff7f7; font-weight:800;">Giá</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in Model.AppointmentDetails)
                                        {
                                            var svcId = d.service_id;
                                            var actualP = d.actual_price;
                                            var discInfo = getActiveDiscount(svcId);
                                            var effectivePrice = actualP ?? getDiscountedPrice(svcId);
                                            var origPrice = d.service?.base_price ?? 0;

                                            <tr><td style="padding:10px 16px;">
                                                @(d.service?.service_name ?? "N/A")
                                                @if (discInfo != null && actualP == null)
                                                {
                                                    <span style="background:#dc2626; color:#fff; padding:1px 6px; border-radius:999px; font-size:0.7rem; font-weight:800; margin-left:4px;">-@discInfo.discount_percent%</span>
                                                }
                                            </td>
                                            <td class="text-end pc-money" style="padding:10px 16px;">
                                                @if (discInfo != null && actualP == null)
                                                {
                                                    <small style="text-decoration:line-through; color:rgba(0,0,0,.40); margin-right:4px;">@origPrice.ToString("N0")</small>
                                                    <span style="color:#dc2626;">@effectivePrice.ToString("N0") đ</span>
                                                }
                                                else
                                                {
                                                    @effectivePrice.ToString("N0") <text>đ</text>
                                                }
                                            </td></tr>
                                        }
                                        <tr style="background:#fff7f7;">
                                            <td style="padding:10px 16px; font-weight:800;">Tổng cộng</td>
                                            <td class="text-end pc-money" style="padding:10px 16px; color:var(--pc-red);">
                                                @(Model.AppointmentDetails.Sum(d => d.actual_price ?? getDiscountedPrice(d.service_id)).ToString("N0")) đ
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else { <div class="p-3 text-muted">Chưa có dịch vụ nào.</div> }
                    </div>
                </div>
            </div>

            <!-- Col 2: Actions -->
            <div class="col-md-6">

                @* Assign Doctor — only if no doctor yet and not cancelled/paid/examining/examined *@
                @if (Model.status?.ToLower() != "đã hủy" && Model.status?.ToLower() != "đã thanh toán" && Model.status?.ToLower() != "không đến" && Model.status?.ToLower() != "đang khám" && Model.status?.ToLower() != "đã khám")
                {
                    <div class="pc-card">
                        <div class="pc-card-head"><i class="fas fa-user-md"></i>Chỉ định Bác sĩ</div>
                        <div class="pc-card-body" style="overflow:visible;">
                            @if (doctors.Any())
                            {
                                <form asp-action="AssignDoctor" asp-controller="Manager" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="appointmentId" value="@Model.appointment_id" />
                                    <select name="doctorId" class="form-control pc-select" style="max-width:220px;" required>
                                        <option value="">-- Chọn bác sĩ --</option>
                                        @foreach (var doc in doctors)
                                        { <option value="@doc.user_id" selected="@(Model.doctor_id == doc.user_id)">@doc.full_name</option> }
                                    </select>
                                    <button type="submit" class="pc-btn pc-btn--primary">
                                        <i class="fas fa-user-check"></i> Chỉ định
                                    </button>
                                </form>
                            }
                            else { <p class="text-muted mb-0">Chưa có bác sĩ nào.</p> }
                        </div>
                    </div>
                }

                @* Medical Record & Prescription *@
                @if (Model.status == "Đã khám" || Model.status == "Đã thanh toán")
                {
                    <div class="pc-card">
                        <div class="pc-card-head"><i class="fas fa-notes-medical"></i>Kết quả khám & Đơn thuốc</div>
                        <div class="pc-card-body">
                            @if (Model.MedicalRecord != null)
                            {
                                <div class="pc-readonly mb-4">
                                    <div class="pc-readonly-row">
                                        <span class="pc-readonly-label">Chẩn đoán:</span>
                                        <span class="pc-readonly-val">@(Model.MedicalRecord.diagnosis ?? "N/A")</span>
                                    </div>
                                    <div class="pc-readonly-row">
                                        <span class="pc-readonly-label">Tình trạng:</span>
                                        <span class="pc-readonly-val">@(Model.MedicalRecord.health_status == "Checked" ? "Đã Khám" : Model.MedicalRecord.health_status ?? "N/A")</span>
                                    </div>
                                </div>
                                
                                @if (Model.MedicalRecord.Prescriptions != null && Model.MedicalRecord.Prescriptions.Any())
                                {
                                    <div class="pc-label mb-2"><i class="fas fa-pills" style="color:var(--pc-red);"></i> Đơn thuốc chi tiết</div>
                                    <div class="table-responsive" style="border:1px solid var(--pc-border); border-radius:12px; overflow:hidden;">
                                        <table class="table align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th style="padding:10px 16px; background:#fff7f7; font-weight:800;">Tên thuốc</th>
                                                    <th style="padding:10px 16px; background:#fff7f7; font-weight:800;">Liều dùng</th>
                                                    <th class="text-center" style="padding:10px 16px; background:#fff7f7; font-weight:800;">SL</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in Model.MedicalRecord.Prescriptions)
                                                {
                                                    <tr>
                                                        <td style="padding:10px 16px; font-weight:600;">@(p.medicine?.name ?? "N/A")</td>
                                                        <td style="padding:10px 16px; color:var(--pc-muted); font-size:0.9rem;">@p.dosage</td>
                                                        <td class="text-center" style="padding:10px 16px;"><span class="pc-badge">@p.quantity</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0"><i class="fas fa-info-circle"></i> Bác sĩ không kê đơn thuốc.</p>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0"><i class="fas fa-info-circle"></i> Hồ sơ khám đang được cập nhật...</p>
                            }
                        </div>
                    </div>
                }

                @* Cancel — Manager cancel when customer contacts *@
                @if (Model.status?.ToLower() != "đã hủy" && Model.status?.ToLower() != "đã thanh toán" && Model.status?.ToLower() != "không đến" && Model.status?.ToLower() != "đã khám" && Model.status?.ToLower() != "đang khám")
                {
                    <div class="pc-card">
                        <div class="pc-card-head"><i class="fas fa-times-circle"></i>Hủy lịch hẹn</div>
                        <div class="pc-card-body">
                            <p class="text-muted mb-3" style="font-size:0.9rem;">Hủy khi khách hàng liên hệ yêu cầu</p>
                            <button class="pc-btn pc-btn--danger" data-toggle="modal" data-target="#cancelModal">
                                <i class="fas fa-times"></i> Hủy lịch hẹn
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Modal Cancel -->
<div class="modal fade pc-modal" id="cancelModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-times-circle mr-2"></i>Hủy lịch hẹn</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-action="CancelAppointment" asp-controller="Manager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.appointment_id" />
                <div class="modal-body" style="padding:20px;">
                    <label class="form-label" style="font-weight:700;">Lý do hủy:</label>
                    <textarea class="form-control" name="reason" rows="3"
                              placeholder="Nhập lý do hủy..." style="height:auto !important; border-radius:12px;"></textarea>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--pc-border);">
                    <button type="button" class="pc-btn pc-btn--ghost" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="pc-btn pc-btn--danger">
                        <i class="fas fa-times"></i> Xác nhận Hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
