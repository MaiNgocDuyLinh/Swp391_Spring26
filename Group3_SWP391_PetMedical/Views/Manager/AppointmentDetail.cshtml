@model Group3_SWP391_PetMedical.Models.Appointment
@using Group3_SWP391_PetMedical.Models
@{
    ViewData["Title"] = "Chi tiết Lịch hẹn";
    var doctors = ViewBag.Doctors as List<User> ?? new List<User>();

    string StatusBadge(string? s) => s switch {
        "Pending"   => "badge-warning",
        "Deposited" => "badge-info",
        "Confirmed" => "badge-primary",
        "Arrived"   => "badge-secondary",
        "Completed" => "badge-success",
        "Cancelled" => "badge-danger",
        "NoShow"    => "badge-dark",
        _           => "badge-light"
    };
    string StatusText(string? s) => s switch {
        "Pending"   => "Chờ duyệt",
        "Deposited" => "Đã đặt cọc",
        "Confirmed" => "Đã xác nhận",
        "Arrived"   => "Đã đến",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        "NoShow"    => "Không đến",
        _           => s ?? "-"
    };
}

<div class="slider-area2 slider-height2 d-flex align-items-center">
    <div class="container">
        <div class="hero-cap text-center pt-50">
            <h2>Chi tiết Lịch hẹn #@Model.appointment_id</h2>
        </div>
    </div>
</div>

<div class="container" style="padding: 40px 0;">
    <a href="@Url.Action("AppointmentList", "Manager")" class="btn btn-secondary mb-3">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <!-- Thông tin lịch hẹn -->
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Thông tin lịch hẹn</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr><th width="40%">Trạng thái:</th><td><span class="badge @StatusBadge(Model.status)">@StatusText(Model.status)</span></td></tr>
                        <tr><th>Ngày giờ:</th><td>@Model.appointment_date.ToString("dd/MM/yyyy HH:mm")</td></tr>
                        <tr><th>Khách hàng:</th><td>@(Model.customer?.full_name ?? "N/A")<br/><small class="text-muted">@(Model.customer?.phone ?? "")</small></td></tr>
                        <tr><th>Thú cưng:</th><td>@(Model.pet?.name ?? "N/A") <small class="text-muted">(@(Model.pet?.species ?? ""))</small></td></tr>
                        <tr><th>Bác sĩ:</th><td>@(Model.doctor?.full_name ?? "Chưa phân công")</td></tr>
                        <tr><th>Ghi chú:</th><td>@(Model.notes ?? "-")</td></tr>
                    </table>
                </div>
            </div>

            <!-- Dịch vụ đã đăng ký -->
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Dịch vụ đăng ký</h5>
                </div>
                <div class="card-body">
                    @if (Model.AppointmentDetails != null && Model.AppointmentDetails.Any())
                    {
                        <table class="table table-sm">
                            <thead><tr><th>Dịch vụ</th><th class="text-right">Giá</th></tr></thead>
                            <tbody>
                                @foreach (var d in Model.AppointmentDetails)
                                {
                                    <tr>
                                        <td>@(d.service?.service_name ?? "N/A")</td>
                                        <td class="text-right">@((d.actual_price ?? d.service?.base_price ?? 0).ToString("N0")) đ</td>
                                    </tr>
                                }
                                <tr class="font-weight-bold">
                                    <td>Tổng cộng</td>
                                    <td class="text-right text-success">
                                        @(Model.AppointmentDetails.Sum(d => d.actual_price ?? d.service?.base_price ?? 0).ToString("N0")) đ
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có dịch vụ nào.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Action Panel -->
        <div class="col-md-6">

            <!-- Approve / Reject (Manager) -->
            @if (Model.status == "Pending" || Model.status == "Deposited")
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-gavel"></i> Duyệt / Hủy lịch hẹn</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="ApproveAppointment" asp-controller="Manager" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.appointment_id" />
                            <button type="submit" class="btn btn-success mr-2"
                                    onclick="return confirm('Xác nhận duyệt lịch hẹn này?')">
                                <i class="fas fa-check"></i> Xác nhận
                            </button>
                        </form>

                        <button class="btn btn-danger" data-toggle="modal" data-target="#rejectModal">
                            <i class="fas fa-times"></i> Hủy lịch
                        </button>
                    </div>
                </div>
            }

            <!-- Assign Doctor -->
            @if (Model.status != "Cancelled" && Model.status != "Completed")
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-user-md"></i> Chỉ định Bác sĩ</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="AssignDoctor" asp-controller="Manager" method="post" class="form-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@Model.appointment_id" />
                            <select name="doctorId" class="form-control mr-2" style="min-width:200px;" required>
                                <option value="">-- Chọn bác sĩ --</option>
                                @foreach (var doc in doctors)
                                {
                                    <option value="@doc.user_id" selected="@(Model.doctor_id == doc.user_id)">
                                        @doc.full_name
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-user-check"></i> Chỉ định
                            </button>
                        </form>
                        @if (!doctors.Any())
                        {
                            <small class="text-muted">Chưa có bác sĩ nào trong hệ thống.</small>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Reject -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-times-circle"></i> Hủy lịch hẹn</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-action="RejectAppointment" asp-controller="Manager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.appointment_id" />
                <div class="modal-body">
                    <div class="form-group">
                        <label>Lý do hủy (tùy chọn):</label>
                        <textarea class="form-control" name="reason" rows="3" placeholder="Nhập lý do hủy..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận Hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .table th { color: #495057; }
    .badge { padding: 6px 10px; font-size: 0.9em; }
</style>
