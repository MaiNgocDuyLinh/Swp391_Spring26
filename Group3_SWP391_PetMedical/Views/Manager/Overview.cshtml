@model Group3_SWP391_PetMedical.ViewModels.Manager.OverviewStatsVM
@{
    ViewData["Title"] = "Thống kê tổng quan";
    var fromStr = Model.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toStr = Model.ToDate?.ToString("yyyy-MM-dd") ?? "";
}
<!-- Hero Area Start -->
<div class="slider-area2 slider-height2 d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="hero-cap text-center pt-50">
                    <h2>Thống kê tổng quan (Manager)</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero Area End -->

<div class="container" style="padding: 50px 0;">
    <!-- Bộ lọc theo ngày/tháng -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-filter"></i> Lọc theo khoảng thời gian</h5>
                    <form method="get" asp-action="Overview" asp-controller="ManagerModule" class="form-inline flex-wrap align-items-end gap-2">
                        <div class="form-group mr-2 mb-2">
                            <label class="mr-1">Từ ngày</label>
                            <input type="date" class="form-control" name="fromDate" value="@fromStr" />
                        </div>
                        <div class="form-group mr-2 mb-2">
                            <label class="mr-1">Đến ngày</label>
                            <input type="date" class="form-control" name="toDate" value="@toStr" />
                        </div>
                        <div class="form-group mr-2 mb-2">
                            <label class="mr-1">Nhóm theo</label>
                            <select name="groupBy" class="form-control">
                                @if (Model.GroupBy == "day")
                                {
                                    <option value="day" selected>Theo ngày</option>
                                    <option value="month">Theo tháng</option>
                                }
                                else
                                {
                                    <option value="day">Theo ngày</option>
                                    <option value="month" selected>Theo tháng</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-2">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-chart-line"></i> Xem thống kê</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ thống kê chính -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow border-0 border-left-primary">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2">Doanh thu (đã thanh toán)</h6>
                    <h3 class="mb-0 text-primary">@Model.Revenue.ToString("N0") <small>VNĐ</small></h3>
                    <small class="text-muted">Kỳ: @Model.FromDate?.ToString("dd/MM/yyyy") - @Model.ToDate?.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="card-footer bg-primary text-white text-center">
                    <i class="fas fa-money-bill-wave"></i> Doanh thu
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow border-0 border-left-success">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2">Lượt đăng nhập (Khách hàng)</h6>
                    <h3 class="mb-0 text-success">@Model.CustomerLoginCount</h3>
                    <small class="text-muted">Số lần đăng nhập của role Customer trong kỳ</small>
                </div>
                <div class="card-footer bg-success text-white text-center">
                    <i class="fas fa-user-check"></i> Đăng nhập KH
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow border-0 border-left-info">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2">Số lịch khám đã đặt</h6>
                    <h3 class="mb-0 text-info">@Model.TotalAppointments</h3>
                    <small class="text-muted">Tổng lịch khám trong kỳ (theo ngày tạo)</small>
                </div>
                <div class="card-footer bg-info text-white text-center">
                    <i class="fas fa-calendar-check"></i> Lịch khám
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê lịch khám theo status -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-list-alt"></i> Lịch khám theo trạng thái (Status)</h5>
                </div>
                <div class="card-body">
                    @if (Model.AppointmentsByStatus != null && Model.AppointmentsByStatus.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead><tr><th>Trạng thái</th><th>Số lượng</th></tr></thead>
                                <tbody>
                                    @foreach (var item in Model.AppointmentsByStatus.OrderByDescending(x => x.Value))
                                    {
                                        <tr><td>@item.Key</td><td><strong>@item.Value</strong></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu lịch khám trong kỳ đã chọn.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ (optional) -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-bar"></i> Doanh thu theo @(Model.GroupBy == "month" ? "tháng" : "ngày")</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartRevenue" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line"></i> Số lịch khám theo @(Model.GroupBy == "month" ? "tháng" : "ngày")</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartAppointments" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByDate?.Select(x => x.Label).ToList() ?? new List<string>()));
            var revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByDate?.Select(x => x.Value).ToList() ?? new List<decimal>()));
            var apptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppointmentsByDate?.Select(x => x.Label).ToList() ?? new List<string>()));
            var apptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppointmentsByDate?.Select(x => x.Count).ToList() ?? new List<int>()));

            if (document.getElementById('chartRevenue') && revenueLabels.length) {
                new Chart(document.getElementById('chartRevenue'), {
                    type: 'bar',
                    data: {
                        labels: revenueLabels,
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: revenueData,
                            backgroundColor: 'rgba(40, 167, 69, 0.6)',
                            borderColor: 'rgb(40, 167, 69)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
            if (document.getElementById('chartAppointments') && apptLabels.length) {
                new Chart(document.getElementById('chartAppointments'), {
                    type: 'line',
                    data: {
                        labels: apptLabels,
                        datasets: [{
                            label: 'Số lịch khám',
                            data: apptData,
                            borderColor: 'rgb(23, 162, 184)',
                            backgroundColor: 'rgba(23, 162, 184, 0.2)',
                            fill: true,
                            tension: 0.3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
        })();
    </script>
}

<style>
    .border-left-primary { border-left: 4px solid #007bff !important; }
    .border-left-success { border-left: 4px solid #28a745 !important; }
    .border-left-info { border-left: 4px solid #17a2b8 !important; }
    .card { border-radius: 10px; }
    .card-header { border-radius: 10px 10px 0 0; }
</style>
