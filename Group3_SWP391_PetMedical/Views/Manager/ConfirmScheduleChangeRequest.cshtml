@model Group3_SWP391_PetMedical.ViewModels.Manager.ScheduleChangeRequestDetailVM
@{
    ViewData["Title"] = "Xử lý yêu cầu đổi lịch";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<!-- Hero Area Start -->
<div class="slider-area2 slider-height2 d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="hero-cap text-center pt-50">
                    <h2>Chấp nhận hoặc từ chối yêu cầu đổi lịch</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero Area End -->

<div class="container" style="padding: 50px 0;">
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-file-alt"></i> Chi tiết yêu cầu #@Model.RequestId</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 35%;">Bác sĩ</th>
                            <td>@Model.DoctorName @(string.IsNullOrEmpty(Model.DoctorPhone) ? "" : $" - {Model.DoctorPhone}")</td>
                        </tr>
                        <tr>
                            <th>Lịch hiện tại</th>
                            <td>@Model.CurrentWorkDate.ToString("dd/MM/yyyy") - Ca: @(Model.CurrentShift ?? "—")</td>
                        </tr>
                        <tr>
                            <th>Lịch mong muốn</th>
                            <td>@Model.RequestedWorkDate.ToString("dd/MM/yyyy") - Ca: @Model.RequestedShift</td>
                        </tr>
                        <tr>
                            <th>Lý do đổi lịch</th>
                            <td>@(Model.Reason ?? "Không ghi")</td>
                        </tr>
                        <tr>
                            <th>Ngày tạo yêu cầu</th>
                            <td>@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        </tr>
                    </table>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <form method="post" asp-action="ApproveScheduleChangeRequest" asp-controller="ManagerModule" asp-route-id="@Model.RequestId">
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <label for="approveNote">Ghi chú (khi chấp nhận)</label>
                                    <input type="text" class="form-control" name="managerNote" id="approveNote" placeholder="Tùy chọn" />
                                </div>
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-check"></i> Chấp nhận
                                </button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <form method="post" asp-action="RejectScheduleChangeRequest" asp-controller="ManagerModule" asp-route-id="@Model.RequestId">
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <label for="rejectNote">Ghi chú (khi từ chối)</label>
                                    <input type="text" class="form-control" name="managerNote" id="rejectNote" placeholder="Tùy chọn" />
                                </div>
                                <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Bạn có chắc muốn từ chối yêu cầu này?');">
                                    <i class="fas fa-times"></i> Từ chối
                                </button>
                            </form>
                        </div>
                    </div>

                    <hr class="mt-4" />
                    <a href="@Url.Action("ListScheduleChangeRequests", "ManagerModule")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card { border-radius: 10px; }
    .card-header { border-radius: 10px 10px 0 0; }
</style>
