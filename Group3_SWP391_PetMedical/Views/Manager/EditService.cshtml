@model Group3_SWP391_PetMedical.Models.Service
@{
    ViewData["Title"] = "Chỉnh sửa dịch vụ";
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-form-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; overflow:hidden; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-form-head { background:#fff7f7; padding:16px 20px; border-bottom:1px solid var(--pc-border); font-weight:800; }
        .pc-form-body { padding:24px; }
        .pc-label { font-weight:700; font-size:0.9rem; margin-bottom:6px; }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        .pc-input:focus { border-color:var(--pc-red); box-shadow:0 0 0 0.2rem rgba(255,59,59,0.15); }
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; cursor:pointer; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .custom-control-input:checked ~ .custom-control-label::before { background-color:var(--pc-red); border-color:var(--pc-red); }
    </style>
}

<section class="container py-4">
    <div class="pc-wrap" style="margin-top:150px;">
        <h3 class="pc-title">Chỉnh sửa dịch vụ</h3>
        <p class="pc-sub">Cập nhật thông tin dịch vụ tại phòng khám</p>

        <div class="mt-3 mb-3">
            <a class="pc-btn pc-btn--ghost" href="@Url.Action("ListServices", "Manager")">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>

        <div class="pc-form-card">
            <div class="pc-form-head"><i class="fas fa-edit mr-2"></i>@Model.service_name</div>
            <div class="pc-form-body">
                <form asp-action="EditService" asp-controller="Manager" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.service_id" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4" style="border-radius:14px;">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div><i class="fas fa-exclamation-triangle"></i> @error.ErrorMessage</div> }
                        </div>
                    }

                    <!-- Tên dịch vụ -->
                    <div class="mb-3">
                        <div class="pc-label">Tên dịch vụ <span class="text-danger">*</span></div>
                        <input type="text" class="form-control pc-input" name="service_name"
                               value="@Model.service_name" required placeholder="Nhập tên dịch vụ..." />
                    </div>

                    <!-- Mô tả -->
                    <div class="mb-3">
                        <div class="pc-label">Mô tả</div>
                        <textarea class="form-control pc-input" name="description" rows="4"
                                  placeholder="Nhập mô tả..." style="height:auto;">@Model.description</textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="pc-label">Giá (VNĐ) <span class="text-danger">*</span></div>
                            <input type="number" class="form-control pc-input" name="base_price"
                                   value="@Model.base_price" min="0" step="1000" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="pc-label">Thời gian (phút)</div>
                            <input type="number" class="form-control pc-input" name="duration"
                                   value="@Model.duration" min="0" placeholder="Số phút..." />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="pc-label">Dịch vụ tại nhà</div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="home_yes" name="is_home_service" class="custom-control-input" value="true" @(Model.is_home_service == true ? "checked" : "")>
                                    <label class="custom-control-label" for="home_yes">Có</label>
                                </div>
                                <div class="custom-control custom-radio ml-3">
                                    <input type="radio" id="home_no" name="is_home_service" class="custom-control-input" value="false" @(Model.is_home_service != true ? "checked" : "")>
                                    <label class="custom-control-label" for="home_no">Không</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="pc-label">Trạng thái</div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="status_active" name="status" class="custom-control-input" value="true" @(Model.status == true ? "checked" : "")>
                                    <label class="custom-control-label" for="status_active">Hoạt động</label>
                                </div>
                                <div class="custom-control custom-radio ml-3">
                                    <input type="radio" id="status_inactive" name="status" class="custom-control-input" value="false" @(Model.status != true ? "checked" : "")>
                                    <label class="custom-control-label" for="status_inactive">Ngừng</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex justify-content-end gap-3">
                        <a href="@Url.Action("ListServices", "Manager")" class="pc-btn pc-btn--ghost">Hủy</a>
                        <button type="submit" class="pc-btn pc-btn--primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
