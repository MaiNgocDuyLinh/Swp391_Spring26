@model Group3_SWP391_PetMedical.Models.Service
@{
    ViewData["Title"] = "Chỉnh sửa dịch vụ";
}

<!-- Hero Area -->
<div class="slider-area2 slider-height2 d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="hero-cap text-center pt-50">
                    <h2>Quản lý Dịch vụ (Manager)</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="our-services section-padding30">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mb-4">
                    <a href="@Url.Action("ListServices", "Manager")" class="pc-btn pc-btn--reset">
                        <i class="fas fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>

                <div class="pc-card shadow-sm">
                    <div class="pc-card-head" style="background:#7EB6FF;">
                        <h5><i class="fas fa-edit mr-2"></i>Chỉnh sửa: @Model.service_name</h5>
                    </div>
                    <div class="pc-card-body p-4">
                        <form asp-action="EditService" asp-controller="Manager" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.service_id" />

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger mb-4" style="border-radius:8px;">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <div><i class="fas fa-exclamation-triangle"></i> @error.ErrorMessage</div>
                                    }
                                </div>
                            }

                            <!-- Tên dịch vụ -->
                            <div class="form-group mb-4">
                                <label for="service_name" class="font-weight-bold mb-2">Tên dịch vụ <span class="text-danger">*</span></label>
                                <input type="text" class="form-control pc-input" id="service_name" name="service_name"
                                       value="@Model.service_name" required placeholder="Nhập tên dịch vụ..." />
                            </div>

                            <!-- Mô tả -->
                            <div class="form-group mb-4">
                                <label for="description" class="font-weight-bold mb-2">Mô tả</label>
                                <textarea class="form-control pc-input" id="description" name="description"
                                          rows="4" placeholder="Nhập mô tả dịch vụ..." style="height:auto;">@Model.description</textarea>
                            </div>

                            <div class="row">
                                <!-- Giá -->
                                <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label for="base_price" class="font-weight-bold mb-2">Giá (VNĐ) <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control pc-input" id="base_price" name="base_price"
                                               value="@Model.base_price" min="0" step="1000" required />
                                    </div>
                                </div>
                                <!-- Thời gian -->
                                <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label for="duration" class="font-weight-bold mb-2">Thời gian (phút)</label>
                                        <input type="number" class="form-control pc-input" id="duration" name="duration"
                                               value="@Model.duration" min="0" placeholder="Số phút..." />
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <!-- Dịch vụ tại nhà -->
                                <div class="col-md-6">
                                    <label class="font-weight-bold mb-2">Dịch vụ tại nhà</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="custom-control custom-radio">
                                            <input type="radio" id="home_yes" name="is_home_service" class="custom-control-input" value="true" @(Model.is_home_service == true ? "checked" : "")>
                                            <label class="custom-control-label" for="home_yes">Có</label>
                                        </div>
                                        <div class="custom-control custom-radio ml-3">
                                            <input type="radio" id="home_no" name="is_home_service" class="custom-control-input" value="false" @(Model.is_home_service != true ? "checked" : "")>
                                            <label class="custom-control-label" for="home_no">Không</label>
                                        </div>
                                    </div>
                                </div>
                                <!-- Trạng thái -->
                                <div class="col-md-6">
                                    <label class="font-weight-bold mb-2">Trạng thái</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="custom-control custom-radio">
                                            <input type="radio" id="status_active" name="status" class="custom-control-input" value="true" @(Model.status == true ? "checked" : "")>
                                            <label class="custom-control-label" for="status_active">Hoạt động</label>
                                        </div>
                                        <div class="custom-control custom-radio ml-3">
                                            <input type="radio" id="status_inactive" name="status" class="custom-control-input" value="false" @(Model.status != true ? "checked" : "")>
                                            <label class="custom-control-label" for="status_inactive">Ngừng</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <!-- Buttons -->
                            <div class="d-flex justify-content-end gap-2">
                                <a href="@Url.Action("ListServices", "Manager")" class="pc-btn pc-btn--reset mr-2">Hủy</a>
                                <button type="submit" class="pc-btn">
                                    <i class="fas fa-save mr-1"></i> Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root { --btn-bg: #7EB6FF; --btn-text: #fff; }
    .pc-card { border-radius:16px; overflow:hidden; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); }
    .pc-card-head { padding:18px 24px; color:#fff; }
    .pc-card-head h5 { margin:0; font-weight:700; }
    .pc-btn { height:48px; padding:0 24px; background:var(--btn-bg) !important; color:var(--btn-text) !important; border:none !important; border-radius:8px !important; font-weight:700; display:inline-flex; align-items:center; cursor:pointer; transition:opacity .15s; text-decoration:none; }
    .pc-btn:hover { opacity:.88; color:#fff !important; text-decoration:none; }
    .pc-btn--reset { background:#f0f0f0 !important; color:#333 !important; }
    .pc-input { height:48px; border-radius:8px !important; border:1px solid rgba(0,0,0,.10); }
    .pc-input:focus { border-color:var(--btn-bg); box-shadow: 0 0 0 0.2rem rgba(126, 182, 255, 0.25); }
    .custom-control-input:checked ~ .custom-control-label::before { background-color: var(--btn-bg); border-color: var(--btn-bg); }
</style>
