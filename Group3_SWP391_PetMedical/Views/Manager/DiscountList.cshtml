@model List<Group3_SWP391_PetMedical.Models.Service>
@{
    ViewData["Title"] = "Giảm giá Dịch vụ";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
    string? search = ViewBag.Search;
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); }
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:18px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-label { font-weight:700; font-size:0.9rem; margin-bottom:6px; }
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:42px; padding:0 12px; }
        .pc-btn { border-radius:999px; padding:0 18px; height:42px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; }
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-table { border-radius:16px; overflow:hidden; background:#fff; border:1px solid var(--pc-border); box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-table thead th { background:#fff7f7; font-weight:800; }
        .pc-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; font-weight:800; font-size:0.85rem; border:1px solid rgba(0,0,0,0.06); background:#fff; }
        .pc-badge i { color:var(--pc-red); }
        .pc-money { font-weight:900; }
        .pc-ico { width:36px; height:36px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.10); background:#fff; color:var(--pc-text); box-shadow:0 8px 18px rgba(0,0,0,0.04); text-decoration:none; cursor:pointer; }
        .pc-ico:hover { border-color:rgba(255,59,59,0.35); box-shadow:0 10px 22px rgba(255,59,59,0.12); color:var(--pc-red-dark); }
        .pc-action-icons { display:flex; justify-content:flex-end; gap:10px; }
        tbody.pc-record { transition:background 0.25s ease; }
        tbody.pc-record:hover tr { background:#fff3f3 !important; }
        .pc-pager.pagination { gap:10px; margin:0; }
        .pc-pager .page-item .page-link { border-radius:999px !important; width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center; padding:0 !important; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text); background:#fff; box-shadow:0 8px 18px rgba(0,0,0,0.04); }
        .pc-pager .page-item .page-link:hover { border-color:rgba(255,59,59,0.35); color:var(--pc-red-dark); }
        .pc-pager .page-item.active .page-link { background:var(--pc-red) !important; border-color:var(--pc-red) !important; color:#fff !important; box-shadow:0 12px 24px rgba(255,59,59,0.25); }
        .pc-pager .page-item.disabled .page-link { opacity:0.45; pointer-events:none; box-shadow:none; }

        .sale-tag { background:#dc2626; color:#fff; padding:3px 10px; border-radius:999px; font-weight:800; font-size:0.75rem; display:inline-flex; align-items:center; gap:4px; }
        .price-old { text-decoration: line-through; color: var(--pc-muted); font-weight:500; font-size:0.85rem; }
        .price-new { color: var(--pc-red); font-weight:900; }
    </style>
}

<section class="container py-4" id="servicesArea">
    <div class="pc-wrap" style="margin-top:150px;">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="pc-title">Giảm giá Dịch vụ</h3>
                <p class="pc-sub">Quản lý khuyến mãi cho từng dịch vụ tại phòng khám</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3 mb-0" style="border-radius:14px;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3 mb-0" style="border-radius:14px;">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="pc-filter">
            <form method="get" asp-controller="Manager" asp-action="DiscountList" class="row g-3">
                <div class="col-lg-6 col-md-8">
                    <div class="pc-label">Từ khóa</div>
                    <input class="form-control pc-input" name="search" value="@search"
                           placeholder="Tên dịch vụ..." />
                </div>
                <div class="col-12 mt-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <a class="pc-btn pc-btn--ghost" href="@Url.Action("DiscountList", "Manager")#servicesArea">
                            <i class="fas fa-undo-alt"></i> Làm mới
                        </a>
                        <button type="submit" class="pc-btn pc-btn--primary">
                            <i class="fas fa-filter"></i> Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info mb-0" style="border-radius:14px;">Chưa có dịch vụ nào.</div>
        }
        else
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Tên dịch vụ</th>
                            <th class="text-end" style="width:140px;">Giá gốc (VNĐ)</th>
                            <th class="text-center" style="width:100px;">Giảm giá</th>
                            <th class="text-end" style="width:150px;">Giá sau giảm</th>
                            <th style="width:200px;">Thời hạn</th>
                            <th style="width:120px;">Trạng thái</th>
                            <th style="width:80px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    @{int idx = (currentPage - 1) * 5 + 1;}
                    @foreach (var s in Model)
                    {
                        var activeDiscount = s.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true);
                        bool isOnSale = activeDiscount != null && activeDiscount.start_date <= DateTime.Now && activeDiscount.end_date >= DateTime.Now;
                        decimal discountedPrice = isOnSale ? s.base_price * (1 - (decimal)activeDiscount!.discount_percent / 100) : s.base_price;

                        <tbody class="pc-record">
                            <tr>
                                <td>@idx</td>
                                <td><strong>@s.service_name</strong></td>
                                <td class="text-end">
                                    @if (isOnSale)
                                    {
                                        <span class="price-old">@s.base_price.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="pc-money">@s.base_price.ToString("N0")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isOnSale)
                                    {
                                        <span class="sale-tag"><i class="fas fa-bolt"></i> -@activeDiscount!.discount_percent%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (isOnSale)
                                    {
                                        <span class="price-new">@discountedPrice.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="pc-money">@s.base_price.ToString("N0")</span>
                                    }
                                </td>
                                <td>
                                    @if (activeDiscount != null)
                                    {
                                        <small>@activeDiscount.start_date.ToString("dd/MM/yyyy") - @activeDiscount.end_date.ToString("dd/MM/yyyy")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (isOnSale)
                                    {
                                        <span class="pc-badge" style="background:#dcfce7; color:#15803d; border-color:#bbf7d0;">
                                            <i class="fas fa-check-circle" style="color:#15803d;"></i> Đang giảm
                                        </span>
                                    }
                                    else if (activeDiscount != null && activeDiscount.end_date < DateTime.Now)
                                    {
                                        <span class="pc-badge" style="background:#f3f4f6; color:#6b7280;">
                                            <i class="fas fa-clock" style="color:#6b7280;"></i> Hết hạn
                                        </span>
                                    }
                                    else if (activeDiscount != null && activeDiscount.start_date > DateTime.Now)
                                    {
                                        <span class="pc-badge" style="background:#fef3c7; color:#b45309;">
                                            <i class="fas fa-hourglass-half" style="color:#b45309;"></i> Sắp tới
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pc-badge">
                                            <i class="fas fa-minus-circle"></i> Chưa giảm
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="pc-action-icons">
                                        <a class="pc-ico" title="Thiết lập giảm giá"
                                           href="@Url.Action("ManageDiscount", "Manager", new { serviceId = s.service_id })">
                                            <i class="fas fa-tag"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                        idx++;
                    }
                </table>
            </div>

            <div class="mt-3 d-flex justify-content-center">
                <ul class="pagination pc-pager">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("DiscountList", "Manager", new { search, page = currentPage - 1 })"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Math.Max(totalPages, 1); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("DiscountList", "Manager", new { search, page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("DiscountList", "Manager", new { search, page = currentPage + 1 })"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </div>
            <div class="text-center mt-2" style="color:var(--pc-muted); font-size:0.95rem;">
                Tổng: <strong>@totalItems</strong> dịch vụ
            </div>
        }

        <!-- Nút lịch sử ở góc dưới bên phải -->
        <div class="d-flex justify-content-end mt-3">
            <a href="@Url.Action("DiscountHistory", "Manager")" class="pc-btn pc-btn--ghost">
                <i class="fas fa-history"></i> Lịch sử giảm giá
            </a>
        </div>
    </div>
</section>
