@{
    Layout = null;
    var url = (ViewBag.GoBackUrl as string)
              ?? Url.Action("AppointmentHistory", "CusAppointment");
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
</head>
<body>
    <script>
        (function () {
            var url = '@(url ?? "")';
            try {
                if (window.opener && !window.opener.closed) {
                    window.opener.location.href = url;
                    window.close();
                    return;
                }
            } catch (e) { }

            try {
                if (window.parent && window.parent !== window) {
                    window.parent.location.href = url;
                    return;
                }
            } catch (e) { }

            window.location.href = url;
        })();
    </script>
</body>
</html>