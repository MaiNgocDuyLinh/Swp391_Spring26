@using Microsoft.AspNetCore.Mvc.Rendering
@model Group3_SWP391_PetMedical.ViewModels.Appointment.CusEditAppointmentVM

@{
    ViewData["Title"] = "Chỉnh sửa lịch hẹn";

    //   Lấy services từ ViewBag (đúng với controller của bạn)
    var serviceOptions = ViewBag.ServiceOptions as List<SelectListItem> ?? new List<SelectListItem>();
}

@section Styles {
    <style>
        :root {
            --pc-red: #ff3b3b;
            --pc-red-dark: #e83434;
            --pc-text: #2b2b2b;
            --pc-muted: #7a7a7a;
            --pc-border: rgba(0,0,0,0.06);
        }

        .pc-page {
            background: #fff;
        }

        .pc-shell {
            margin-top: 150px;
            background: #fff;
            border-radius: 20px;
        }

        .pc-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 18px;
        }

        @@media (max-width: 992px) {
            .pc-grid {
                grid-template-columns: 1fr;
            }
        }

        .pc-card {
            background: #fff;
            border: 1px solid var(--pc-border);
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
            overflow: hidden;
        }

        .pc-card__head {
            padding: 16px 18px;
            background: #fff7f7;
            border-bottom: 1px solid rgba(0,0,0,0.06);
        }

        .pc-title {
            font-weight: 900;
            margin: 0;
        }

        .pc-sub {
            margin: 6px 0 0 0;
            color: var(--pc-muted);
        }

        .pc-card__body {
            padding: 16px 18px;
        }

        .pc-label {
            font-weight: 800;
            font-size: 0.95rem;
            margin-bottom: 6px;
        }

        .pc-input, .pc-select, .pc-textarea {
            width: 100%;
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,0.10);
            height: 44px;
            padding: 0 12px;
            outline: none;
        }

            .pc-select.form-select {
                line-height: 44px !important;
                padding-top: 0 !important;
                padding-bottom: 0 !important;
                background-position: right 12px center;
            }

        .pc-textarea {
            height: auto;
            min-height: 110px;
            padding: 10px 12px;
        }

        .pc-services {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 14px;
            padding: 12px;
            background: #fff;
            max-height: 260px;
            overflow: auto;
        }

        .pc-actions {
            display: flex;
            gap: 12px;
            margin-top: 14px;
        }

        .pc-btn {
            border-radius: 999px;
            height: 44px;
            padding: 0 18px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid rgba(0,0,0,0.10);
            background: #fff;
            color: var(--pc-text);
            text-decoration: none;
        }

        .pc-btn--primary {
            background: var(--pc-red);
            border-color: var(--pc-red);
            color: #fff;
            box-shadow: 0 10px 20px rgba(255,59,59,0.20);
        }

            .pc-btn--primary:hover {
                background: var(--pc-red-dark);
                color: #fff;
            }

        .pc-side {
            display: grid;
            gap: 14px;
        }

        .pc-pill {
            display: inline-flex;
            gap: 10px;
            align-items: center;
            font-weight: 800;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid rgba(0,0,0,0.06);
            background: #fff;
            width: fit-content;
        }

        .pc-steps {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
            overflow: hidden;
        }

        .pc-steps__head {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            background: #fff;
            font-weight: 900;
        }

        .pc-step {
            display: grid;
            grid-template-columns: 34px 1fr;
            gap: 12px;
            padding: 12px 16px;
            border-top: 1px solid rgba(0,0,0,0.04);
            background: #fff7f7;
        }

            .pc-step:first-of-type {
                border-top: none;
            }

        .pc-step__n {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            background: #fff;
            border: 1px solid rgba(0,0,0,0.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
        }

        .pc-step__t {
            font-weight: 900;
            margin: 0;
        }

        .pc-step__d {
            margin: 4px 0 0 0;
            color: var(--pc-muted);
            font-weight: 700;
        }

        .text-danger {
            color: #dc3545;
            font-weight: 700;
        }

        .pc-hint {
            color: var(--pc-muted);
            font-weight: 700;
            font-size: 0.95rem;
        }
    </style>
}

<section class="container pc-page">
    <div class="pc-shell">
        <div class="pc-grid">

            <!-- LEFT: FORM -->
            <div class="pc-card">
                <div class="pc-card__head">
                    <div class="pc-pill">
                        <i class="fas fa-calendar-alt"></i> Chỉnh sửa lịch hẹn
                    </div>
                    <h2 class="pc-title" style="margin-top:10px;">Cập nhật lịch khám</h2>
                    <p class="pc-sub">
                        Bạn chỉ được chỉnh sửa trong vòng <strong>24h</strong> từ lúc tạo.
                    </p>
                </div>

                <div class="pc-card__body">
                    <form method="post" asp-controller="CusAppointment" asp-action="Edit">
                        @Html.AntiForgeryToken()

                        <!--  show lỗi tổng để biết vì sao không lưu -->
                        @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-bottom:10px;" })

                        <input type="hidden" asp-for="AppointmentId" />

                        <div class="mb-3">
                            <div class="pc-label">Ngày tạo lịch</div>
                            <input class="pc-input" value="@Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")" disabled />
                        </div>

                        <div class="mb-3">
                            <div class="pc-label">Trạng thái</div>
                            <input class="pc-input" value="@Model.Status" disabled />
                        </div>

                        <div class="mb-3">
                            <div class="pc-label">Ngày giờ khám</div>
                            <!--  bind trực tiếp để ModelState bắt đúng -->
                            <input type="datetime-local"
                                   class="pc-input"
                                   asp-for="AppointmentDate"
                                   value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <div class="text-danger">@Html.ValidationMessageFor(m => m.AppointmentDate)</div>
                        </div>

                        <div class="mb-3">
                            <div class="pc-label">Chọn dịch vụ</div>

                            <div class="pc-services">
                                @if (serviceOptions.Any())
                                {
                                    <!--  Checkbox bind vào ServiceIds -->
                                    @foreach (var opt in serviceOptions)
                                    {
                                        <div class="form-check" style="margin-bottom:8px;">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="ServiceIds"
                                                   value="@opt.Value"
                                                   @(opt.Selected ? "checked" : null) />

                                            <label class="form-check-label">@opt.Text</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="pc-hint">Chưa có danh sách dịch vụ.</div>
                                }
                            </div>

                            <div class="text-danger">@Html.ValidationMessage("ServiceIds")</div>
                        </div>

                        <div class="mb-3">
                            <div class="pc-label">Ghi chú</div>
                            <textarea class="pc-textarea" asp-for="Notes" placeholder="Mô tả tình trạng thú cưng, yêu cầu đặc biệt..."></textarea>
                            <div class="text-danger">@Html.ValidationMessageFor(m => m.Notes)</div>
                        </div>

                        <div class="pc-actions">
                            <a class="pc-btn" href="@Url.Action("MyAppointments", "CusAppointment")#servicesArea">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>

                            <button type="submit" class="pc-btn pc-btn--primary">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- RIGHT: GUIDE -->
            <div class="pc-side">
                <div class="pc-steps">
                    <div class="pc-steps__head">
                        <i class="fas fa-info-circle"></i> Quy trình đơn giản
                    </div>

                    <div class="pc-step">
                        <div class="pc-step__n">1</div>
                        <div>
                            <div class="pc-step__t">Cập nhật thời gian</div>
                            <div class="pc-step__d">Chọn lại ngày giờ khám phù hợp với bạn.</div>
                        </div>
                    </div>

                    <div class="pc-step">
                        <div class="pc-step__n">2</div>
                        <div>
                            <div class="pc-step__t">Chọn lại dịch vụ</div>
                            <div class="pc-step__d">Tick các dịch vụ muốn khám (có thể nhiều dịch vụ).</div>
                        </div>
                    </div>

                    <div class="pc-step">
                        <div class="pc-step__n">3</div>
                        <div>
                            <div class="pc-step__t">Ghi chú</div>
                            <div class="pc-step__d">Mô tả tình trạng thú cưng để bác sĩ chuẩn bị tốt hơn.</div>
                        </div>
                    </div>

                    <div class="pc-step">
                        <div class="pc-step__n">4</div>
                        <div>
                            <div class="pc-step__t">Xác nhận</div>
                            <div class="pc-step__d">Nhấn “Lưu thay đổi”. Hệ thống giữ nguyên trạng thái hiện tại.</div>
                        </div>
                    </div>

                    <div class="pc-step" style="background:#fff;">
                        <div class="pc-step__n"><i class="fas fa-clock"></i></div>
                        <div>
                            <div class="pc-step__t">Lưu ý 24h</div>
                            <div class="pc-step__d">Nếu quá 24h từ lúc tạo lịch, hệ thống sẽ không cho chỉnh sửa.</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>