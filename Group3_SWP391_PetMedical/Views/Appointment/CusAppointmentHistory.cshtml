<section class="container py-4" id="servicesArea">
    <div class="pc-wrap" style="margin-top:150px;">

        <h3 class="pc-title">Lịch sử khám bệnh</h3>
        <p class="pc-sub">Tra cứu lịch đã khám theo ngày và dịch vụ</p>

        <div class="pc-filter">
            <form method="get" asp-controller="CusAppointment" asp-action="AppointmentHistory" class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <div class="pc-label">Từ khóa</div>
                    <input class="form-control pc-input"
                           name="q"
                           value="@Model.Filter.Q"
                           placeholder="Tên thú cưng / bác sĩ / ghi chú..." />
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Từ ngày</div>
                    <input type="date" class="form-control pc-input" name="fromDate" value="@fromVal" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Đến ngày</div>
                    <input type="date" class="form-control pc-input" name="toDate" value="@toVal" />
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="pc-label">Dịch vụ</div>
                    <select class="form-select pc-select" name="serviceId">
                        @foreach (var opt in Model.ServiceOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Selected ? "selected" : null)">
                                @opt.Text
                            </option>
                        }
                    </select>
                </div>

                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@Model.Filter.PageSize" />

                <div class="col-12 mt-2">
                    <div class="pc-actions">
                        <a class="pc-btn pc-btn--ghost"
                           href="@Url.Action("AppointmentHistory", "CusAppointment")#servicesArea">
                            <i class="fas fa-undo-alt"></i> Làm mới
                        </a>

                        <button type="submit" class="pc-btn pc-btn--primary">
                            <i class="fas fa-filter"></i> Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (!Model.Page.Data.Items.Any())
        {
            <div class="alert alert-info mb-0" style="border-radius:14px;">
                Chưa có lịch sử khám phù hợp.
            </div>
        }
        else
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:180px;">Ngày khám</th>
                            <th>Thú cưng</th>
                            <th>Bác sĩ</th>
                            <th>Dịch vụ</th>
                            <th style="width:140px;">Trạng thái</th>
                            <th style="width:140px;" class="text-end">Tổng tiền</th>
                            <th style="width:220px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    @foreach (var item in Model.Page.Data.Items)
                    {
                        decimal totalFromBasePrice = 0m;
                        var _itemDate = item.CreatedAt;

                        if (!string.IsNullOrWhiteSpace(item.ServiceNames))
                        {
                            var names = item.ServiceNames
                            .Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(x => x.Trim())
                            .ToList();

                            foreach (var n in names)
                            {
                                var svc = _allSvcs.FirstOrDefault(x =>
                                string.Equals(x.service_name?.Trim(), n, StringComparison.OrdinalIgnoreCase));

                                if (svc != null)
                                {
                                    totalFromBasePrice += getEffectivePrice(svc, _itemDate);
                                }
                            }
                        }

                        <tbody class="pc-record">
                            <tr>
                                <td>
                                    @item.AppointmentDate.ToString("dd/MM/yyyy") (@(item.AppointmentDate.Hour < 12 ? "Ca Sáng" : "Ca Chiều"))
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="pc-note-inline">
                                            <strong>Ghi chú:</strong> @item.Notes
                                        </div>
                                    }
                                </td>

                                <td><strong>@item.PetName</strong></td>
                                <td>@item.DoctorName</td>
                                <td>@item.ServiceNames</td>

                                <td>
                                    <span class="pc-badge @GetStatusClass(item.Status)">
                                        <i class="fas fa-check-circle"></i>
                                        @item.Status
                                    </span>
                                </td>

                                <td class="text-end pc-money">
                                    @totalFromBasePrice.ToString("N0")
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        @if (CanViewMedicalRecord(item.Status))
                                        {
                                            <a class="pc-btn-record"
                                               title="Xem bệnh án"
                                               href="javascript:void(0)"
                                               onclick="openMedicalRecord(@item.AppointmentId)">
                                                <i class="fas fa-file-medical-alt"></i>
                                                <span>Bệnh án</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="pc-btn-record pc-btn-record--disabled"
                                                  title="Chưa có bệnh án">
                                                <i class="fas fa-file-medical-alt"></i>
                                                <span>Bệnh án</span>
                                            </span>
                                        }

                                        @if (IsPaidStatus(item.Status))
                                        {
                                            @if (item.HasFeedback)
                                            {
                                                <span class="pc-feedback-done">
                                                    <i class="fas fa-check-circle"></i> Đã Đánh Giá
                                                </span>
                                            }
                                            else
                                            {
                                                <a asp-controller="Feedback"
                                                   asp-action="Create"
                                                   asp-route-appointmentId="@item.AppointmentId"
                                                   class="pc-btn pc-btn--primary pc-btn--sm">
                                                    <i class="fas fa-comment-dots"></i> Đánh Giá
                                                </a>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>

            <div class="mt-3">
                @await Html.PartialAsync("_Pager",
                (action: "AppointmentHistory",
                controller: "CusAppointment",
                q: Model.Filter.Q,
                pager: pagerObj))
        </div>

        <div class="text-center mt-2" style="color: var(--pc-muted); font-size:0.95rem;">
            Tổng: <strong>@Model.Page.Data.TotalItems</strong> lịch khám
        </div>
                }
    </div>
</section>

<div class="modal fade pc-modal" id="medicalRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="pc-modal-title">Bệnh án</div>
                    <div class="pc-modal-sub">Thông tin khám, dịch vụ phát sinh và đơn thuốc</div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="forceCloseModal('medicalRecordModal')"></button>
            </div>

            <div class="modal-body">
                <iframe id="medicalRecordFrame" src="about:blank"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openMedicalRecord(id) {
            const url = '/CusAppointment/MedicalRecord?id=' + id + '&popup=1';
            document.getElementById('medicalRecordFrame').src = url;

            const modalEl = document.getElementById('medicalRecordModal');
            if (window.bootstrap && bootstrap.Modal) {
                const modal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });
                modal.show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
                modalEl.removeAttribute('aria-hidden');
                document.body.classList.add('modal-open');
            }
        }

        function forceCloseModal(id) {
            const modalEl = document.getElementById(id);
            if (!modalEl) return;

            if (window.bootstrap && bootstrap.Modal) {
                const inst = bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide();
                else new bootstrap.Modal(modalEl).hide();
            } else {
                modalEl.classList.remove('show');
                modalEl.style.display = 'none';
                modalEl.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('modal-open');
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
            }
        }
    </script>
}