@using Group3_SWP391_PetMedical.Models.Common
@using Group3_SWP391_PetMedical.Services.Interfaces
@model Group3_SWP391_PetMedical.ViewModels.Appointment.CusAppointmentHistoryListVM
@inject IServiceService ServiceService

@{
    ViewData["Title"] = "Lịch sử khám bệnh";

    var pagerObj = new PagedResult<object>
    {
        Items = Model.Page.Data.Items.Cast<object>().ToList(),
        Page = Model.Page.Data.Page,
        PageSize = Model.Page.Data.PageSize,
        TotalItems = Model.Page.Data.TotalItems
    };

    var fromVal = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toVal = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? "";

    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();

    // Check discount against appointment date, not current time
    Func<Group3_SWP391_PetMedical.Models.Service, DateTime, decimal> getEffectivePrice = (svc, refDate) =>
    {
        var disc = svc.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= refDate && sd.end_date >= refDate && (sd.created_at ?? DateTime.MinValue) <= refDate);
        if (disc != null) return svc.base_price * (1 - (decimal)disc.discount_percent / 100);
        return svc.base_price;
    };
}

@functions {
    public static string NormalizeStatus(string? status)
    {
        return (status ?? "").Trim().ToLower();
    }

    public static string GetStatusClass(string? status)
    {
        var s = NormalizeStatus(status);

        return s switch
        {
            "chờ xác nhận" => "pc-badge--pending",
            "đặt lịch thành công" => "pc-badge--success",
            "đã hủy" => "pc-badge--cancelled",
            "đã đến" => "pc-badge--arrived",
            "không đến" => "pc-badge--noshow",
            "đang khám" => "pc-badge--examining",
            "đã khám" => "pc-badge--examined",
            "đã thanh toán" => "pc-badge--paid",
            _ => "pc-badge--default"
        };
    }

    public static bool IsPaidStatus(string? status)
    {
        return NormalizeStatus(status) == "đã thanh toán";
    }

    public static bool CanViewMedicalRecord(string? status)
    {
        var s = NormalizeStatus(status);
        return s == "đã khám" || s == "đã thanh toán";
    }
}

@section Styles {
