@using Group3_SWP391_PetMedical.Models.Common
@using Group3_SWP391_PetMedical.Services.Interfaces
@model Group3_SWP391_PetMedical.ViewModels.Appointment.CusAppointmentHistoryListVM
@inject IServiceService ServiceService

@{
    ViewData["Title"] = "Lịch sử khám bệnh";

    var pagerObj = new PagedResult<object>
    {
        Items = Model.Page.Data.Items.Cast<object>().ToList(),
        Page = Model.Page.Data.Page,
        PageSize = Model.Page.Data.PageSize,
        TotalItems = Model.Page.Data.TotalItems
    };

    var fromVal = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toVal = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? "";

    //  lấy đúng base_price
    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();
@functions {
    public static string NormalizeStatus(string? status)
    {
        return (status ?? "").Trim().ToLower();
    }

    public static string GetStatusClass(string? status)
    {
        var s = NormalizeStatus(status);

        return s switch
        {
            "chờ xác nhận" => "pc-badge--pending",
            "đặt lịch thành công" => "pc-badge--success",
            "đã hủy" => "pc-badge--cancelled",
            "đã đến" => "pc-badge--arrived",
            "không đến" => "pc-badge--noshow",
            "đang khám" => "pc-badge--examining",
            "đã khám" => "pc-badge--examined",
            "đã thanh toán" => "pc-badge--paid",
            _ => "pc-badge--default"
        };
    }
}
}

@section Styles {
    <style>

        :root {
            --pc-red: #ff3b3b;
            --pc-red-dark: #e83434;
            --pc-pink: #fff2f2;
            --pc-text: #2b2b2b;
            --pc-muted: #7a7a7a;
            --pc-border: rgba(0,0,0,0.06);
        }

        /* wrapper */
        .pc-wrap {
            /* background: linear-gradient(180deg, var(--pc-pink), #fff); */
            background: #f3d7d5;
            border: 1px solid var(--pc-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
        }

        .pc-title {
            font-weight: 800;
            margin: 0;
        }

        .pc-sub {
            color: var(--pc-muted);
            margin: 0;
        }

        /* filter */
        .pc-filter {
            background: #fff;
            border: 1px solid var(--pc-border);
            border-radius: 16px;
            padding: 18px;
            margin: 18px 0;
            box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        }

        .pc-label {
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        /* inputs */
        .pc-input, .pc-select {
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,0.10);
            height: 42px;
            padding: 0 12px;
        }

            /* FIX dropdown căn giữa */
            .pc-select.form-select {
                line-height: 42px !important;
                padding-top: 0 !important;
                padding-bottom: 0 !important;
                background-position: right 12px center;
            }

        /* buttons */
        .pc-btn {
            border-radius: 999px;
            padding: 0 18px;
            height: 42px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
        }

        .pc-btn--primary {
            background: var(--pc-red);
            color: #fff;
            box-shadow: 0 10px 20px rgba(255,59,59,0.25);
        }

            .pc-btn--primary:hover {
                background: var(--pc-red-dark);
                color: #fff;
            }

        .pc-btn--ghost {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.10);
            color: var(--pc-text) !important;
            min-width: 140px;
            white-space: nowrap;
        }

        /* table */
        .pc-table {
            border-radius: 16px;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--pc-border);
            box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        }

            .pc-table thead th {
                background: #fff7f7;
                font-weight: 800;
            }

        .pc-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 800;
            font-size: 0.85rem;
            border: 1px solid rgba(0,0,0,0.04);
            box-shadow: none;
        }

            .pc-badge i {
                color: inherit !important;
            }

        /* Chờ xác nhận */
        .pc-badge--pending {
            background: #fef3c7;
            color: #b45309;
        }

        /* Đặt lịch thành công */
        .pc-badge--success {
            background: #d1fae5;
            color: #047857;
        }

        /* Đã hủy */
        .pc-badge--cancelled {
            background: #fee2e2;
            color: #dc2626;
        }

        /* Đã đến */
        .pc-badge--arrived {
            background: #e0e7ff;
            color: #4338ca;
        }

        /* Không đến */
        .pc-badge--noshow {
            background: #f3f4f6;
            color: #6b7280;
        }

        /* Đang khám */
        .pc-badge--examining {
            background: #fce7f3;
            color: #be185d;
        }

        /* Đã khám */
        .pc-badge--examined {
            background: #ede9fe;
            color: #6d28d9;
        }

        /* Đã thanh toán - dùng màu xanh của status Đặt lịch cũ */
        .pc-badge--paid {
            background: #e0f2fe;
            color: #0369a1;
        }

        .pc-badge--default {
            background: #f3f4f6;
            color: #6b7280;
        }

        .pc-money {
            font-weight: 900;
        }

        /* ==== nút & khoảng cách ==== */
        .pc-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .pc-actions .pc-btn--primary {
                margin-left: auto;
                min-width: 110px;
            }

        /* ==== Pager override ==== */
        .pc-pager.pagination {
            gap: 10px;
            margin: 0;
        }

        .pc-pager .page-item .page-link {
            border-radius: 999px !important;
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
            border: 1px solid rgba(0,0,0,0.10);
            color: var(--pc-text);
            background: #fff;
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
        }

            .pc-pager .page-item .page-link:hover {
                border-color: rgba(255,59,59,0.35);
                box-shadow: 0 10px 22px rgba(255,59,59,0.12);
                color: var(--pc-red-dark);
            }

        .pc-pager .page-item.active .page-link {
            background: var(--pc-red) !important;
            border-color: var(--pc-red) !important;
            color: #fff !important;
            box-shadow: 0 12px 24px rgba(255,59,59,0.25);
        }

        .pc-pager .page-item.disabled .page-link {
            opacity: 0.45;
            pointer-events: none;
            box-shadow: none;
        }

        @@media (max-width: 576px) {
            .pc-pager .page-item .page-link {
                width: 38px;
                height: 38px;
            }
        }

        /* ===== Ghi chú gộp chung ===== */
        .pc-note-inline {
            margin-top: 6px;
            font-size: 0.9rem;
            color: var(--pc-muted);
        }

        /* Hover toàn bộ record */
        tbody.pc-record {
            transition: background 0.25s ease;
        }

            tbody.pc-record:hover tr {
                background: #fff3f3 !important;
            }
    </style>
}

<section class="container py-4" id="servicesArea">
    <div class="pc-wrap" style="margin-top:150px;">

        <h3 class="pc-title">Lịch sử khám bệnh</h3>
        <p class="pc-sub">Tra cứu lịch đã khám theo ngày và dịch vụ</p>

        <!-- FILTER -->
        <div class="pc-filter">
            <form method="get" asp-controller="CusAppointment" asp-action="AppointmentHistory" class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <div class="pc-label">Từ khóa</div>
                    <input class="form-control pc-input"
                           name="q"
                           value="@Model.Filter.Q"
                           placeholder="Tên thú cưng / bác sĩ / ghi chú..." />
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Từ ngày</div>
                    <input type="date" class="form-control pc-input" name="fromDate" value="@fromVal" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Đến ngày</div>
                    <input type="date" class="form-control pc-input" name="toDate" value="@toVal" />
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="pc-label">Dịch vụ</div>
                    <select class="form-select pc-select" name="serviceId">
                        @foreach (var opt in Model.ServiceOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Selected ? "selected" : null)">
                                @opt.Text
                            </option>
                        }
                    </select>
                </div>

                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@Model.Filter.PageSize" />

                <div class="col-12 mt-2">
                    <div class="pc-actions">
                        <a class="pc-btn pc-btn--ghost"
                           href="@Url.Action("AppointmentHistory", "CusAppointment")#servicesArea">
                            <i class="fas fa-undo-alt"></i> Làm mới
                        </a>

                        <button type="submit" class="pc-btn pc-btn--primary">
                            <i class="fas fa-filter"></i> Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- LIST -->
        @if (!Model.Page.Data.Items.Any())
        {
            <div class="alert alert-info mb-0" style="border-radius:14px;">
                Chưa có lịch sử khám phù hợp.
            </div>
        }
        else
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:180px;">Ngày khám</th>
                            <th>Thú cưng</th>
                            <th>Bác sĩ</th>
                            <th>Dịch vụ</th>
                            <th style="width:140px;">Trạng thái</th>
                            <th style="width:140px;" class="text-end">Tổng tiền</th>
                        </tr>
                    </thead>

                    @foreach (var item in Model.Page.Data.Items)
                    {
                        // ✅ NEW: tính tổng tiền theo base_price từ ServiceNames (không dùng item.TotalAmount)
                        decimal totalFromBasePrice = 0m;

                        if (!string.IsNullOrWhiteSpace(item.ServiceNames))
                        {
                            var names = item.ServiceNames
                            .Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(x => x.Trim())
                            .ToList();

                            foreach (var n in names)
                            {
                                var svc = _allSvcs.FirstOrDefault(x =>
                                string.Equals(x.service_name?.Trim(), n, StringComparison.OrdinalIgnoreCase));

                                if (svc != null)
                                {
                                    totalFromBasePrice += (decimal)svc.base_price;
                                }
                            }
                        }

                        <tbody class="pc-record">
                            <tr>
                                <td>
                                    @item.AppointmentDate.ToString("HH:mm dd/MM/yyyy")
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="pc-note-inline">
                                            <strong>Ghi chú:</strong> @item.Notes
                                        </div>
                                    }
                                </td>

                                <td><strong>@item.PetName</strong></td>
                                <td>@item.DoctorName</td>
                                <td>@item.ServiceNames</td>

                                <td>
                                    <span class="pc-badge @GetStatusClass(item.Status)">
                                        <i class="fas fa-check-circle"></i>
                                        @item.Status
                                    </span>
                                </td>

                                <td class="text-end pc-money">
                                    @totalFromBasePrice.ToString("N0")
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>

            <div class="mt-3">
                @await Html.PartialAsync("_Pager",
                (action: "AppointmentHistory",
                controller: "CusAppointment",
                q: Model.Filter.Q,
                pager: pagerObj))
        </div>

        <div class="text-center mt-2" style="color: var(--pc-muted); font-size:0.95rem;">
            Tổng: <strong>@Model.Page.Data.TotalItems</strong> lịch khám
        </div>
                }
    </div>
</section>