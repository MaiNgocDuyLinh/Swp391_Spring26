@model Group3_SWP391_PetMedical.ViewModels.Appointment.CusCreateAppointmentVM
@using Group3_SWP391_PetMedical.Services.Interfaces
@inject IServiceService ServiceService

@{
    ViewData["Title"] = "Đặt lịch ngay";

    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();
    var _priceMap = _allSvcs.ToDictionary(x => x.service_id, x => (decimal)x.base_price);

    var dateVal = Model.Form.AppointmentDate == default
        ? ""
        : Model.Form.AppointmentDate.ToString("yyyy-MM-dd");

    var shiftKey = (Model.Form.Shift ?? "").Trim().ToLowerInvariant();

    // Tính giá sau giảm (nếu có discount đang active)
    Func<Group3_SWP391_PetMedical.Models.Service, decimal> getEffectivePrice = (svc) =>
    {
        var disc = svc.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= DateTime.Now && sd.end_date >= DateTime.Now);
        if (disc != null) return svc.base_price * (1 - (decimal)disc.discount_percent / 100);
        return svc.base_price;
    };

    var _priceMap1 = _allSvcs.ToDictionary(x => x.service_id, x => getEffectivePrice(x));
    var _originalPriceMap = _allSvcs.ToDictionary(x => x.service_id, x => (decimal)x.base_price);
    var _discountMap = _allSvcs.ToDictionary(x => x.service_id, x => x.ServiceDiscounts?.FirstOrDefault(sd => sd.is_active == true && sd.start_date <= DateTime.Now && sd.end_date >= DateTime.Now));
}

<style>
    .pc-hero {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        background: linear-gradient(90deg, rgba(255, 216, 216, 0.75) 0%, rgba(255,255,255,0.92) 55%, rgba(255,255,255,0.95) 100%);
        box-shadow: 0 12px 30px rgba(0,0,0,.06);
        padding: 32px;
    }

        .pc-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(0,0,0,.04) 1px, transparent 1px);
            background-size: 18px 18px;
            opacity: .35;
            pointer-events: none;
        }

    .pc-hero-inner {
        position: relative;
        z-index: 1;
    }

    .pc-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(0,0,0,.06);
        font-weight: 600;
    }

    .pc-title {
        font-size: 44px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 14px 0 8px;
        color: #111;
    }

    .pc-sub {
        color: rgba(0,0,0,.62);
        max-width: 520px;
        margin-bottom: 18px;
        line-height: 1.6;
    }

    .pc-card {
        border-radius: 22px;
        border: 1px solid rgba(0,0,0,.06);
        box-shadow: 0 12px 30px rgba(0,0,0,.07);
        overflow: hidden;
        background: #fff;
    }

    .pc-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid rgba(0,0,0,.06);
        background: rgba(255, 246, 246, .7);
        font-weight: 800;
    }

    .pc-card-body {
        padding: 20px;
    }

    .pc-field label {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .pc-input, .pc-select, .pc-textarea {
        border-radius: 14px !important;
        border: 1px solid rgba(0,0,0,.10) !important;
        padding: 12px 14px !important;
        box-shadow: none !important;
    }

        .pc-input:focus, .pc-select:focus, .pc-textarea:focus {
            border-color: rgba(255, 59, 59, .65) !important;
            outline: none !important;
        }

    .pc-services-box {
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,.08);
        padding: 14px 14px;
        max-height: 260px;
        overflow: auto;
        background: rgba(255, 246, 246, .35);
    }

    .pc-service-item2 {
        padding: 10px 12px;
        border-radius: 14px;
        background: rgba(255,255,255,.90);
        border: 1px solid rgba(0,0,0,.06);
        margin-bottom: 10px;
    }

        .pc-service-item2:last-child {
            margin-bottom: 0;
        }

        .pc-service-item2 .form-check-input {
            margin-top: .25rem;
        }

    .pc-btn-primary {
        border: 0;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 800;
        background: #ff2e2e;
        color: #fff;
        box-shadow: 0 10px 18px rgba(255,46,46,.20);
    }

        .pc-btn-primary:hover {
            filter: brightness(.95);
            color: #fff;
        }

    .pc-btn-ghost {
        border-radius: 999px;
        padding: 12px 16px;
        font-weight: 800;
        border: 1px solid rgba(0,0,0,.12);
        background: #fff;
        color: #111;
    }

    .pc-note {
        font-size: 13px;
        color: rgba(0,0,0,.55);
        margin-top: 10px;
    }

    .pc-visual {
        border-radius: 24px;
        min-height: 320px;
        background: radial-gradient(circle at 20% 30%, rgba(255, 46, 46, .12), transparent 55%), radial-gradient(circle at 70% 60%, rgba(0, 0, 0, .06), transparent 60%), linear-gradient(135deg, rgba(255,255,255,.75), rgba(255,255,255,.35));
        border: 1px solid rgba(0,0,0,.06);
        position: relative;
        overflow: hidden;
    }

        .pc-visual::after {
            content: "";
            position: absolute;
            right: -80px;
            bottom: -80px;
            width: 220px;
            height: 220px;
            background: rgba(255,46,46,.12);
            border-radius: 999px;
            filter: blur(2px);
        }

    .pc-visual-inner {
        position: relative;
        z-index: 1;
        padding: 18px;
    }

    .pc-steps {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
    }

    .pc-step {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        background: rgba(255,255,255,.86);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 18px;
        padding: 12px 14px;
    }

    .pc-step-num {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        background: rgba(255,46,46,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        color: #ff2e2e;
        flex: 0 0 auto;
    }

    .pc-select {
        width: 100% !important;
        height: 48px !important;
        border-radius: 14px !important;
        border: 1px solid rgba(0,0,0,.10) !important;
        padding: 0 14px !important;
        background-color: #fff !important;
        line-height: 48px !important;
    }

    .pc-equal-control {
        width: 100% !important;
        height: 50px !important;
        border-radius: 18px !important;
        border: 1px solid rgba(0,0,0,.12) !important;
        padding: 0 16px !important;
        font-size: 15px !important;
        background-color: #fff !important;
    }

    select.pc-equal-control {
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
    }

    .pc-equal-control:focus {
        outline: none !important;
        border-color: #ff3b3b !important;
        box-shadow: none !important;
    }

    .pc-field .form-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .pc-cal-list {
        list-style: none;
        padding-left: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pc-cal-item {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 14px;
        background: rgba(255,255,255,.92);
        padding: 10px 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .pc-cal-date {
        font-weight: 800;
    }

    .pc-cal-time {
        font-weight: 700;
        color: rgba(0,0,0,.65);
        white-space: nowrap;
    }

    .pc-svc-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .pc-svc-price {
        font-weight: 800;
        color: rgba(0,0,0,.70);
        white-space: nowrap;
    }

    .pc-total-box {
        margin-top: 10px;
        border-radius: 14px;
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(0,0,0,.06);
        padding: 12px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        font-weight: 800;
    }
   
</style>

<div class="container my-4">
    <div class="pc-hero" style="margin-top : 150px;">
        <div class="pc-hero-inner">
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-7">

                    <div class="pc-badge">
                        <i class="fas fa-calendar-check"></i>
                        <span>Đặt lịch khám nhanh • PetCare</span>
                    </div>

                    <div class="pc-title">Đặt lịch ngay</div>
                    <div class="pc-sub">
                        Chọn thú cưng, ngày khám, ca khám và dịch vụ mong muốn.
                        Hệ thống sẽ tạo lịch với trạng thái <b>Đặt lịch thành công</b>.
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="pc-card">
                        <div class="pc-card-header">
                            Thông tin lịch hẹn
                        </div>
                        <div class="pc-card-body">
                            <form method="post" asp-action="Book" asp-controller="CusAppointment">
                                @Html.AntiForgeryToken()

                                <div class="row g-3 mt-1">
                                    <div class="col-lg-6 pc-field">
                                        <label class="form-label">Ngày khám</label>
                                        <input class="form-control pc-equal-control"
                                               asp-for="Form.AppointmentDate"
                                               type="date"
                                               value="@dateVal"
                                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                        <span class="text-danger" asp-validation-for="Form.AppointmentDate"></span>
                                    </div>

                                    <div class="col-lg-6 pc-field">
                                        <label class="form-label">Ca khám</label>
                                        <select class="form-control pc-equal-control" id="Form_Shift" name="Form.Shift">
                                            <option value="">-- Chọn ca khám --</option>
                                            <option value="sáng" selected="@(shiftKey == "sáng" || shiftKey == "sang")">Ca sáng</option>
                                            <option value="chiều" selected="@(shiftKey == "chiều" || shiftKey == "chieu")">Ca chiều</option>
                                        </select>
                                        <span class="text-danger" asp-validation-for="Form.Shift"></span>
                                    </div>
                                </div>

                                <div class="col-12 pc-field mt-3" style="padding: 0">
                                    <label class="form-label">Bác sĩ</label>

                                    <select class="form-control pc-equal-control"
                                            id="doctorSelect"
                                            asp-for="Form.DoctorId"
                                            asp-items="Model.DoctorOptions">
                                    </select>

                                    <span class="text-danger" asp-validation-for="Form.DoctorId"></span>

                                    <div class="pc-note mt-2" id="doctorHint">
                                        Không chọn bác sĩ sẽ hiển thị <b>Chưa phân công</b>. Bấm "Xem lịch bác sĩ" để hiển thị ca sáng / chiều trong ngày đã chọn.
                                    </div>

                                    <button type="submit"
                                            class="pc-btn-ghost mt-2"
                                            formmethod="get"
                                            formnovalidate
                                            formaction="@Url.Action("Book", "CusAppointment")">
                                        Xem lịch bác sĩ
                                    </button>
                                    <div id="rightDoctorBox" class="mt-3">
                                <div class="pc-badge" style="margin-bottom:10px;">
                                    <i class="far fa-calendar-alt"></i>
                                    <span>Lịch khám / ca làm của bác sĩ</span>
                                </div>

                                <div class="pc-step" style="flex-direction:column; gap:10px;">
                                    <div style="font-weight:800;">Các ca trong ngày đã chọn</div>

                                    <div class="pc-services-box" style="max-height:260px; width:100%;">
                                        <ul class="pc-cal-list">
                                            @if (Model.Form.DoctorId.HasValue && Model.Form.AppointmentDate != default && Model.DoctorShifts.Any())
                                            {
                                                foreach (var s in Model.DoctorShifts)
                                                {
                                                    <li class="pc-cal-item">
                                                        <span class="pc-cal-date">@s.Start.ToString("dd/MM/yyyy")</span>
                                                        <span class="pc-cal-time">@s.Shift</span>
                                                    </li>
                                                }
                                            }
                                            else if (Model.Form.DoctorId.HasValue && Model.Form.AppointmentDate != default)
                                            {
                                                <li class="pc-cal-item">
                                                    <span class="pc-cal-date">Không có ca làm cho ngày này.</span>
                                                    <span class="pc-cal-time"></span>
                                                </li>
                                            }
                                            else if (Model.Form.AppointmentDate == default)
                                            {
                                                <li class="pc-cal-item">
                                                    <span class="pc-cal-date">Chưa chọn ngày khám.</span>
                                                    <span class="pc-cal-time"></span>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="pc-cal-item">
                                                    <span class="pc-cal-date">Chưa chọn bác sĩ.</span>
                                                    <span class="pc-cal-time"></span>
                                                </li>
                                            }
                                        </ul>
                                    </div>

                                    <div class="pc-note">
                                        Chọn ngày khám, sau đó chọn bác sĩ để xem ca sáng / chiều trong ngày đó. <br />
                                        <span style="color:red;">* Mỗi ca làm của bác sĩ chỉ khám tối đa 5 lịch hẹn</span>
                                    </div>
                                </div>
                            </div>
                                    @if (!string.IsNullOrWhiteSpace(Model.ShiftCapacityWarning))
                                    {
                                        <div class="mt-2"
                                             style="border:1px solid #f5c2c7; background:#fff3cd; color:#856404; border-radius:14px; padding:10px 14px; font-weight:600;">
                                            @Model.ShiftCapacityWarning
                                        </div>
                                    }
                                </div>

                                <div class="row g-3">
                                    <div class="col-lg-6 pc-field">
                                        <label class="form-label">Thú cưng</label>

                                        <select class="form-control pc-equal-control"
                                                asp-for="Form.PetId"
                                                asp-items="Model.PetOptions">
                                            <option value="0">-- Chọn thú cưng --</option>
                                        </select>
                                        <span class="text-danger" asp-validation-for="Form.PetId"></span>
                                    </div>

                                    <div class="col-12 pc-field">
                                        <label class="form-label">Dịch vụ</label>

                                        <div class="pc-services-box">
                                            @for (int i = 0; i < Model.ServiceOptions.Count; i++)
                                            {
                                                var s = Model.ServiceOptions[i];
                                                var sid = int.Parse(s.Value);
                                                var isChecked = Model.Form.ServiceIds != null && Model.Form.ServiceIds.Contains(sid);
                                                var inputId = $"svc_{sid}";
                                                var price = _priceMap1.ContainsKey(sid) ? _priceMap1[sid] : 0m;
                                                var origPrice = _originalPriceMap.ContainsKey(sid) ? _originalPriceMap[sid] : 0m;
                                                var discInfo = _discountMap.ContainsKey(sid) ? _discountMap[sid] : null;

                                                <div class="pc-service-item2">
                                                    <div class="form-check m-0 pc-svc-row">
                                                        <div>
                                                            <input class="form-check-input svc-cb"
                                                                   id="@inputId"
                                                                   type="checkbox"
                                                                   name="Form.ServiceIds"
                                                                   value="@sid"
                                                                   data-price="@price"
                                                                   @(isChecked ? "checked" : "") />
                                                            <label class="form-check-label" for="@inputId">
                                                                @s.Text
                                                                @if (discInfo != null)
                                                                {
                                                                    <span style="background:#dc2626; color:#fff; padding:1px 6px; border-radius:999px; font-size:0.7rem; font-weight:800; margin-left:4px;">-@discInfo.discount_percent%</span>
                                                                }
                                                            </label>
                                                        </div>

                                                        <div class="pc-svc-price">
                                                            @if (discInfo != null)
                                                            {
                                                                <small style="text-decoration:line-through; color:rgba(0,0,0,.40); margin-right:4px;">@origPrice.ToString("N0")</small>
                                                                <span style="color:#dc2626; font-weight:900;">@price.ToString("N0") VNĐ</span>
                                                            }
                                                            else
                                                            {
                                                                @price.ToString("N0") <text>VNĐ</text>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <span class="text-danger" asp-validation-for="Form.ServiceIds"></span>
                                        <div class="pc-note">Gợi ý: bạn có thể chọn nhiều dịch vụ trong một lần khám.</div>

                                        <div class="pc-total-box" id="totalBox">
                                            <div>Tổng tiền</div>
                                            <div id="totalMoney">0 VNĐ</div>
                                        </div>
                                    </div>

                                    <div class="col-12 pc-field">
                                        <label>Ghi chú</label>
                                        <textarea class="form-control pc-textarea" asp-for="Form.Notes" rows="3"
                                                  placeholder="Mô tả tình trạng thú cưng, yêu cầu đặc biệt..."></textarea>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mt-3" style="gap: 30px;">
                                    <button type="submit" class="pc-btn-primary">
                                        <i class="fas fa-calendar-plus me-1"></i> Đặt lịch
                                    </button>

                                    <a class="pc-btn-ghost" asp-action="MyAppointments" asp-controller="CusAppointment">
                                        <i class="far fa-clock me-1"></i> Lịch đã đặt
                                    </a>

                                    <a class="pc-btn-ghost" asp-action="AppointmentHistory" asp-controller="CusAppointment">
                                        <i class="fas fa-history me-1"></i> Lịch sử khám
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="pc-visual h-100">
                        <div class="pc-visual-inner">
                            <div class="pc-badge">
                                <i class="fas fa-shield-alt"></i>
                                <span>Quy trình đơn giản</span>
                            </div>

                            <div class="pc-steps">
                                <div class="pc-step">
                                    <div class="pc-step-num">1</div>
                                    <div>
                                        <div style="font-weight:800;">Chọn ngày khám</div>
                                        <div style="color:rgba(0,0,0,.60); font-size:13px;">Chọn ngày mà bạn muốn khám </div>
                                    </div>
                                </div>
                                <div class="pc-step">
                                    <div class="pc-step-num">2</div>
                                    <div>
                                        <div style="font-weight:800;">Chọn ca khám</div>
                                        <div style="color:rgba(0,0,0,.60); font-size:13px;">Chọn theo ca <b>sáng</b> hoặc <b>chiều</b></div>
                                    </div>
                                </div>

                                <div class="pc-step">
                                    <div class="pc-step-num">3</div>
                                    <div>
                                        <div style="font-weight:800;">Chọn bác sĩ</div>
                                        <div style="color:rgba(0,0,0,.60); font-size:13px;">Bấm "Xem lịch bác sĩ" để xem bác sĩ có ca sáng / chiều trong ngày bạn chọn hay không.</div>
                                    </div>
                                </div>

                                <div class="pc-step">
                                    <div class="pc-step-num">4</div>
                                    <div>
                                        <div style="font-weight:800;">Chọn thú cưng</div>
                                        <div style="color:rgba(0,0,0,.60); font-size:13px;">Chỉ hiển thị thú cưng thuộc tài khoản.</div>
                                    </div>
                                </div>

                                <div class="pc-step">
                                    <div class="pc-step-num">5</div>
                                    <div>
                                        <div style="font-weight:800;">Chọn dịch vụ</div>
                                        <div style="color:rgba(0,0,0,.60); font-size:13px;">Có thể chọn nhiều dịch vụ trong một lần khám.</div>
                                    </div>
                                </div>

                                <div class="pc-step">
                                    <div class="pc-step-num">6</div>
                                    <div>
                                        <div style="font-weight:800;">Đặt lịch thành công</div>
                                        <div style="color:rgba(0,0,0,.60); font-size:13px;">Trạng thái mặc định: <b>Đặt lịch thành công</b>.Khách hàng đến phòng khám để nhận vé vào khám .</div>
                                    </div>
                                </div>
                            </div>

                            

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            const params = new URLSearchParams(window.location.search);
            const serviceId = params.get("serviceId");

            if (serviceId) {
                const select = document.querySelector("select[name='Form.ServiceIds']");
                if (select) {
                    select.value = serviceId;
                    select.dispatchEvent(new Event('change'));
                }

                const checkbox = document.querySelector(
                    "input[name='Form.ServiceIds'][value='" + serviceId + "']"
                );
                if (checkbox) {
                    checkbox.checked = true;
                }
            }

            function updateTotal() {
                let total = 0;

                document.querySelectorAll("input[name='Form.ServiceIds'].svc-cb:checked").forEach(cb => {
                    const p = parseFloat(cb.getAttribute("data-price") || "0");
                    if (!isNaN(p)) total += p;
                });

                const fmt = new Intl.NumberFormat('vi-VN');
                document.getElementById("totalMoney").textContent = fmt.format(total) + " VNĐ";
            }

            document.querySelectorAll("input[name='Form.ServiceIds'].svc-cb").forEach(cb => {
                cb.addEventListener("change", updateTotal);
            });

            updateTotal();
        });
    </script>
}