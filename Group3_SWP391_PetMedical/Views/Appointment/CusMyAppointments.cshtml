@using Group3_SWP391_PetMedical.Models.Common
@using Group3_SWP391_PetMedical.Services.Interfaces
@model Group3_SWP391_PetMedical.ViewModels.Appointment.CusBookedAppointmentListVM

@inject IServiceService ServiceService

@{
    ViewData["Title"] = "Lịch khám đã đặt";

    var pagerObj = new PagedResult<object>
    {
        Items = Model.Page.Data.Items.Cast<object>().ToList(),
        Page = Model.Page.Data.Page,
        PageSize = Model.Page.Data.PageSize,
        TotalItems = Model.Page.Data.TotalItems
    };

    var fromVal = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toVal = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? "";

    //  map service_id -> base_price
    var _allSvcs = ServiceService.GetAllAsync().GetAwaiter().GetResult();
    var _priceMap = _allSvcs.ToDictionary(x => x.service_id, x => (decimal)x.base_price);
}

@section Styles {
    <style>
        :root {
            --pc-red: #ff3b3b;
            --pc-red-dark: #e83434;
            --pc-pink: #fff2f2;
            --pc-text: #2b2b2b;
            --pc-muted: #7a7a7a;
            --pc-border: rgba(0,0,0,0.06);
        }

        .pc-wrap {
            background: #f3d7d5;
            border: 1px solid var(--pc-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
        }

        .pc-title {
            font-weight: 800;
            margin: 0;
        }

        .pc-sub {
            color: var(--pc-muted);
            margin: 0;
        }

        .pc-filter {
            background: #fff;
            border: 1px solid var(--pc-border);
            border-radius: 16px;
            padding: 18px;
            margin: 18px 0;
            box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        }

        .pc-label {
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        .pc-input, .pc-select {
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,0.10);
            height: 42px;
            padding: 0 12px;
        }

            .pc-select.form-select {
                line-height: 42px !important;
                padding-top: 0 !important;
                padding-bottom: 0 !important;
                background-position: right 12px center;
            }

        .pc-btn {
            border-radius: 999px;
            padding: 0 18px;
            height: 42px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
        }

        .pc-btn--primary {
            background: var(--pc-red);
            color: #fff;
            box-shadow: 0 10px 20px rgba(255,59,59,0.25);
        }

            .pc-btn--primary:hover {
                background: var(--pc-red-dark);
                color: #fff;
            }

        .pc-btn--ghost {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.10);
            color: var(--pc-text) !important;
            min-width: 140px;
            white-space: nowrap;
        }

        .pc-table {
            border-radius: 16px;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--pc-border);
            box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        }

            .pc-table thead th {
                background: #fff7f7;
                font-weight: 800;
            }

        .pc-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 800;
            font-size: 0.85rem;
            border: 1px solid rgba(0,0,0,0.06);
            background: #fff;
        }

            .pc-badge i {
                color: var(--pc-red);
            }

        .pc-money {
            font-weight: 900;
        }

        .pc-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .pc-actions .pc-btn--primary {
                margin-left: auto;
                min-width: 110px;
            }

        .pc-pager.pagination {
            gap: 10px;
            margin: 0;
        }

        .pc-pager .page-item .page-link {
            border-radius: 999px !important;
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
            border: 1px solid rgba(0,0,0,0.10);
            color: var(--pc-text);
            background: #fff;
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
        }

            .pc-pager .page-item .page-link:hover {
                border-color: rgba(255,59,59,0.35);
                box-shadow: 0 10px 22px rgba(255,59,59,0.12);
                color: var(--pc-red-dark);
            }

        .pc-pager .page-item.active .page-link {
            background: var(--pc-red) !important;
            border-color: var(--pc-red) !important;
            color: #fff !important;
            box-shadow: 0 12px 24px rgba(255,59,59,0.25);
        }

        .pc-pager .page-item.disabled .page-link {
            opacity: 0.45;
            pointer-events: none;
            box-shadow: none;
        }

        @@media (max-width: 576px) {
            .pc-pager .page-item .page-link {
                width: 38px;
                height: 38px;
            }
        }

        .pc-note-inline {
            margin-top: 6px;
            font-size: 0.9rem;
            color: var(--pc-muted);
        }

        tbody.pc-record {
            transition: background 0.25s ease;
        }

            tbody.pc-record:hover tr {
                background: #fff3f3 !important;
            }

        .pc-action-icons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .pc-ico {
            width: 36px;
            height: 36px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,0,0,0.10);
            background: #fff;
            color: var(--pc-text);
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
            text-decoration: none;
            cursor: pointer;
        }

            .pc-ico:hover {
                border-color: rgba(255,59,59,0.35);
                box-shadow: 0 10px 22px rgba(255,59,59,0.12);
                color: var(--pc-red-dark);
            }

        .pc-modal .modal-dialog {
            max-width: 1050px;
        }

        @@media (min-width: 1400px) {
            .pc-modal .modal-dialog {
                max-width: 1150px;
            }
        }

        .pc-modal .modal-content {
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.06);
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.18);
        }

        .pc-modal .modal-header {
            background: #fff;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            padding: 18px 22px;
            position: relative;
            z-index: 5;
        }

        .pc-modal-title {
            font-weight: 900;
            margin: 0;
            font-size: 1.2rem;
        }

        .pc-modal-sub {
            color: var(--pc-muted);
            font-weight: 600;
            margin-top: 4px;
            font-size: 0.95rem;
        }

        .pc-modal .btn-close {
            width: 44px;
            height: 44px;
            border-radius: 999px;
            border: 1px solid rgba(255,59,59,0.30);
            background: #fff;
            opacity: 1;
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
            position: relative;
            z-index: 6;
            /* kill bootstrap default background svg */
            background-image: none !important;
        }

            .pc-modal .btn-close::before {
                content: "×";
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                font-weight: 900;
                line-height: 1;
                color: var(--pc-red);
            }

            .pc-modal .btn-close:hover {
                border-color: rgba(255,59,59,0.70);
                box-shadow: 0 10px 22px rgba(255,59,59,0.12);
                background: #fff7f7;
            }

                .pc-modal .btn-close:hover::before {
                    color: var(--pc-red-dark);
                }

            .pc-modal .btn-close:focus {
                outline: none;
                box-shadow: 0 0 0 0.2rem rgba(255,59,59,0.18);
            }

        .pc-modal .modal-body {
            padding: 0;
            background: #fff;
            position: relative;
            z-index: 1;
        }

        .pc-modal iframe {
            width: 100%;
            height: 72vh;
            border: 0;
            background: #fff;
            display: block;
        }

        @@media (max-width: 992px) {
            .pc-modal iframe {
                height: 78vh;
            }
        }
    </style>
}

<section class="container py-4" id="servicesArea">
    <div class="pc-wrap" style="margin-top:150px;">

        <h3 class="pc-title">Lịch khám đã đặt</h3>
        <p class="pc-sub">Tra cứu lịch sắp tới theo ngày và dịch vụ</p>

        <div class="pc-filter">
            <form method="get" asp-controller="CusAppointment" asp-action="MyAppointments" class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <div class="pc-label">Từ khóa</div>
                    <input class="form-control pc-input"
                           name="q"
                           value="@Model.Filter.Q"
                           placeholder="Tên thú cưng / bác sĩ / ghi chú..." />
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Từ ngày</div>
                    <input type="date" class="form-control pc-input" name="fromDate" value="@fromVal" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="pc-label">Đến ngày</div>
                    <input type="date" class="form-control pc-input" name="toDate" value="@toVal" />
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="pc-label">Dịch vụ</div>
                    <select class="form-select pc-select" name="serviceId">
                        @foreach (var opt in Model.ServiceOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Selected ? "selected" : null)">
                                @opt.Text
                            </option>
                        }
                    </select>
                </div>

                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@Model.Filter.PageSize" />

                <div class="col-12 mt-2">
                    <div class="pc-actions">
                        <a class="pc-btn pc-btn--ghost"
                           href="@Url.Action("MyAppointments", "CusAppointment")#servicesArea">
                            <i class="fas fa-undo-alt"></i> Làm mới
                        </a>

                        <button type="submit" class="pc-btn pc-btn--primary">
                            <i class="fas fa-filter"></i> Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (!Model.Page.Data.Items.Any())
        {
            <div class="alert alert-info mb-0" style="border-radius:14px;">
                Chưa có lịch khám đã đặt phù hợp.
            </div>
        }
        else
        {
            <div class="pc-table table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:180px;">Ngày khám</th>
                            <th>Thú cưng</th>
                            <th>Bác sĩ</th>
                            <th>Dịch vụ</th>
                            <th style="width:140px;">Trạng thái</th>
                            <th style="width:140px;" class="text-end">Tổng tiền</th>
                            <th style="width:140px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    @foreach (var item in Model.Page.Data.Items)
                    {
                        // ✅ NEW: tính tổng theo base_price từ ServiceNames
                        decimal totalFromServices = 0m;
                        if (!string.IsNullOrWhiteSpace(item.ServiceNames))
                        {
                            var names = item.ServiceNames
                            .Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(x => x.Trim())
                            .ToList();

                            foreach (var n in names)
                            {
                                var svc = _allSvcs.FirstOrDefault(x =>
                                string.Equals(x.service_name?.Trim(), n, StringComparison.OrdinalIgnoreCase));

                                if (svc != null)
                                {
                                    totalFromServices += (decimal)svc.base_price;
                                }
                            }
                        }

                        <tbody class="pc-record">
                            <tr>
                                <td>
                                    <strong>@item.AppointmentDate.ToString("HH:mm dd/MM/yyyy")</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="pc-note-inline">
                                            <strong>Ghi chú:</strong> @item.Notes
                                        </div>
                                    }
                                </td>

                                <td><strong>@item.PetName</strong></td>
                                <td>@item.DoctorName</td>
                                <td>@item.ServiceNames</td>

                                <td>
                                    <span class="pc-badge">
                                        <i class="fas fa-calendar-check"></i>
                                        @item.Status
                                    </span>
                                </td>

                                <td class="text-end pc-money">
                                    @totalFromServices.ToString("N0")
                                </td>

                                <td class="text-end">
                                    <div class="pc-action-icons">
                                        <a class="pc-ico"
                                           title="Chi tiết"
                                           href="javascript:void(0)"
                                           onclick="openDetail(@item.AppointmentId)">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a class="pc-ico edit-check"
                                           title="Chỉnh sửa"
                                           data-created="@item.CreatedAt.ToString("o")"
                                           href="@Url.Action("Edit", "CusAppointment", new { id = item.AppointmentId })">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <a class="pc-ico"
                                           title="Hủy lịch"
                                           href="javascript:void(0)"
                                           onclick="openCancel(@item.AppointmentId)">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>

            <div class="mt-3">
                @await Html.PartialAsync("_Pager",
                (action: "MyAppointments",
                controller: "CusAppointment",
                q: Model.Filter.Q,
                pager: pagerObj))
        </div>

        <div class="text-center mt-2" style="color: var(--pc-muted); font-size:0.95rem;">
            Tổng: <strong>@Model.Page.Data.TotalItems</strong> lịch khám
        </div>
                }
    </div>
</section>

<div class="modal fade pc-modal" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="pc-modal-title">Chi tiết lịch hẹn</div>
                    <div class="pc-modal-sub">Thông tin đầy đủ về lịch hẹn bạn đã chọn</div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="forceCloseModal('detailModal')"></button>
            </div>

            <div class="modal-body">
                <iframe id="detailFrame" src="about:blank"></iframe>
            </div>
        </div>
    </div>
</div>

<div class="modal fade pc-modal" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="pc-modal-title">Hủy lịch hẹn</div>
                    <div class="pc-modal-sub">Vui lòng nêu rõ lý do để phòng khám hỗ trợ tốt hơn</div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="forceCloseModal('cancelModal')"></button>
            </div>

            <div class="modal-body">
                <iframe id="cancelFrame" src="about:blank"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDetail(id) {
            const url = '@Url.Action("Details", "CusAppointment")' + '?id=' + id + '&popup=1';
            document.getElementById('detailFrame').src = url;

            const modalEl = document.getElementById('detailModal');
            if (window.bootstrap && bootstrap.Modal) {
                const modal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });
                modal.show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
                modalEl.removeAttribute('aria-hidden');
                document.body.classList.add('modal-open');
            }
        }

        function openCancel(id) {
            const url = '@Url.Action("Cancel", "CusAppointment")' + '?id=' + id + '&popup=1';
            document.getElementById('cancelFrame').src = url;

            const modalEl = document.getElementById('cancelModal');
            if (window.bootstrap && bootstrap.Modal) {
                const modal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });
                modal.show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
                modalEl.removeAttribute('aria-hidden');
                document.body.classList.add('modal-open');
            }
        }

        function forceCloseModal(id) {
            const modalEl = document.getElementById(id);
            if (!modalEl) return;

            if (window.bootstrap && bootstrap.Modal) {
                const inst = bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide();
                else new bootstrap.Modal(modalEl).hide();
            } else {
                modalEl.classList.remove('show');
                modalEl.style.display = 'none';
                modalEl.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('modal-open');
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
            }
        }

        document.addEventListener("DOMContentLoaded", function () {

             document.querySelectorAll(".edit-check").forEach(function (btn) {

                 btn.addEventListener("click", function (e) {

                     const created = new Date(this.getAttribute("data-created"));
                     const now = new Date();

                     const diffHours = (now - created) / (1000 * 60 * 60);

                     if (diffHours > 24) {
                         e.preventDefault();
                         alert("Không thể chỉnh sửa lịch hẹn sau 24h.");
                         return false;
                     }
                 });

             });

         });
    </script>
}