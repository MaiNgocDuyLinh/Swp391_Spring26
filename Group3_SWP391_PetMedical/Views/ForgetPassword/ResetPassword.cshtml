@model Group3_SWP391_PetMedical.ViewModels.ForgetPassword.SendResetOtpVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); margin-top:150px; margin-bottom: 50px; max-width: 600px; margin-left: auto; margin-right: auto;}
        .pc-title { font-weight:800; margin:0; } .pc-sub { color:var(--pc-muted); margin:0; }
        .pc-filter { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:24px; margin:18px 0; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-label { font-weight:700; font-size:0.95rem; margin-bottom:8px; color: var(--pc-text); display: block;}
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); height:46px; padding:0 16px; width: 100%; transition: border-color 0.2s; }
        .pc-input:focus { border-color: var(--pc-red); outline: none; box-shadow: 0 0 0 3px rgba(255,59,59,0.15); }
        .pc-btn { border-radius:999px; padding:0 24px; height:46px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; text-decoration:none; width: 100%; transition: all 0.2s;}
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); }
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; transform: translateY(-1px); }
        .pc-btn--ghost { background:#fff; border:1px solid rgba(0,0,0,0.10); color:var(--pc-text) !important; }
        .pc-btn--ghost:hover { background:#f9f9f9; }
        .pc-note { font-size: 0.9rem; color: var(--pc-muted); margin-top: 15px; text-align: center; }
    </style>
}

<section class="container py-4">
    <div class="pc-wrap">
        <div class="text-center mb-4">
            <h3 class="pc-title">Quên mật khẩu?</h3>
            <p class="pc-sub mt-2">Đừng lo, chúng tôi sẽ giúp bạn lấy lại quyền truy cập tài khoản. Vui lòng nhập đúng hệ thống tài khoản và email đã đăng ký để nhận mã OTP.</p>
        </div>

        <div class="pc-filter">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert" style="border-radius:14px;">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert" style="border-radius:14px;">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="ForgetPassword" asp-action="SendResetCode" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:10px;"></div>
                
                <div class="mb-3">
                    <label for="Username" class="pc-label">Tài khoản</label>
                    <input asp-for="Username" class="pc-input" placeholder="Tên đăng nhập" />
                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="mb-4">
                    <label for="Email" class="pc-label">Email đăng ký</label>
                    <input asp-for="Email" class="pc-input" placeholder="Nhập email của bạn" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="pc-btn pc-btn--primary">
                        <i class="fas fa-paper-plane"></i> Gửi mã OTP
                    </button>
                    <a href="@Url.Action("Login","Login")" class="pc-btn pc-btn--ghost">
                        <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
                    </a>
                </div>
            </form>
            
            <p class="pc-note">
                Đã nhận được mã OTP? <br/>
                <a href="@Url.Action("ConfirmReset","ForgetPassword")" style="color:var(--pc-red);font-weight:700;text-decoration:none;">Nhập mã OTP & đặt lại mật khẩu</a>.
            </p>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
