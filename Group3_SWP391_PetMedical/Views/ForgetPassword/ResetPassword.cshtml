@model Group3_SWP391_PetMedical.ViewModels.ForgetPassword.SendResetOtpVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    .fp-page {
        padding-top: 140px;
        padding-bottom: 80px;
        background: #f7f8ff;
    }

    .fp-hero {
        max-width: 960px;
        margin: 0 auto;
        position: relative;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 22px 60px rgba(0, 0, 0, .18);
    }

    .fp-hero-bg {
        position: absolute;
        inset: 0;
        background-image: url('@Url.Content("~/uploads/forget/catdogforget.jpg")');
        background-size: cover;
        background-position: center;
        filter: brightness(0.75);
        z-index: 0;
    }

    .fp-hero-overlay {
        position: relative;
        z-index: 1;
        padding: 34px 34px 28px;
        background: linear-gradient(135deg, rgba(11, 28, 57, .92), rgba(255, 61, 28, .18));
        color: #fff;
        display: flex;
        flex-wrap: wrap;
        gap: 26px;
        align-items: center;
    }

    .fp-text {
        flex: 1 1 280px;
        min-width: 0;
    }

    .fp-title {
        font-size: 38px;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .fp-subtitle {
        font-size: 15px;
        color: #e1e6ff;
        max-width: 420px;
        margin-bottom: 18px;
    }

    .fp-form-box {
        flex: 0 0 320px;
        background: rgba(255, 255, 255, .96);
        border-radius: 22px;
        padding: 22px 22px 18px;
        color: #0b1c39;
    }

    .fp-form-title {
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .fp-form-sub {
        font-size: 13px;
        color: #5d6b82;
        margin-bottom: 14px;
    }

    .fp-field {
        margin-bottom: 12px;
    }

        .fp-field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 4px;
            color: #0b1c39;
        }

        .fp-field input {
            width: 100%;
            border-radius: 999px;
            border: 1px solid #eef0f4;
            padding: 9px 14px;
            font-size: 14px;
            outline: none;
        }

            .fp-field input:focus {
                border-color: rgba(255, 61, 28, .45);
                box-shadow: 0 0 0 0.16rem rgba(255, 61, 28, .18);
            }

    .fp-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
        align-items: center;
    }

    .fp-btn {
        border-radius: 999px;
        border: none;
        padding: 9px 18px;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: .18s ease;
        white-space: nowrap;
    }

    .fp-btn-primary {
        background: #ff3d1c;
        color: #fff;
    }

        .fp-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
        }

    .fp-btn-ghost {
        background: transparent;
        border: 1px solid #d0d5ff;
        color: #eef0ff;
    }

        .fp-btn-ghost:hover {
            background: rgba(255, 255, 255, .1);
        }

    .fp-note {
        font-size: 12px;
        color: #dfe4ff;
        max-width: 380px;
        margin-top: 6px;
    }

    @@media (max-width: 991.98px) {
        .fp-hero-overlay {
            padding: 28px 20px 22px;
        }

        .fp-title {
            font-size: 30px;
        }

        .fp-form-box {
            flex: 1 1 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .fp-page {
            padding-top: 120px;
            padding-bottom: 60px;
        }
    }
</style>

<main class="fp-page">
    <div class="container">
        <div class="fp-hero">
            <div class="fp-hero-bg"></div>
            <div class="fp-hero-overlay">
                <div class="fp-text">
                    <div class="fp-title">Quên mật khẩu?</div>
                    <div class="fp-subtitle">
                        Đừng lo, chúng tôi sẽ giúp bạn lấy lại quyền truy cập tài khoản.
                        Vui lòng nhập đúng tài khoản và email đã đăng ký để nhận mã OTP.
                    </div>
                    <p class="fp-note">
                        Mã OTP sẽ được gửi tới hộp thư email của bạn (bao gồm cả mục Spam/Quảng cáo).
                        Không chia sẻ mã này cho bất kì ai.
                    </p>
                </div>
                <div class="fp-form-box">
                    <div class="fp-form-title">Gửi mã OTP đặt lại mật khẩu</div>
                    <div class="fp-form-sub">Điền thông tin bên dưới để nhận mã xác nhận.</div>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert" style="border-radius:14px;">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert" style="border-radius:14px;">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                    <form asp-controller="ForgetPassword" asp-action="SendResetCode" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:10px;"></div>
                        <div class="fp-field">
                            <label for="Username">Tài khoản</label>
                            <input asp-for="Username" class="form-control" style="border-radius:999px;" placeholder="Tên đăng nhập" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="fp-field">
                            <label for="Email">Email</label>
                            <input asp-for="Email" class="form-control" style="border-radius:999px;" placeholder="Email đã đăng ký" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="fp-actions">
                            <button type="submit" class="fp-btn fp-btn-primary">
                                Gửi mã OTP
                            </button>
                            <a href="@Url.Action("Login","Login")" class="fp-btn fp-btn-ghost">
                                Quay lại đăng nhập
                            </a>
                        </div>
                    </form>
                    <p class="fp-note" style="margin-top:10px;">
                        Đã nhận được mã OTP? <a href="@Url.Action("ConfirmReset","ForgetPassword")" style="color:#fff;font-weight:700;text-decoration:underline;">Nhập mã OTP & đặt lại mật khẩu</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

