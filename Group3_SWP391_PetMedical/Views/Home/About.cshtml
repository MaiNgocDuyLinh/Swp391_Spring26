@{
    ViewData["Title"] = "Về chúng tôi - Pet Medical";
}

<!-- Hero Area Start -->
<div class="slider-area2 slider-height2 d-flex align-items-center" style="background-image: url('@Url.Content("~/assets/img/hero/hero2.png")'); background-size: cover;">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="hero-cap text-center pt-50">
                    <h2 style="font-weight: 800; color: #fff;">Về chúng tôi</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero Area End -->

<!-- About Details Start -->
<div class="about-details section-padding30">
    <div class="container">
        <div class="row">
            <div class="offset-xl-1 col-lg-8">
                <div class="about-details-cap mb-50">
                    <h4 style="font-weight: 800; color: #ff3b3b; margin-bottom: 15px;">Sứ mệnh của Pet Medical</h4>
                    <p style="font-size: 1.1rem; line-height: 1.8;">
                        Tại Pet Medical, sứ mệnh của chúng tôi là mang lại cuộc sống khỏe mạnh và hạnh phúc nhất cho thú cưng của bạn. Chúng tôi cam kết cung cấp các dịch vụ chăm sóc y tế chuyên nghiệp, tận tâm, kết hợp giữa tình yêu thương động vật và công nghệ y khoa hiện đại nhất.
                    </p>
                    <p style="font-size: 1.1rem;">Mỗi thú cưng đến với chúng tôi đều được đối xử như một thành viên trong gia đình, với sự thấu hiểu và tôn trọng tuyệt đối.</p>
                </div>

                <div class="about-details-cap mb-50">
                    <h4 style="font-weight: 800; color: #ff3b3b; margin-bottom: 15px;">Tầm nhìn chiến lược</h4>
                    <p style="font-size: 1.1rem; line-height: 1.8;">
                        Chúng tôi hướng tới việc trở thành hệ thống bệnh viện thú y tiêu chuẩn quốc tế hàng đầu tại Việt Nam. Không chỉ dừng lại ở việc chữa bệnh, Pet Medical còn mong muốn xây dựng một cộng đồng những người yêu thú cưng văn minh, nơi kiến thức về chăm sóc động vật được chia sẻ rộng rãi.
                    </p>
                    <p style="font-size: 1.1rem;">Không ngừng cải tiến, không ngừng học hỏi để xứng đáng với sự tin tưởng của khách hàng.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About Details End -->

<!--? About Area Start-->
<div class="about-area fix">
    <!--Right Contents  -->
    <div class="about-img">
        <div class="info-man text-center">
            <div class="head-cap">
                <i class="fas fa-heart" style="font-size: 2rem; color: #fff;"></i>
                <h3 style="color: #fff; margin-top: 10px;">99%</h3>
            </div>
            <p style="color: #fff;">Khách hàng<br>Hài lòng</p>
        </div>
        <div class="info-man info-man2 text-center">
            <div class="head-cap">
                <i class="fas fa-paw" style="font-size: 2rem; color: #fff;"></i>
                <h3 style="color: #fff; margin-top: 10px;">10,000+</h3>
            </div>
            <p style="color: #fff;">Thú cưng<br>Đã chăm sóc</p>
        </div>
    </div>
    <!-- left Contents -->
    <div class="about-details">
        <div class="right-caption">
            <!-- Section Tittle -->
            <div class="section-tittle mb-50">
                <h2 style="font-weight: 800;">Chúng tôi cam kết<br> Dịch vụ tốt nhất</h2>
            </div>
            <div class="about-more">
                <p class="pera-top" style="font-size: 1.1rem;">Với đội ngũ bác sĩ giàu kinh nghiệm và trang thiết bị hiện đại, chúng tôi tự tin giải quyết mọi vấn đề sức khỏe cho thú cưng của bạn từ cơ bản đến chuyên sâu.</p>
                <p class="mb-65 pera-bottom" style="font-size: 1,1rem;">Sự an tâm của bạn và sự khỏe mạnh của các bé là ưu tiên hàng đầu của Pet Medical. Chúng tôi luôn sẵn sàng lắng nghe và đồng hành cùng bạn trên hành trình chăm sóc "bạn nhỏ".</p>
            </div>
        </div>
    </div>
</div>
<!-- About Area End-->

<!--? Team Start -->
<div class="team-area section-padding30">
    <div class="container">
        <div class="row justify-content-sm-center">
            <div class="cl-xl-7 col-lg-8 col-md-10">
                <!-- Section Tittle -->
                <div class="section-tittle text-center mb-70">
                    <span style="color: #ff3b3b; font-weight: 700;">Đội ngũ chuyên gia</span>
                    <h2 style="font-weight: 800;">Bác sĩ Thú y của chúng tôi</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- single Tem -->
            <div class="col-xl-4 col-lg-4 col-md-6">
                <div class="single-team mb-30">
                    <div class="team-img">
                        <img src="@Url.Content("~/assets/img/gallery/team1.png")" alt="">
                    </div>
                    <div class="team-caption">
                        <span>Bác sĩ Trưởng</span>
                        <h3><a href="#">Bác sĩ Minh Quân</a></h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-6">
                <div class="single-team mb-30">
                    <div class="team-img">
                        <img src="@Url.Content("~/assets/img/gallery/team2.png")" alt="">
                    </div>
                    <div class="team-caption">
                        <span>Chuyên gia Phẫu thuật</span>
                        <h3><a href="#">Bác sĩ Hồng Hạnh</a></h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-6">
                <div class="single-team mb-30">
                    <div class="team-img">
                        <img src="@Url.Content("~/assets/img/gallery/team3.png")" alt="">
                    </div>
                    <div class="team-caption">
                        <span>Chuyên gia Nội khoa</span>
                        <h3><a href="#">Bác sĩ Tuấn Anh</a></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Team End -->

<!--? Contact form Start -->
<div class="contact-form-main pb-top">
    <div class="container">
        <div class="row justify-content-md-end">
            <div class="col-xl-7 col-lg-7">
                <div class="form-wrapper">
                    <!--Section Tittle  -->
                    <div class="form-tittle">
                        <div class="row ">
                            <div class="col-xl-12">
                                <div class="section-tittle section-tittle2 mb-70">
                                    <h2 style="font-weight: 800;">Gửi lời nhắn cho chúng tôi</h2>
                                    <p>Chúng tôi luôn sẵn sàng hỗ trợ bạn và thú cưng 24/7.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--End Section Tittle  -->
                    <form id="contact-form" action="#" method="POST">
                        <div class="row">
                            <div class="col-lg-6 col-md-6">
                                <div class="form-box user-icon mb-30">
                                    <input type="text" name="name" placeholder="Họ và tên của bạn">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-box email-icon mb-30">
                                    <input type="text" name="phone" placeholder="Số điện thoại">
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-box subject-icon mb-30">
                                    <input type="Email" name="subject" placeholder="Địa chỉ Email">
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-box message-icon mb-65">
                                    <textarea name="message" id="message" placeholder="Nội dung cần tư vấn..."></textarea>
                                </div>
                                <div class="submit-info">
                                    <button class="btn submit-btn2" style="background: #ff3b3b; color: #fff; border-radius: 999px; font-weight: 700;" type="submit">Gửi tin nhắn</button>
                                </div>
                            </div>
                        </div>
                        <!-- shape-dog -->
                        <div class="shape-dog">
                            <img src="@Url.Content("~/assets/img/gallery/shape1.png")" alt="">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- contact left Img-->
    <div class="from-left d-none d-lg-block">
        <img src="@Url.Content("~/assets/img/gallery/contact_form.png")" alt="">
    </div>
</div>
<!-- Contact form End -->

<!--? contact-animal-owner Start -->
<div class="contact-animal-owner section-bg" data-background="@Url.Content("~/assets/img/gallery/section_bg04.png")">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="contact_text text-center">
                    <div class="section_title text-center">
                        <h3 style="color: #fff; font-weight: 800;">Bất cứ khi nào bạn cần, hãy gọi!</h3>
                        <p style="color: #fff;">Chúng tôi thấu hiểu rằng những vấn đề của thú cưng không thể chờ đợi. Hỗ trợ 24/7.</p>
                    </div>
                    <div class="contact_btn d-flex align-items-center justify-content-center">
                        <a href="@Url.Action("Contact", "Login")" class="btn white-btn" style="border-radius: 999px;">Liên hệ ngay</a>
                        <p style="color: #fff; margin-bottom: 0;">Hoặc gọi: <a href="tel:0123456789" style="color: #fff; font-weight: 800;"> 0123.456.789</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- contact-animal-owner End -->

