@{
    ViewData["Title"] = "Liên hệ - Pet Medical";
}

@section Styles {
    <style>
        :root { --pc-red:#ff3b3b; --pc-red-dark:#e83434; --pc-text:#2b2b2b; --pc-muted:#7a7a7a; --pc-border:rgba(0,0,0,0.06); }
        .pc-wrap { background:#f3d7d5; border:1px solid var(--pc-border); border-radius:18px; padding:40px; box-shadow:0 12px 30px rgba(0,0,0,0.06); margin-top:150px; margin-bottom: 50px;}
        .pc-title { font-weight:800; margin:0; font-size: 2.5rem; text-align: center;} 
        .pc-sub { color:var(--pc-muted); margin:10px 0 30px; text-align: center; font-size: 1.1rem;}
        .contact-info-box { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:30px; height: 100%; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .info-item { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 25px; }
        .info-icon { width: 50px; height: 50px; border-radius: 12px; background: #fff1f0; color: var(--pc-red); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
        .info-content h5 { font-weight: 800; margin-bottom: 5px; color: var(--pc-text); }
        .info-content p { margin: 0; color: var(--pc-muted); font-size: 1rem; line-height: 1.5; }
        .pc-form-card { background:#fff; border:1px solid var(--pc-border); border-radius:16px; padding:30px; box-shadow:0 10px 25px rgba(0,0,0,0.04); }
        .pc-label { font-weight:700; font-size:0.95rem; margin-bottom:8px; color: var(--pc-text); display: block;}
        .pc-input { border-radius:12px; border:1px solid rgba(0,0,0,0.10); padding:12px 16px; width: 100%; transition: border-color 0.2s; background: #fcfcfc;}
        .pc-input:focus { border-color: var(--pc-red); outline: none; box-shadow: 0 0 0 3px rgba(255,59,59,0.15); background: #fff;}
        .pc-btn { border-radius:999px; padding:0 30px; height:50px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:10px; border:none; text-decoration:none; transition: all 0.2s; cursor: pointer;}
        .pc-btn--primary { background:var(--pc-red); color:#fff; box-shadow:0 10px 20px rgba(255,59,59,0.25); width: 100%;}
        .pc-btn--primary:hover { background:var(--pc-red-dark); color:#fff; transform: translateY(-2px); box-shadow:0 12px 25px rgba(255,59,59,0.3); }
    </style>
}

<section class="container">
    <div class="pc-wrap">
        <h2 class="pc-title">Liên hệ với chúng tôi</h2>
        <p class="pc-sub">Pet Medical luôn lắng nghe và sẵn sàng giải đáp mọi thắc mắc của bạn về sức khỏe thú cưng.</p>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="contact-info-box">
                    <h4 style="font-weight: 800; margin-bottom: 30px;">Thông tin liên hệ</h4>
                    
                    <div class="info-item">
                        <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
                        <div class="info-content">
                            <h5>Địa chỉ</h5>
                            <p>Số 1A, Đường Pet Medical, Quận 1, <br/>Thành phố Hồ Chí Minh</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon"><i class="fas fa-phone-alt"></i></div>
                        <div class="info-content">
                            <h5>Số điện thoại</h5>
                            <p>0123.456.789 <br/> (Hỗ trợ 24/7)</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon"><i class="fas fa-envelope"></i></div>
                        <div class="info-content">
                            <h5>Email</h5>
                            <p>support@petmedical.vn <br/> info@petmedical.vn</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon"><i class="fas fa-clock"></i></div>
                        <div class="info-content">
                            <h5>Giờ làm việc</h5>
                            <p>Thứ 2 - Chủ Nhật: 08:00 - 20:00 <br/> (Cấp cứu: 24/24)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="pc-form-card">
                    <h4 style="font-weight: 800; margin-bottom: 30px;">Gửi tin nhắn cho bác sĩ</h4>
                    <form action="#" method="POST">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="pc-label">Họ và tên</label>
                                <input type="text" class="pc-input" placeholder="Nhập tên của bạn">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="pc-label">Số điện thoại</label>
                                <input type="text" class="pc-input" placeholder="Nhập số điện thoại">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="pc-label">Chủ đề</label>
                            <input type="text" class="pc-input" placeholder="Bạn cần tư vấn vấn đề gì?">
                        </div>
                        <div class="mb-4">
                            <label class="pc-label">Nội dung tin nhắn</label>
                            <textarea class="pc-input" rows="4" placeholder="Mô tả tình trạng thú cưng hoặc câu hỏi của bạn..."></textarea>
                        </div>
                        <button type="submit" class="pc-btn pc-btn--primary">
                            <i class="fas fa-paper-plane"></i> Gửi ngay bây giờ
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
