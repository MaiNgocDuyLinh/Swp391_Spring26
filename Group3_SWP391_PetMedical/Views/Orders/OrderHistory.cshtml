@model List<Group3_SWP391_PetMedical.ViewModels.Order.OrderHistoryVm>
@{
    ViewData["Title"] = "Lịch sử mua thuốc";
}

<section class="container" style="margin-top:140px; margin-bottom: 50px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="fas fa-history me-2"></i>Lịch sử đơn hàng</h3>
        <a href="@Url.Action("RetailViewList", "Retail")" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Tiếp tục mua thuốc
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded bg-white border">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <p class="text-muted">Linh chưa có đơn hàng nào cả. Thử mua thuốc cho thú cưng xem sao!</p>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Khung giờ lấy</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">#@order.OrderId</td>
                            <td>@order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <small class="text-truncate d-inline-block" style="max-width: 200px;">
                                    @string.Join(", ", order.MedicineNames)
                                </small>
                            </td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                            <td><span class="badge bg-info text-dark">@order.PickupSlot</span></td>
                            <td>
                                @if (order.Status == "PAID")
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Chờ thanh toán</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>